<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <title>Hungrymate - Real-Time Delicious Food Delivery</title>
    <!-- Tab Favicon Circular Logo -->
    <link rel="icon" type="image/png" href="/myimg.png">
    
    <!-- Bootstrap 5.3 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/rating.css">

    <style>
        :root {
            --hm-white: #ffffff;
            --hm-cream: #faf7f2;
            --hm-navy: #0f172a;
            --hm-yellow: #f59e0b;
            --hm-pink: #ec4899;
            --hm-accent-red: #fe424d;
            --hm-capsule-dark: #D0C09E;
        }

        #searchHistoryBox {
            background-color: #ffffff !important;
            color: #0f172a !important;
        }
        #searchHistoryBox li {
            color: #0f172a !important;
            padding: 0.5rem 1rem;
            cursor: pointer;
        }
        #searchHistoryBox li:hover {
            background-color: #f1f5f9 !important;
            color: var(--hm-pink) !important;
        }
        body.dark-mode #searchHistoryBox {
            background-color: #18181b !important;
            color: #ffffff !important;
            border-color: #27272a !important;
        }
        body.dark-mode #searchHistoryBox li { color: #f8fafc !important; }
        body.dark-mode #searchHistoryBox li:hover {
            background-color: #27272a !important;
            color: #D0C09E !important;
        }
    </style>
</head>

<body>
    <script>
        if (localStorage.getItem("hungrymate_dark_theme") === "active") {
            document.body.classList.add("dark-mode");
        }
    </script>

    <%- include("../includes/navbar.ejs") %>

    <div class="main-body-container">
        <%- include("../includes/flash.ejs") %>
        <%- body %>
    </div>

    <%- include("../includes/footer.ejs") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>
</body>
</html>