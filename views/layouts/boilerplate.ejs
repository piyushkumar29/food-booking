<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hungrymate</title>
    <!-- Official Working Bootstrap 5.3 (Without Blocked Integrity) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/rating.css">

    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            overflow-x: hidden;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: background-color 0.25s ease, color 0.25s ease;
        }
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .main-body-container {
            flex: 1 0 auto;
            width: 100%;
        }

        /* Persistent Dark Mode */
        body.dark-mode {
            background-color: #121212 !important;
            color: #f1f1f1 !important;
        }
        body.dark-mode nav,
        body.dark-mode .navbar {
            background-color: #1a1a1a !important;
            border-bottom: 1px solid #282828 !important;
        }
        body.dark-mode .nav-link,
        body.dark-mode .navbar-brand {
            color: #ffffff !important;
        }
        body.dark-mode .card {
            background-color: #1e1e1e !important;
            border: 1px solid #2d2d2d !important;
            color: #ffffff !important;
        }
        body.dark-mode footer,
        body.dark-mode .f-info {
            background-color: #161616 !important;
            border-top: 1px solid #262626 !important;
            color: #e0e0e0 !important;
        }
        body.dark-mode .f-info-socials-link i {
            color: #ffc107 !important;
        }
        body.dark-mode .f-info a {
            color: #ffc107 !important;
        }
    </style>
</head>

<body>
    <script>
        if (localStorage.getItem("hungrymate_dark_theme") === "active") {
            document.body.classList.add("dark-mode");
        }
    </script>

    <%- include("../includes/navbar.ejs") %>

    <div class="main-body-container container-fluid px-4">
        <%- include("../includes/flash.ejs") %>
        <%- body %>
    </div>

    <%- include("../includes/footer.ejs") %>

    <!-- Working Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>
</body>
</html>