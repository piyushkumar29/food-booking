<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hungrymate - Real-Time Delicious Food Delivery</title>
    <!-- Tab Favicon Logo -->
    <link rel="icon" type="image/png" href="/mypic.png">
    
    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/rating.css">

    <style>
        :root {
            --hm-white: #ffffff;
            --hm-cream: #faf7f2;
            --hm-navy: #0f172a;
            --hm-yellow: #f59e0b;
            --hm-pink: #ec4899;
            --hm-accent-red: #fe424d;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            overflow-x: hidden;
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--hm-cream);
            color: var(--hm-navy);
            transition: background-color 0.25s ease, color 0.25s ease;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-body-container {
            flex: 1 0 auto;
            width: 100%;
        }

        /* Dark Mode Parity */
        body.dark-mode {
            background-color: #0b0f19 !important;
            color: #f8fafc !important;
        }
        body.dark-mode nav, body.dark-mode .navbar {
            background-color: #0f172a !important;
            border-bottom: 1px solid #1e293b !important;
        }
        body.dark-mode .nav-link, body.dark-mode .navbar-brand {
            color: #ffffff !important;
        }
        body.dark-mode .card {
            background-color: #1e293b !important;
            border: 1px solid #334155 !important;
            color: #ffffff !important;
        }
        body.dark-mode footer, body.dark-mode .f-info {
            background-color: #090d16 !important;
            border-top: 1px solid #1e293b !important;
            color: #cbd5e1 !important;
        }
        body.dark-mode .f-info-socials-link i {
            color: var(--hm-yellow) !important;
        }
        body.dark-mode .f-info a {
            color: var(--hm-pink) !important;
        }

        /* Search History Dropdown Text Contrast Fix */
        #searchHistoryBox {
            background-color: #ffffff !important;
            color: #0f172a !important;
        }
        #searchHistoryBox li {
            color: #0f172a !important;
            padding: 0.5rem 1rem;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }
        #searchHistoryBox li:hover {
            background-color: #f1f5f9 !important;
            color: var(--hm-pink) !important;
        }
        body.dark-mode #searchHistoryBox {
            background-color: #1e293b !important;
            color: #f8fafc !important;
            border-color: #334155 !important;
        }
        body.dark-mode #searchHistoryBox li {
            color: #e2e8f0 !important;
        }
        body.dark-mode #searchHistoryBox li:hover {
            background-color: #334155 !important;
            color: var(--hm-yellow) !important;
        }
    </style>
</head>

<body>
    <script>
        if (localStorage.getItem("hungrymate_dark_theme") === "active") {
            document.body.classList.add("dark-mode");
        }
    </script>

    <%- include("../includes/navbar.ejs") %>

    <div class="main-body-container container-fluid px-2 px-md-4">
        <%- include("../includes/flash.ejs") %>
        <%- body %>
    </div>

    <%- include("../includes/footer.ejs") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>
</body>
</html>