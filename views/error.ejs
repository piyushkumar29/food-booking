<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Hungrymate - Error</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #faf7f2;
            font-family: Arial, sans-serif;
        }

        .error-card {
            width: min(90%, 650px);
            background: #ffffff;
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.12);
        }

        .error-code {
            font-size: 72px;
            font-weight: 800;
            color: #fe424d;
            line-height: 1;
        }

        .error-title {
            margin-top: 20px;
            font-size: 28px;
            font-weight: 700;
            color: #0f172a;
        }

        .error-message {
            margin-top: 15px;
            color: #64748b;
            font-size: 16px;
        }

        .home-btn {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 25px;
            border-radius: 999px;
            background: #fe424d;
            color: white;
            text-decoration: none;
            font-weight: 700;
        }

        .home-btn:hover {
            color: white;
            opacity: 0.9;
        }
    </style>
</head>

<body>

    <div class="error-card">

        <div class="error-code">
            <%= typeof statusCode !== "undefined" ? statusCode : 500 %>
        </div>

        <div class="error-title">
            Something went wrong
        </div>

        <div class="error-message">
            <%= typeof message !== "undefined"
                ? message
                : "An unexpected error occurred." %>
        </div>

        <a
            href="/listings"
            class="home-btn"
        >
            Back to Hungrymate
        </a>

    </div>

</body>
</html>
