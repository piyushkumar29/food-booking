<% layout("/layouts/boilerplate") %>

<style>
    .auth-stage-universe {
        min-height: calc(88vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem 1rem;
        position: relative;
        overflow: hidden;
        width: 100%;
    }
    .scatter-asset {
        position: absolute;
        user-select: none;
        pointer-events: none;
        filter: drop-shadow(0 14px 26px rgba(0,0,0,0.4));
        transition: transform 0.3s ease;
    }
    .asset-cookie { width: 145px; top: 6%; left: 4%; animation: spinAndFloat 15s linear infinite; }
    .asset-balloon { width: 135px; top: 38%; left: 7%; animation: balloonBob 4.2s ease-in-out infinite; }
    .asset-firecracker { width: 140px; bottom: 5%; left: 3%; animation: blastWiggle 3.5s ease-in-out infinite alternate; }
    .asset-star-left { width: 90px; top: 25%; left: 18%; animation: twinkleStar 2.2s ease-in-out infinite alternate; }

    .asset-icecream-stick { width: 145px; top: 7%; right: 4%; animation: floatTilt 4.2s ease-in-out infinite alternate; }
    .asset-cake { width: 155px; top: 40%; right: 6%; animation: cakeHover 4.5s ease-in-out infinite; }
    .asset-sparkle-right { width: 120px; bottom: 6%; right: 4%; animation: sparkleBurst 3s ease-in-out infinite; }
    .asset-star-right { width: 90px; top: 23%; right: 18%; animation: twinkleStar 2s ease-in-out infinite alternate-reverse; }

    @keyframes spinAndFloat { 0% { transform: rotate(0deg) translateY(0px); } 50% { transform: rotate(180deg) translateY(-14px); } 100% { transform: rotate(360deg) translateY(0px); } }
    @keyframes balloonBob { 0%, 100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-22px) rotate(6deg); } }
    @keyframes blastWiggle { 0% { transform: translateY(0) rotate(-8deg) scale(0.98); } 100% { transform: translateY(-16px) rotate(10deg) scale(1.06); } }
    @keyframes floatTilt { 0% { transform: translateY(0px) rotate(5deg); } 100% { transform: translateY(-18px) rotate(-8deg); } }
    @keyframes cakeHover { 0%, 100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-16px) scale(1.04); } }
    @keyframes twinkleStar { 0% { opacity: 0.35; transform: scale(0.75) rotate(0deg); } 100% { opacity: 1; transform: scale(1.25) rotate(25deg); filter: drop-shadow(0 0 16px #ffc107); } }
    @keyframes sparkleBurst { 0%, 100% { transform: scale(0.9) rotate(-10deg); filter: drop-shadow(0 0 8px #ff4081); } 50% { transform: scale(1.15) rotate(15deg); filter: drop-shadow(0 0 20px #ffeb3b); } }

    @media (max-width: 1100px) { .asset-star-left, .asset-star-right { display: none; } .scatter-asset { transform: scale(0.85); } }
    @media (max-width: 900px) { .scatter-asset { display: none !important; } }

    .center-auth-box {
        width: 100%; max-width: 480px; background: #ffffff; border-radius: 26px; padding: 2.2rem 2.4rem;
        box-shadow: 0 20px 48px rgba(15,23,42,0.12); border: 1.5px solid #e2e8f0; position: relative; z-index: 10;
    }
    .auth-input-elem {
        background-color: #f8fafc !important; border: 1.5px solid #cbd5e1 !important; color: #0f172a !important;
        border-radius: 12px; padding: 0.68rem 1.05rem; font-size: 0.93rem;
    }
    .auth-input-elem:focus { background-color: #ffffff !important; border-color: #fe424d !important; box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.15) !important; }
    
    .social-auth-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.65rem; }
    .social-btn-link {
        display: flex; align-items: center; justify-content: center; padding: 0.6rem; border-radius: 12px;
        background: #f8fafc; border: 1.5px solid #cbd5e1; text-decoration: none; font-size: 1.3rem; transition: all 0.2s ease;
    }
    .social-btn-link:hover { transform: translateY(-2.5px); box-shadow: 0 6px 14px rgba(0,0,0,0.1); background: #ffffff; }
    .brand-google i { color: #ea4335 !important; }
    .brand-microsoft i { color: #00a4ef !important; }
    .brand-github i { color: #0f172a !important; }
    .brand-linkedin i { color: #0a66c2 !important; }

    body.dark-mode .center-auth-box { background: #0f172a !important; border-color: #1e293b !important; }
    body.dark-mode .auth-input-elem { background-color: #1e293b !important; border-color: #334155 !important; color: #f8fafc !important; }
    body.dark-mode .social-btn-link { background: #1e293b !important; border-color: #334155 !important; }
    body.dark-mode .brand-github i { color: #ffffff !important; }
</style>

<div class="auth-stage-universe">
    <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Food/Cookie.png" class="scatter-asset asset-cookie" alt="Cookie">
    <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Activities/Balloon.png" class="scatter-asset asset-balloon" alt="Balloon">
    <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Activities/Firecracker.png" class="scatter-asset asset-firecracker" alt="Firecracker">
    <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Travel%20and%20places/Glowing%20Star.png" class="scatter-asset asset-star-left" alt="Star">

    <div class="center-auth-box">
        <div class="text-center mb-4">
            <h3 class="fw-bold mb-1" style="color: #fe424d;">Create Account</h3>
            <p class="text-muted small">Join Hungrymate for live tracking & offers</p>
        </div>

        <form action="/signup" method="POST" class="needs-validation" id="signupForm" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label fw-semibold small">Username</label>
                <input name="username" id="username" type="text" class="form-control auth-input-elem" placeholder="Enter username" required />
            </div>

            <div class="mb-3">
                <label for="email" class="form-label fw-semibold small">Email Address</label>
                <input name="email" id="email" type="email" class="form-control auth-input-elem" placeholder="name@gmail.com" required />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label fw-semibold small">Password</label>
                <input name="password" id="password" type="password" class="form-control auth-input-elem" placeholder="Create password" required />
            </div>

            <div class="mb-4">
                <label for="confirmPassword" class="form-label fw-semibold small">Confirm Password</label>
                <input name="confirmPassword" id="confirmPassword" type="password" class="form-control auth-input-elem" placeholder="Confirm password" required />
            </div>

            <button class="btn btn-danger w-100 py-2 fw-bold rounded-3 mb-3" style="background: linear-gradient(135deg, #fe424d 0%, #ec4899 100%); border: none;">Sign up</button>

            <!-- Working Real OAuth Redirect Links -->
            <div class="text-center text-muted small mb-3">or continue with</div>
            <div class="social-auth-strip mb-4">
                <a href="/auth/google" class="social-btn-link brand-google" title="Google"><i class="fa-brands fa-google"></i></a>
                <a href="/auth/microsoft" class="social-btn-link brand-microsoft" title="Microsoft"><i class="fa-brands fa-microsoft"></i></a>
                <a href="/auth/github" class="social-btn-link brand-github" title="GitHub"><i class="fa-brands fa-github"></i></a>
                <a href="/auth/linkedin" class="social-btn-link brand-linkedin" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
            </div>

            <div class="text-center">
                <span class="text-muted small">Already registered? </span>
                <a href="/login" class="text-danger fw-bold text-decoration-none small">Log in</a>
            </div>
        </form>
    </div>

    <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Food/Ice%20Cream.png" class="scatter-asset asset-icecream-stick" alt="Ice Cream">
    <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Food/Birthday%20Cake.png" class="scatter-asset asset-cake" alt="Cake">
    <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Activities/Party%20Popper.png" class="scatter-asset asset-sparkle-right" alt="Sparkle">
    <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Travel%20and%20places/Star.png" class="scatter-asset asset-star-right" alt="Star">
</div>