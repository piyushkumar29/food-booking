<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-white mb-4">
            
            <div class="text-center mb-3">
                <img src="/myimg.png" alt="Hungrymate Logo" style="height: 60px; width: 60px; border-radius: 50%; object-fit: cover;" class="mb-2 shadow-sm">
                <h4 class="fw-bold text-dark mb-1">Create Account</h4>
                <p class="text-muted small">Join Hungrymate for live tracking & delicious food</p>
            </div>

            <form action="/signup" method="POST" class="needs-validation" novalidate>
                
                <div class="mb-3">
                    <label for="username" class="form-label small fw-semibold">Username</label>
                    <input name="username" id="username" type="text" class="form-control rounded-pill px-3" placeholder="Choose a unique username" required />
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label small fw-semibold">Email Address</label>
                    <input name="email" id="email" type="email" class="form-control rounded-pill px-3" placeholder="name@example.com" required />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label small fw-semibold">Password</label>
                    <input name="password" id="password" type="password" class="form-control rounded-pill px-3" placeholder="Enter secure password" required />
                </div>

                <!-- Point 7: Live Location Access at Signup -->
                <div class="mb-3 p-3 bg-light rounded-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label small fw-bold mb-0"><i class="fa-solid fa-location-crosshairs text-danger me-1"></i>Your Location</label>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2 fw-semibold" onclick="getSignupLocation()">
                            Allow GPS
                        </button>
                    </div>
                    <input name="address" id="signupAddress" type="text" class="form-control rounded-pill px-3" placeholder="Click 'Allow GPS' to set your address" />
                    <small id="signupLocHint" class="text-muted d-block mt-1" style="font-size: 0.72rem;">We use this to recommend nearby restaurants.</small>
                </div>

                <button class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow">
                    Create Account
                </button>
            </form>

            <div class="text-center mt-3">
                <small class="text-muted">Already have an account? <a href="/login" class="text-danger fw-bold text-decoration-none">Log in</a></small>
            </div>
        </div>
    </div>
</div>

<script>
function getSignupLocation() {
    const addrInput = document.getElementById("signupAddress");
    const hint = document.getElementById("signupLocHint");
    if (!navigator.geolocation) return alert("Geolocation not supported by your browser!");

    hint.innerText = "Requesting GPS coordinates...";

    navigator.geolocation.getCurrentPosition(
        async (position) => {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;
            hint.innerText = "Finding English street address...";
            try {
                // Point 9: English Street Language Forced
                const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lon}&accept-language=en`);
                const data = await res.json();
                if (data && data.display_name) {
                    addrInput.value = data.display_name;
                    hint.innerHTML = `<span class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i>Location saved!</span>`;
                    localStorage.setItem("hungrymate_user_location", data.display_name);
                } else {
                    addrInput.value = `Sector Lat: ${lat.toFixed(3)}, Lon: ${lon.toFixed(3)}`;
                }
            } catch (e) {
                addrInput.value = `Lat: ${lat.toFixed(3)}, Lon: ${lon.toFixed(3)}`;
            }
        },
        () => {
            alert("Please allow location access in your browser pop-up!");
            hint.innerText = "Permission denied. Please enter address manually.";
        },
        { enableHighAccuracy: true, timeout: 8000 }
    );
}
</script>