<% layout("/layouts/boilerplate") %>

<style>
    .svg-star-rating-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        cursor: pointer;
        padding: 0.5rem;
        user-select: none;
    }

    .svg-star-item {
        width: 44px;
        height: 44px;
        cursor: pointer;
        transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Prevent SVG internal path from stealing pointer events */
    .svg-star-item svg {
        width: 100%;
        height: 100%;
        pointer-events: none !important;
        fill: #cbd5e1;
        transition: fill 0.15s ease, filter 0.15s ease;
    }

    body.dark-mode .svg-star-item svg {
        fill: #475569 !important;
    }

    .svg-star-item.active svg,
    .svg-star-item.hover svg {
        fill: #facc15 !important;
        filter: drop-shadow(0 0 10px rgba(250, 204, 21, 0.8)) !important;
    }

    .svg-star-item.active,
    .svg-star-item.hover {
        transform: scale(1.2);
    }
</style>

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 p-3 p-md-4 bg-white">
            
            <div class="text-center mb-3">
                <span class="badge bg-danger rounded-pill px-3 py-1 mb-2">Verified Feedback</span>
                <h3 class="fw-bold mb-1">Rate <%= listing.title %></h3>
                <p class="text-muted small mb-0"><i class="fa-solid fa-store text-danger me-1"></i><%= listing.restaurant || 'Hungrymate Hub' %></p>
            </div>

            <div class="text-center mb-3">
                <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="rounded-3 shadow-sm object-fit-cover" style="height: 120px; width: 180px;">
            </div>

            <form method="POST" action="/listings/<%= listing._id %>/reviews" enctype="multipart/form-data" novalidate class="needs-validation">
                
                <!-- Zero-Dependency Pure Vector Star Hover Widget -->
                <div class="mb-4 text-center">
                    <label class="form-label fw-bold small text-dark d-block mb-1">Tap Stars to Rate:</label>
                    <div class="svg-star-rating-box" id="svgStarContainer">
                        <div class="svg-star-item" data-value="1">
                            <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                        </div>
                        <div class="svg-star-item" data-value="2">
                            <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                        </div>
                        <div class="svg-star-item" data-value="3">
                            <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                        </div>
                        <div class="svg-star-item" data-value="4">
                            <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                        </div>
                        <div class="svg-star-item" data-value="5">
                            <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                        </div>
                    </div>
                    <input type="hidden" name="review[rating]" id="selectedRatingInput" value="5" required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Your Name / Handle</label>
                    <input type="text" class="form-control rounded-pill px-3" value="<%= currUser ? currUser.username : 'Customer' %>" readonly style="background-color: #f8fafc;" />
                </div>

                <div class="mb-3">
                    <label for="comment" class="form-label fw-semibold small">Describe Your Experience</label>
                    <textarea name="review[comment]" id="comment" class="form-control rounded-4 p-3" rows="4" placeholder="How was the taste, packaging, freshness, and delivery?" required></textarea>
                    <div class="invalid-feedback">Please share a few words about the dish.</div>
                </div>

                <div class="mb-4">
                    <label for="reviewImage" class="form-label fw-semibold small"><i class="fa-solid fa-camera text-danger me-1"></i>Attach Food Photo (Optional)</label>
                    <input type="file" name="reviewImage" id="reviewImage" class="form-control rounded-pill" accept="image/*" />
                    <small class="text-muted" style="font-size: 0.75rem;">Upload photo of your delivered food item.</small>
                </div>

                <div class="d-flex gap-2">
                    <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4 py-2 w-50 fw-semibold">Cancel</a>
                    <button class="btn btn-danger rounded-pill px-4 py-2 w-50 fw-bold shadow">
                        <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById("svgStarContainer");
        const stars = container.querySelectorAll(".svg-star-item");
        const ratingInput = document.getElementById("selectedRatingInput");
        let activeScore = 5;

        function renderStars(level, isHover = false) {
            stars.forEach(star => {
                const val = parseInt(star.getAttribute("data-value"));
                if (isHover) {
                    if (val <= level) {
                        star.classList.add("hover");
                    } else {
                        star.classList.remove("hover");
                        star.classList.remove("active");
                    }
                } else {
                    star.classList.remove("hover");
                    if (val <= level) {
                        star.classList.add("active");
                    } else {
                        star.classList.remove("active");
                    }
                }
            });
        }

        renderStars(activeScore, false);

        stars.forEach(star => {
            star.addEventListener("mouseenter", function(e) {
                const hoverScore = parseInt(this.getAttribute("data-value"));
                renderStars(hoverScore, true);
            });

            star.addEventListener("click", function(e) {
                activeScore = parseInt(this.getAttribute("data-value"));
                ratingInput.value = activeScore;
                renderStars(activeScore, false);
            });
        });

        container.addEventListener("mouseleave", function() {
            renderStars(activeScore, false);
        });
    });
</script>