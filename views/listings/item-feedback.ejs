<% layout("/layouts/boilerplate") %>

<style>
    /* Pure Interactive Star Rating with Dynamic Hover */
    .interactive-star-group {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        cursor: pointer;
        padding: 0.6rem;
    }

    .interactive-star-group i {
        font-size: 2.3rem;
        color: #cbd5e1;
        transition: transform 0.15s ease, color 0.15s ease, filter 0.15s ease;
        cursor: pointer;
    }

    body.dark-mode .interactive-star-group i {
        color: #475569 !important;
    }

    .interactive-star-group i.star-highlight {
        color: #facc15 !important;
        filter: drop-shadow(0 0 8px rgba(250, 204, 21, 0.75)) !important;
        transform: scale(1.18);
    }
</style>

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 p-3 p-md-4 bg-white">
            
            <div class="text-center mb-3">
                <span class="badge bg-danger rounded-pill px-3 py-1 mb-2">Verified Feedback</span>
                <h3 class="fw-bold mb-1">Rate <%= listing.title %></h3>
                <p class="text-muted small mb-0"><i class="fa-solid fa-store text-danger me-1"></i><%= listing.restaurant || 'Hungrymate Hub' %></p>
            </div>

            <div class="text-center mb-3">
                <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="rounded-3 shadow-sm object-fit-cover" style="height: 120px; width: 180px;">
            </div>

            <form method="POST" action="/listings/<%= listing._id %>/reviews" enctype="multipart/form-data" novalidate class="needs-validation">
                
                <div class="mb-4 text-center">
                    <label class="form-label fw-bold small text-dark d-block mb-1">Tap Stars to Rate:</label>
                    <div class="interactive-star-group" id="starRatingContainer">
                        <i class="fa-solid fa-star" data-index="1"></i>
                        <i class="fa-solid fa-star" data-index="2"></i>
                        <i class="fa-solid fa-star" data-index="3"></i>
                        <i class="fa-solid fa-star" data-index="4"></i>
                        <i class="fa-solid fa-star" data-index="5"></i>
                    </div>
                    <input type="hidden" name="review[rating]" id="selectedRatingInput" value="5" required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Your Name / Handle</label>
                    <input type="text" class="form-control rounded-pill px-3" value="<%= currUser ? currUser.username : 'Customer' %>" readonly style="background-color: #f8fafc;" />
                </div>

                <div class="mb-3">
                    <label for="comment" class="form-label fw-semibold small">Describe Your Experience</label>
                    <textarea name="review[comment]" id="comment" class="form-control rounded-4 p-3" rows="4" placeholder="How was the taste, packaging, freshness, and delivery?" required></textarea>
                    <div class="invalid-feedback">Please share a few words about the dish.</div>
                </div>

                <div class="mb-4">
                    <label for="reviewImage" class="form-label fw-semibold small"><i class="fa-solid fa-camera text-danger me-1"></i>Attach Food Photo (Optional)</label>
                    <input type="file" name="reviewImage" id="reviewImage" class="form-control rounded-pill" accept="image/*" />
                    <small class="text-muted" style="font-size: 0.75rem;">Upload photo of your delivered food item.</small>
                </div>

                <div class="d-flex gap-2">
                    <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4 py-2 w-50 fw-semibold">Cancel</a>
                    <button class="btn btn-danger rounded-pill px-4 py-2 w-50 fw-bold shadow">
                        <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const starContainer = document.getElementById("starRatingContainer");
        const stars = starContainer.querySelectorAll("i");
        const ratingInput = document.getElementById("selectedRatingInput");
        let selectedScore = 5;

        function paintStars(limit) {
            stars.forEach(star => {
                const idx = parseInt(star.getAttribute("data-index"));
                if (idx <= limit) {
                    star.classList.add("star-highlight");
                } else {
                    star.classList.remove("star-highlight");
                }
            });
        }

        paintStars(selectedScore);

        stars.forEach(star => {
            star.addEventListener("mouseenter", function() {
                const hoverIndex = parseInt(this.getAttribute("data-index"));
                paintStars(hoverIndex);
            });

            star.addEventListener("click", function() {
                selectedScore = parseInt(this.getAttribute("data-index"));
                ratingInput.value = selectedScore;
                paintStars(selectedScore);
            });
        });

        starContainer.addEventListener("mouseleave", function() {
            paintStars(selectedScore);
        });
    });
</script>