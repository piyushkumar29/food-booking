<% layout("/layouts/boilerplate") %>

<style>
    .top-action-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 100%;
        padding: 0.35rem 0;
        gap: 0.5rem;
        box-sizing: border-box;
    }
    
    .filter-wrapper {
        display: flex;
        align-items: center;
        flex: 1 1 240px;
        min-width: 0;
        overflow: hidden;
    }
    #filters {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-behavior: smooth;
        gap: 1.15rem;
        padding: 0.35rem 0.1rem;
        width: 100%;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }
    #filters::-webkit-scrollbar { display: none; }
    
    .filter {
        text-align: center;
        opacity: 0.75;
        cursor: pointer;
        flex-shrink: 0;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .filter:hover, .filter.active-filter {
        opacity: 1;
        transform: translateY(-2px) scale(1.05);
    }
    .filter div i { font-size: 1.25rem; margin-bottom: 0.2rem; display: inline-block; }
    .filter p { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.3px; text-transform: uppercase; margin: 0; color: #0f172a; }
    body.dark-mode .filter div i { color: #FFC107 !important; }
    body.dark-mode .filter p { color: #ffffff !important; }

    .scroll-btn {
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 50%;
        width: 32px; height: 32px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; flex-shrink: 0;
    }
    body.dark-mode .scroll-btn {
        background-color: #121215 !important;
        border-color: #27272a !important;
        color: #ffffff !important;
    }

    .controls-pills-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-shrink: 0;
    }

    .clickable-toggle-box {
        background-color: #ffffff;
        border: 1.5px solid #cbd5e1;
        border-radius: 30px;
        padding: 0.28rem 0.55rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        cursor: pointer;
        user-select: none;
        flex-shrink: 0;
    }
    body.dark-mode .clickable-toggle-box {
        background-color: #121215 !important;
        border: 1.5px solid #3f3f46 !important;
        color: #ffffff !important;
    }
    .toggle-label { font-size: 0.72rem; font-weight: 700; margin: 0; white-space: nowrap; }
</style>

<!-- Categories & Controls (Points 2 & 3: Extraction Engine) -->
<div class="top-action-bar">
    <div class="filter-wrapper">
        <button class="scroll-btn me-1 d-none d-sm-flex" id="slideLeft"><i class="fa-solid fa-chevron-left"></i></button>
        <div id="filters">
            <div class="filter active-filter" data-category="all"><div><i class="fa-solid fa-utensils"></i></div><p>All</p></div>
            <div class="filter" data-category="trending"><div><i class="fa-solid fa-fire text-danger"></i></div><p>Trending</p></div>
            <div class="filter" data-category="breakfast"><div><i class="fa-solid fa-egg text-warning"></i></div><p>Breakfast</p></div>
            <div class="filter" data-category="biryani"><div><i class="fa-solid fa-bowl-rice text-warning"></i></div><p>Biryani</p></div>
            <div class="filter" data-category="thali"><div><i class="fa-solid fa-plate-wheat text-success"></i></div><p>Thali</p></div>
            <div class="filter" data-category="pizza"><div><i class="fa-solid fa-pizza-slice text-danger"></i></div><p>Pizza/Burger</p></div>
            <div class="filter" data-category="street food"><div><i class="fa-solid fa-hotdog text-warning"></i></div><p>Street Food</p></div>
            <div class="filter" data-category="rolls"><div><i class="fa-solid fa-scroll text-primary"></i></div><p>Kathi Rolls</p></div>
            <div class="filter" data-category="momos"><div><i class="fa-solid fa-cloud text-secondary"></i></div><p>Momos</p></div>
            <div class="filter" data-category="chinese"><div><i class="fa-solid fa-bowl-food text-danger"></i></div><p>Chinese/Noodles</p></div>
            <div class="filter" data-category="north indian"><div><i class="fa-solid fa-cubes-stacked text-warning"></i></div><p>Curries/Naan</p></div>
            <div class="filter" data-category="south indian"><div><i class="fa-solid fa-circle-dot text-success"></i></div><p>South Indian</p></div>
            <div class="filter" data-category="veg"><div><i class="fa-solid fa-seedling text-success"></i></div><p>Pure Veg</p></div>
            <div class="filter" data-category="non veg"><div><i class="fa-solid fa-drumstick-bite text-danger"></i></div><p>Non Veg</p></div>
            <div class="filter" data-category="dessert"><div><i class="fa-solid fa-ice-cream text-info"></i></div><p>Ice-Cream</p></div>
            <div class="filter" data-category="cake"><div><i class="fa-solid fa-cake-candles text-danger"></i></div><p>Cake/Bakery</p></div>
            <div class="filter" data-category="beverages"><div><i class="fa-solid fa-mug-saucer text-primary"></i></div><p>Beverages/Shakes</p></div>
        </div>
        <button class="scroll-btn ms-1 d-none d-sm-flex" id="slideRight"><i class="fa-solid fa-chevron-right"></i></button>
    </div>

    <!-- Veg & Dark Mode Toggle Controls -->
    <div class="controls-pills-bar">
        <div class="clickable-toggle-box" id="vegPill">
            <span class="toggle-label">&#x1F7E2; Veg</span>
            <input class="form-check-input mt-0" type="checkbox" id="onlyVegToggle" role="switch">
        </div>
        <div class="clickable-toggle-box" id="darkPill">
            <span class="toggle-label" id="darkLabel"><i class="fa-solid fa-moon"></i> Dark</span>
            <input class="form-check-input mt-0" type="checkbox" id="darkModeToggle" role="switch">
        </div>
    </div>
</div>

<!-- Active Restaurant Filter Strip -->
<div id="activeRestaurantAlert" class="alert alert-warning py-2 px-3 small d-flex justify-content-between align-items-center my-2 d-none rounded-3">
    <span><i class="fa-solid fa-store text-danger me-1"></i> Showing all food from: <strong id="filterRestName">Restaurant</strong></span>
    <button type="button" class="btn btn-sm btn-dark rounded-pill py-0 px-3 fw-bold" onclick="clearRestaurantFilter()">Show All</button>
</div>

<!-- Uniform Food Cards Grid -->
<div class="pure-food-grid" id="listingsContainer">
    <% for(let listing of allListings) { %>
        <% 
            let avgRating = 4.8;
            if(listing.reviews && listing.reviews.length > 0) {
                let sum = listing.reviews.reduce((acc, r) => acc + r.rating, 0);
                avgRating = (sum / listing.reviews.length).toFixed(1);
            } else {
                let charCodeSum = (listing.title || '').split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);
                avgRating = (4.3 + (charCodeSum % 7) * 0.1).toFixed(1);
            }

            let currentPrice = listing.price || 199;
            let originalCutPrice = Math.round(currentPrice * 2.5);
            let isVegFood = (listing.isVeg === true || String(listing.isVeg) === 'true');
        %>
        <div class="food-card-box"
             data-title="<%= (listing.title || '').toLowerCase() %>"
             data-restaurant="<%= (listing.restaurant || '').toLowerCase() %>"
             data-location="<%= (listing.location || '').toLowerCase() %>"
             data-category="<%= (listing.category || '').toLowerCase() %>"
             data-description="<%= (listing.description || '').toLowerCase() %>"
             data-isveg="<%= String(listing.isVeg) %>">
            
            <div class="listing-card">
                <div class="card-img-wrapper">
                    <span class="offer-tag-badge">FLAT 60% OFF</span>
                    <span class="rating-top-badge"><i class="fa-solid fa-star me-1"></i><%= avgRating %></span>

                    <a href="/listings/<%= listing._id %>" class="d-block w-100 h-100" onclick="saveActiveRestaurant('<%= listing.restaurant %>')">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy">
                    </a>
                </div>
                
                <div class="card-body">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 class="card-title fw-bold text-truncate mb-0" style="max-width: 82%;">
                                <%= listing.title %>
                            </h6>

                            <div class="food-diet-symbol <%= isVegFood ? 'veg-badge' : 'nonveg-badge' %>" title="<%= isVegFood ? 'Pure Vegetarian' : 'Non-Vegetarian' %>">
                                <span class="diet-circle"></span>
                            </div>
                        </div>
                        <small class="text-muted d-block text-truncate mb-1">
                            <a href="javascript:void(0)" onclick="filterSpecificRestaurant('<%= listing.restaurant %>')" class="text-decoration-none text-muted" title="Click to view all dishes from this restaurant">
                                <i class="fa-solid fa-store text-danger me-1"></i><%= listing.restaurant || 'Hungrymate Hub' %>
                            </a>
                        </small>
                    </div>

                    <div class="card-action-footer">
                        <div class="food-price-wrap">
                            <span class="food-old-price">&#8377;<%= originalCutPrice.toLocaleString("en-IN") %></span>
                            <span class="food-new-price">&#8377;<%= currentPrice.toLocaleString("en-IN") %></span>
                        </div>
                        
                        <button class="btn btn-add-cart-pill shadow-sm" onclick="addToCart('<%= listing._id %>', '<%= listing.title.replace(/'/g, '') %>', <%= listing.price %>, '<%= listing.image.url %>', <%= listing.preparationTime || 20 %>, '<%= (listing.restaurant || '').replace(/'/g, '') %>')">
                            + Add to Cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<!-- Friendly No Match Card with Alternatives -->
<div id="noMatchMessage" class="text-center py-5 d-none">
    <div class="p-4 rounded-4 shadow-sm d-inline-block border" style="max-width: 480px;">
        <i class="fa-solid fa-bowl-food fs-1 text-danger mb-3"></i>
        <h5 class="fw-bold">No Food Items Found!</h5>
        <p class="text-muted small mb-3">We couldn't find any dish matching your search keyword. Try searching for popular food items like <strong>Biryani, Pizza, Burger, Tacos, Rolls, or Cakes</strong>.</p>
        <button class="btn btn-danger rounded-pill px-4 btn-sm fw-bold shadow-sm" onclick="resetAllSearchAndFilters()">
            Explore All Food Items
        </button>
    </div>
</div>

<script>
    let activeRestaurantFilter = "";
    let activeCat = "all";

    function saveActiveRestaurant(restaurant) {
        if (restaurant && restaurant.trim() !== "") {
            localStorage.setItem("hungrymate_last_viewed_restaurant", restaurant.trim());
        }
    }

    function filterSpecificRestaurant(restName) {
        if (!restName) return;
        localStorage.setItem("hungrymate_last_viewed_restaurant", restName);
        activeRestaurantFilter = restName.trim().toLowerCase();
        
        document.getElementById("activeRestaurantAlert").classList.remove("d-none");
        document.getElementById("filterRestName").innerText = restName;
        applyAllFilters();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function clearRestaurantFilter() {
        activeRestaurantFilter = "";
        document.getElementById("activeRestaurantAlert").classList.add("d-none");
        if (window.history.replaceState) {
            const url = new URL(window.location);
            url.searchParams.delete('restaurant');
            window.history.replaceState({}, '', url);
        }
        applyAllFilters();
    }

    function resetAllSearchAndFilters() {
        if (searchInput) searchInput.value = "";
        if (mobileSearchInput) mobileSearchInput.value = "";
        activeCat = "all";
        activeRestaurantFilter = "";
        document.getElementById("activeRestaurantAlert").classList.add("d-none");
        categoryFilters.forEach(item => item.classList.remove("active-filter"));
        const allCatBtn = document.querySelector('.filter[data-category="all"]');
        if (allCatBtn) allCatBtn.classList.add("active-filter");
        applyAllFilters();
    }

    function addToCart(id, title, price, image, prepTime, restaurant) {
        let cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        const existing = cart.find(item => item.id === id);
        if (existing) {
            existing.quantity += 1;
        } else {
            cart.push({ id, title, price, image, prepTime: prepTime || 20, restaurant: restaurant || "Chef Kitchen", quantity: 1 });
        }
        localStorage.setItem("hungrymate_cart", JSON.stringify(cart));
        if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
        alert(`${title} added to your cart!`);
    }

    const filterBox = document.getElementById("filters");
    const slBtn = document.getElementById("slideLeft");
    const srBtn = document.getElementById("slideRight");
    if (slBtn) slBtn.addEventListener("click", () => filterBox.scrollBy({ left: -240, behavior: "smooth" }));
    if (srBtn) srBtn.addEventListener("click", () => filterBox.scrollBy({ left: 240, behavior: "smooth" }));

    const vegPill = document.getElementById("vegPill");
    const onlyVegToggle = document.getElementById("onlyVegToggle");
    vegPill.addEventListener("click", () => {
        onlyVegToggle.checked = !onlyVegToggle.checked;
        applyAllFilters();
    });

    const darkPill = document.getElementById("darkPill");
    const darkModeToggle = document.getElementById("darkModeToggle");
    const darkLabel = document.getElementById("darkLabel");

    function updateDarkMode(isDark) {
        if (isDark) {
            document.body.classList.add("dark-mode");
            if (darkModeToggle) darkModeToggle.checked = true;
            if (darkLabel) darkLabel.innerHTML = '<i class="fa-solid fa-sun text-warning"></i> Light';
            localStorage.setItem("hungrymate_dark_theme", "active");
        } else {
            document.body.classList.remove("dark-mode");
            if (darkModeToggle) darkModeToggle.checked = false;
            if (darkLabel) darkLabel.innerHTML = '<i class="fa-solid fa-moon"></i> Dark';
            localStorage.setItem("hungrymate_dark_theme", "inactive");
        }
    }
    if (localStorage.getItem("hungrymate_dark_theme") === "active") updateDarkMode(true);
    if (darkPill) darkPill.addEventListener("click", () => updateDarkMode(!darkModeToggle.checked));

    const foodCards = document.querySelectorAll(".food-card-box");
    const searchInput = document.getElementById("foodSearchInput");
    const mobileSearchInput = document.getElementById("mobileFoodSearchInput");
    const categoryFilters = document.querySelectorAll(".filter");
    const noMatchMsg = document.getElementById("noMatchMessage");

    // Exact Category Match Function (Point 2)
    function checkCategoryMatch(activeCat, title, category, description, isVeg) {
        if (activeCat === "all" || activeCat === "trending") return true;
        if (activeCat === "veg") return isVeg;
        if (activeCat === "non veg") return !isVeg;
        
        const fullContent = `${title} ${category} ${description}`.toLowerCase();

        if (activeCat === "cake") {
            return fullContent.includes("cake") || fullContent.includes("bakery") || fullContent.includes("pastry") || fullContent.includes("brownie") || fullContent.includes("muffin");
        }
        if (activeCat === "dessert") {
            return fullContent.includes("dessert") || fullContent.includes("ice cream") || fullContent.includes("ice-cream") || fullContent.includes("gelato") || fullContent.includes("kulfi") || fullContent.includes("sundae");
        }
        if (activeCat === "breakfast") {
            return fullContent.includes("breakfast") || fullContent.includes("pancake") || fullContent.includes("waffle") || fullContent.includes("toast") || fullContent.includes("paratha") || fullContent.includes("croissant") || fullContent.includes("dosa") || fullContent.includes("idli") || fullContent.includes("egg");
        }
        if (activeCat === "thali") {
            return fullContent.includes("thali") || fullContent.includes("meals") || fullContent.includes("platter");
        }
        if (activeCat === "biryani") {
            return fullContent.includes("biryani") || fullContent.includes("pulao") || fullContent.includes("rice");
        }
        if (activeCat === "pizza") {
            return fullContent.includes("pizza") || fullContent.includes("burger") || fullContent.includes("tacos") || fullContent.includes("nachos") || fullContent.includes("fries") || fullContent.includes("fast food");
        }
        if (activeCat === "burger") {
            return fullContent.includes("burger") || fullContent.includes("hot dog");
        }
        if (activeCat === "rolls") {
            return fullContent.includes("roll") || fullContent.includes("shawarma") || fullContent.includes("kathi") || fullContent.includes("wrap");
        }
        if (activeCat === "momos") {
            return fullContent.includes("momo") || fullContent.includes("dumpling");
        }
        if (activeCat === "chinese") {
            return fullContent.includes("chinese") || fullContent.includes("noodles") || fullContent.includes("chow mein") || fullContent.includes("ramen") || fullContent.includes("manchurian");
        }
        if (activeCat === "north indian") {
            return fullContent.includes("north") || fullContent.includes("paneer") || fullContent.includes("dal") || fullContent.includes("naan") || fullContent.includes("butter chicken") || fullContent.includes("curry") || fullContent.includes("roti");
        }
        if (activeCat === "south indian") {
            return fullContent.includes("south") || fullContent.includes("dosa") || fullContent.includes("idli") || fullContent.includes("sambar") || fullContent.includes("vada") || fullContent.includes("uttapam");
        }
        if (activeCat === "beverages") {
            return fullContent.includes("beverage") || fullContent.includes("shake") || fullContent.includes("coffee") || fullContent.includes("tea") || fullContent.includes("juice") || fullContent.includes("smoothie") || fullContent.includes("cooler");
        }
        return fullContent.includes(activeCat);
    }

    // Live Search Extraction (Point 3)
    function applyAllFilters() {
        const query = ((searchInput ? searchInput.value : "") || (mobileSearchInput ? mobileSearchInput.value : "")).trim().toLowerCase();
        const vegOnly = onlyVegToggle.checked;
        let visibleCount = 0;

        foodCards.forEach(card => {
            const title = card.getAttribute("data-title") || "";
            const restaurant = card.getAttribute("data-restaurant") || "";
            const location = card.getAttribute("data-location") || "";
            const category = card.getAttribute("data-category") || "";
            const description = card.getAttribute("data-description") || "";
            const isVeg = card.getAttribute("data-isveg") === "true";

            const fullContent = `${title} ${restaurant} ${location} ${category} ${description}`;
            const matchSearch = !query || fullContent.includes(query) || query.split(' ').every(k => fullContent.includes(k));
            const matchVeg = !vegOnly || isVeg;
            const matchRestaurant = !activeRestaurantFilter || restaurant === activeRestaurantFilter || restaurant.includes(activeRestaurantFilter);
            const matchCat = checkCategoryMatch(activeCat, title, category, description, isVeg);

            if (matchSearch && matchVeg && matchCat && matchRestaurant) {
                card.style.display = "flex";
                visibleCount++;
            } else {
                card.style.display = "none";
            }
        });

        if (visibleCount === 0) noMatchMsg.classList.remove("d-none");
        else noMatchMsg.classList.add("d-none");
    }

    window.executeSearchNow = function() {
        const sBox = document.getElementById("searchHistoryBox");
        if (sBox) sBox.classList.add("d-none");
        applyAllFilters();
    };

    function buildLiveRecommendations(inputEl) {
        if (!inputEl) return;
        const box = document.getElementById("searchHistoryBox");
        const list = document.getElementById("historyList");
        if (!box || !list) return;

        inputEl.addEventListener("input", () => {
            const val = inputEl.value.trim().toLowerCase();
            if (!val) {
                box.classList.add("d-none");
                applyAllFilters();
                return;
            }

            let suggestions = new Set();
            foodCards.forEach(card => {
                const title = card.getAttribute("data-title") || "";
                const restaurant = card.getAttribute("data-restaurant") || "";
                if (title.includes(val)) suggestions.add(title);
                if (restaurant.includes(val)) suggestions.add(restaurant);
            });

            const arr = Array.from(suggestions).slice(0, 6);
            if (arr.length > 0) {
                box.classList.remove("d-none");
                list.innerHTML = "";
                arr.forEach(item => {
                    const li = document.createElement("li");
                    li.innerHTML = `<i class="fa-solid fa-magnifying-glass text-warning me-2"></i> ${item}`;
                    li.onclick = () => {
                        inputEl.value = item;
                        if (searchInput) searchInput.value = item;
                        if (mobileSearchInput) mobileSearchInput.value = item;
                        box.classList.add("d-none");
                        applyAllFilters();
                    };
                    list.appendChild(li);
                });
            } else {
                box.classList.add("d-none");
            }
            applyAllFilters();
        });

        inputEl.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                executeSearchNow();
            }
        });
    }

    buildLiveRecommendations(searchInput);
    buildLiveRecommendations(mobileSearchInput);

    categoryFilters.forEach(f => {
        f.addEventListener("click", () => {
            categoryFilters.forEach(item => item.classList.remove("active-filter"));
            f.classList.add("active-filter");
            activeCat = f.getAttribute("data-category");
            applyAllFilters();
        });
    });

    document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById("restaurantChipsContainer");
        if (container) {
            let uniqueRests = new Set();
            foodCards.forEach(c => {
                const r = c.getAttribute("data-restaurant");
                if (r && r.trim()) uniqueRests.add(r.trim());
            });

            if (uniqueRests.size > 0) {
                container.innerHTML = "";
                Array.from(uniqueRests).sort().forEach(r => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "btn btn-sm btn-outline-secondary rounded-pill rest-chip-btn";
                    btn.innerHTML = `<i class="fa-solid fa-store me-1 text-danger"></i> ${r}`;
                    btn.onclick = () => {
                        if (typeof selectRestaurantFilter === "function") selectRestaurantFilter(r);
                    };
                    container.appendChild(btn);
                });
            }
        }

        const urlParams = new URLSearchParams(window.location.search);
        const restParam = urlParams.get("restaurant");
        if (restParam) {
            filterSpecificRestaurant(restParam);
        }
    });
</script>