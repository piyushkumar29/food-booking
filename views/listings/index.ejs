<% layout("/layouts/boilerplate") %>

<style>
    /* Top Category Horizontal Scroll */
    .top-action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 100%;
        padding: 0.4rem 0;
        gap: 0.5rem;
        box-sizing: border-box;
    }
    .filter-wrapper {
        display: flex;
        align-items: center;
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
    }
    #filters {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-behavior: smooth;
        gap: 1.1rem;
        padding: 0.3rem 0.1rem;
        width: 100%;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }
    #filters::-webkit-scrollbar { display: none; }
    .filter {
        text-align: center;
        opacity: 0.75;
        cursor: pointer;
        flex-shrink: 0;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .filter:hover, .filter.active-filter {
        opacity: 1;
        transform: translateY(-2px) scale(1.05);
    }
    .filter div i { font-size: 1.25rem; margin-bottom: 0.2rem; display: inline-block; }
    .filter p { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.3px; text-transform: uppercase; margin: 0; color: #0f172a; }
    body.dark-mode .filter div i { color: #FFC107 !important; }
    body.dark-mode .filter p { color: #ffffff !important; }

    .scroll-btn {
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 50%;
        width: 30px; height: 30px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; flex-shrink: 0;
    }
    body.dark-mode .scroll-btn {
        background-color: #121212 !important;
        border-color: #27272a !important;
        color: #ffffff !important;
    }

    .clickable-toggle-box {
        background-color: #ffffff;
        border: 1.5px solid #cbd5e1;
        border-radius: 30px;
        padding: 0.25rem 0.55rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        cursor: pointer;
        user-select: none;
        flex-shrink: 0;
    }
    body.dark-mode .clickable-toggle-box {
        background-color: #121212 !important;
        border-color: #27272a !important;
        color: #ffffff !important;
    }
    .toggle-label { font-size: 0.72rem; font-weight: 700; margin: 0; white-space: nowrap; }

    /* Pure Responsive Grid Layout across All Devices */
    .pure-food-grid {
        display: grid !important;
        width: 100% !important;
        max-width: 100% !important;
        margin-top: 0.6rem !important;
        box-sizing: border-box !important;
    }

    .listing-card {
        border: none !important;
        border-radius: 1.2rem !important;
        overflow: hidden !important;
        box-shadow: 0 4px 18px rgba(15,23,42,0.06) !important;
        transition: transform 0.25s ease, box-shadow 0.25s ease !important;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }
    .listing-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px rgba(15,23,42,0.12) !important;
    }
    .listing-card img {
        width: 100% !important;
        object-fit: cover !important;
    }
    body.dark-mode .listing-card {
        background-color: #121212 !important;
        border: 1px solid #27272a !important;
    }
    .offer-tag-badge {
        position: absolute;
        top: 10px; left: 10px;
        background: linear-gradient(135deg, #fe424d 0%, #ec4899 100%);
        color: #ffffff; font-weight: 800; font-size: 0.72rem;
        padding: 0.25rem 0.55rem; border-radius: 6px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.25);
    }
    .rating-top-badge {
        position: absolute;
        top: 10px; right: 10px;
        background: rgba(0, 0, 0, 0.75);
        color: #FFD700; font-weight: 800; font-size: 0.74rem;
        padding: 0.22rem 0.55rem; border-radius: 6px;
        backdrop-filter: blur(4px);
    }

    .card-action-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 0.8rem;
        padding: 0.6rem 0.2rem 0.1rem 0.2rem;
        border-top: 1px solid #f1f5f9;
    }
    .food-card-price {
        font-weight: 800;
        font-size: 1.25rem;
        color: #fe424d;
        letter-spacing: -0.5px;
    }
    .btn-add-cart-pill {
        border: 2px solid #fe424d;
        color: #fe424d;
        background: transparent;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.38rem 1.1rem;
        border-radius: 50px;
        transition: all 0.25s ease;
    }
    .btn-add-cart-pill:hover {
        background: #fe424d;
        color: #ffffff;
        transform: scale(1.03);
    }

    body.dark-mode .card-action-footer {
        border-top-color: #27272a !important;
    }
    body.dark-mode .food-card-price {
        color: #FFC107 !important;
    }
    body.dark-mode .btn-add-cart-pill {
        background-color: #FFC107 !important;
        border-color: #FFC107 !important;
        color: #000000 !important;
        font-weight: 800 !important;
    }
</style>

<div class="top-action-bar">
    <div class="filter-wrapper">
        <button class="scroll-btn me-1 d-none d-sm-flex" id="slideLeft"><i class="fa-solid fa-chevron-left"></i></button>
        <div id="filters">
            <div class="filter active-filter" data-category="all"><div><i class="fa-solid fa-utensils"></i></div><p>All</p></div>
            <div class="filter" data-category="breakfast"><div><i class="fa-solid fa-egg text-warning"></i></div><p>Breakfast</p></div>
            <div class="filter" data-category="biryani"><div><i class="fa-solid fa-bowl-rice"></i></div><p>Biryani</p></div>
            <div class="filter" data-category="thali"><div><i class="fa-solid fa-plate-wheat"></i></div><p>Thali</p></div>
            <div class="filter" data-category="fast food"><div><i class="fa-solid fa-pizza-slice"></i></div><p>Fast Food</p></div>
            <div class="filter" data-category="burger"><div><i class="fa-solid fa-burger"></i></div><p>Burger</p></div>
            <div class="filter" data-category="veg"><div><i class="fa-solid fa-seedling text-success"></i></div><p>Pure Veg</p></div>
            <div class="filter" data-category="non veg"><div><i class="fa-solid fa-drumstick-bite text-danger"></i></div><p>Non Veg</p></div>
            <div class="filter" data-category="ice-cream"><div><i class="fa-solid fa-ice-cream text-info"></i></div><p>Ice-cream</p></div>
            <div class="filter" data-category="bakery"><div><i class="fa-solid fa-cake-candles text-danger"></i></div><p>Bakery</p></div>
            <div class="filter" data-category="dessert"><div><i class="fa-solid fa-cookie"></i></div><p>Dessert</p></div>
        </div>
        <button class="scroll-btn ms-1 d-none d-sm-flex" id="slideRight"><i class="fa-solid fa-chevron-right"></i></button>
    </div>

    <div class="d-flex align-items-center gap-1 flex-shrink-0">
        <div class="clickable-toggle-box" id="vegPill">
            <span class="toggle-label">&#x1F7E2; Veg</span>
            <input class="form-check-input mt-0" type="checkbox" id="onlyVegToggle" role="switch">
        </div>
        <div class="clickable-toggle-box d-none d-sm-inline-flex" id="darkPill">
            <span class="toggle-label" id="darkLabel"><i class="fa-solid fa-moon"></i> Dark</span>
            <input class="form-check-input mt-0" type="checkbox" id="darkModeToggle" role="switch">
        </div>
    </div>
</div>

<div id="activeRestaurantAlert" class="alert alert-warning py-2 px-3 small d-flex justify-content-between align-items-center my-2 d-none rounded-3">
    <span><i class="fa-solid fa-store text-danger me-1"></i> Showing all food from: <strong id="filterRestName">Restaurant</strong></span>
    <button type="button" class="btn btn-sm btn-dark rounded-pill py-0 px-3 fw-bold" onclick="clearRestaurantFilter()">Show All</button>
</div>

<div class="pure-food-grid" id="listingsContainer">
    <% for(let listing of allListings) { %>
        <% 
            let avgRating = 4.8;
            if(listing.reviews && listing.reviews.length > 0) {
                let sum = listing.reviews.reduce((acc, r) => acc + r.rating, 0);
                avgRating = (sum / listing.reviews.length).toFixed(1);
            } else {
                let charCodeSum = (listing.title || '').split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);
                avgRating = (4.3 + (charCodeSum % 7) * 0.1).toFixed(1);
            }
        %>
        <div class="food-card-box"
             data-title="<%= (listing.title || '').toLowerCase() %>"
             data-restaurant="<%= (listing.restaurant || '').toLowerCase() %>"
             data-location="<%= (listing.location || '').toLowerCase() %>"
             data-category="<%= (listing.category || '').toLowerCase() %>"
             data-isveg="<%= String(listing.isVeg) %>">
            
            <div class="card listing-card shadow-sm h-100 position-relative">
                <span class="offer-tag-badge">FLAT 60% OFF</span>
                <span class="rating-top-badge"><i class="fa-solid fa-star me-1"></i><%= avgRating %></span>

                <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark" onclick="saveActiveRestaurant('<%= listing.restaurant %>')">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy">
                </a>
                
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 class="card-title fw-bold text-truncate mb-0" style="max-width: 82%;">
                                <%= listing.title %>
                            </h6>
                            <span><%= (listing.isVeg === true || String(listing.isVeg) === 'true') ? '🟢' : '🔴' %></span>
                        </div>
                        <small class="text-muted d-block text-truncate mb-1">
                            <a href="javascript:void(0)" onclick="filterSpecificRestaurant('<%= listing.restaurant %>')" class="text-decoration-none text-muted" title="Click to view all dishes from this restaurant">
                                <i class="fa-solid fa-store text-danger me-1"></i><%= listing.restaurant || 'Hungrymate Hub' %>
                            </a>
                        </small>
                    </div>

                    <div class="card-action-footer">
                        <span class="food-card-price">
                            &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %>
                        </span>
                        
                        <button class="btn btn-add-cart-pill shadow-sm" onclick="addToCart('<%= listing._id %>', '<%= listing.title.replace(/'/g, '') %>', <%= listing.price %>, '<%= listing.image.url %>', <%= listing.preparationTime || 20 %>, '<%= (listing.restaurant || '').replace(/'/g, '') %>')">
                            + Add to Cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<div id="noMatchMessage" class="text-center py-5 d-none">
    <i class="fa-solid fa-bowl-food fs-1 text-muted mb-3"></i>
    <h4 class="text-secondary">No food items found!</h4>
    <p class="text-muted">Try another dish keyword or clear your active restaurant filter.</p>
</div>

<script>
    let activeRestaurantFilter = "";

    function saveActiveRestaurant(restaurant) {
        if (restaurant && restaurant.trim() !== "") {
            localStorage.setItem("hungrymate_last_viewed_restaurant", restaurant.trim());
        }
    }

    function filterSpecificRestaurant(restName) {
        if (!restName) return;
        localStorage.setItem("hungrymate_last_viewed_restaurant", restName);
        activeRestaurantFilter = restName.trim().toLowerCase();
        
        document.getElementById("activeRestaurantAlert").classList.remove("d-none");
        document.getElementById("filterRestName").innerText = restName;
        applyAllFilters();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function clearRestaurantFilter() {
        activeRestaurantFilter = "";
        document.getElementById("activeRestaurantAlert").classList.add("d-none");
        
        if (window.history.replaceState) {
            const url = new URL(window.location);
            url.searchParams.delete('restaurant');
            window.history.replaceState({}, '', url);
        }
        
        applyAllFilters();
    }

    function addToCart(id, title, price, image, prepTime, restaurant) {
        let cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        const existing = cart.find(item => item.id === id);
        if (existing) {
            existing.quantity += 1;
        } else {
            cart.push({ id, title, price, image, prepTime: prepTime || 20, restaurant: restaurant || "Chef Kitchen", quantity: 1 });
        }
        localStorage.setItem("hungrymate_cart", JSON.stringify(cart));
        if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
        alert(`${title} added to your cart!`);
    }

    const filterBox = document.getElementById("filters");
    const slBtn = document.getElementById("slideLeft");
    const srBtn = document.getElementById("slideRight");
    if (slBtn) slBtn.addEventListener("click", () => filterBox.scrollBy({ left: -240, behavior: "smooth" }));
    if (srBtn) srBtn.addEventListener("click", () => filterBox.scrollBy({ left: 240, behavior: "smooth" }));

    const vegPill = document.getElementById("vegPill");
    const onlyVegToggle = document.getElementById("onlyVegToggle");
    vegPill.addEventListener("click", () => {
        onlyVegToggle.checked = !onlyVegToggle.checked;
        applyAllFilters();
    });

    const darkPill = document.getElementById("darkPill");
    const darkModeToggle = document.getElementById("darkModeToggle");
    const darkLabel = document.getElementById("darkLabel");

    function updateDarkMode(isDark) {
        if (isDark) {
            document.body.classList.add("dark-mode");
            if (darkModeToggle) darkModeToggle.checked = true;
            if (darkLabel) darkLabel.innerHTML = '<i class="fa-solid fa-sun text-warning"></i> Light';
            localStorage.setItem("hungrymate_dark_theme", "active");
        } else {
            document.body.classList.remove("dark-mode");
            if (darkModeToggle) darkModeToggle.checked = false;
            if (darkLabel) darkLabel.innerHTML = '<i class="fa-solid fa-moon"></i> Dark';
            localStorage.setItem("hungrymate_dark_theme", "inactive");
        }
    }
    if (localStorage.getItem("hungrymate_dark_theme") === "active") updateDarkMode(true);
    if (darkPill) darkPill.addEventListener("click", () => updateDarkMode(!darkModeToggle.checked));

    const foodCards = document.querySelectorAll(".food-card-box");
    const searchInput = document.getElementById("foodSearchInput");
    const mobileSearchInput = document.getElementById("mobileFoodSearchInput");
    const categoryFilters = document.querySelectorAll(".filter");
    const noMatchMsg = document.getElementById("noMatchMessage");
    let activeCat = "all";

    function applyAllFilters() {
        const query = ((searchInput ? searchInput.value : "") || (mobileSearchInput ? mobileSearchInput.value : "")).trim().toLowerCase();
        const vegOnly = onlyVegToggle.checked;
        let visibleCount = 0;

        foodCards.forEach(card => {
            const title = card.getAttribute("data-title") || "";
            const restaurant = card.getAttribute("data-restaurant") || "";
            const location = card.getAttribute("data-location") || "";
            const category = card.getAttribute("data-category") || "";
            const isVeg = card.getAttribute("data-isveg") === "true";

            const matchSearch = !query || title.includes(query) || restaurant.includes(query) || location.includes(query) || category.includes(query);
            const matchVeg = !vegOnly || isVeg;
            const matchRestaurant = !activeRestaurantFilter || restaurant === activeRestaurantFilter || restaurant.includes(activeRestaurantFilter);

            let matchCat = (activeCat === "all");
            if (activeCat === "veg") matchCat = isVeg;
            else if (activeCat === "non veg") matchCat = !isVeg;
            else if (activeCat === "ice-cream") matchCat = category.includes("ice-cream") || title.includes("ice cream") || title.includes("sorbet") || title.includes("gelato") || title.includes("sundae");
            else if (activeCat === "bakery") matchCat = category.includes("bakery") || category.includes("cake") || title.includes("cake") || title.includes("brownie") || title.includes("macaron");
            else if (activeCat === "breakfast") matchCat = category.includes("breakfast") || title.includes("pancake") || title.includes("waffle") || title.includes("toast") || title.includes("paratha") || title.includes("croissant") || title.includes("dosa");
            else if (activeCat === "thali") matchCat = category.includes("thali") || title.includes("thali") || title.includes("meals") || title.includes("bento") || title.includes("mezze");
            else if (activeCat === "biryani") matchCat = category.includes("biryani") || title.includes("biryani") || title.includes("pulao") || title.includes("rice");
            else if (activeCat === "fast food") matchCat = category.includes("fast food") || category.includes("pizza") || title.includes("pizza") || title.includes("pasta") || title.includes("fries") || title.includes("tacos") || title.includes("noodles") || title.includes("ramen");
            else if (activeCat === "burger") matchCat = category.includes("burger") || title.includes("burger") || title.includes("hot dog");
            else if (activeCat === "dessert") matchCat = category.includes("dessert") || title.includes("chocolate") || title.includes("cookie") || title.includes("truffle");

            if (matchSearch && matchVeg && matchCat && matchRestaurant) {
                card.style.display = "block";
                visibleCount++;
            } else {
                card.style.display = "none";
            }
        });

        if (visibleCount === 0) noMatchMsg.classList.remove("d-none");
        else noMatchMsg.classList.add("d-none");
    }

    if (searchInput) searchInput.addEventListener("input", applyAllFilters);
    if (mobileSearchInput) mobileSearchInput.addEventListener("input", applyAllFilters);

    categoryFilters.forEach(f => {
        f.addEventListener("click", () => {
            categoryFilters.forEach(item => item.classList.remove("active-filter"));
            f.classList.add("active-filter");
            activeCat = f.getAttribute("data-category");
            applyAllFilters();
        });
    });

    document.addEventListener("DOMContentLoaded", () => {
        const urlParams = new URLSearchParams(window.location.search);
        const restParam = urlParams.get("restaurant");
        if (restParam) {
            filterSpecificRestaurant(restParam);
        }
    });
</script>