<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <br>
            <h3>Edit your listing</h3>
            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                
                <div class="mb-3">
                    <label for="title" class="form-label">Dish Name:</label>
                    <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required/>
                    <div class="invalid-feedback">Please enter a dish name</div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="restaurant" class="form-label">Restaurant Name:</label>
                        <input name="listing[restaurant]" value="<%= listing.restaurant || '' %>" type="text" class="form-control" placeholder="e.g. Behrouz Biryani" required/>
                        <div class="invalid-feedback">Please enter restaurant name</div>
                    </div>
                    <div class="mb-3 col-md-6">
                        <label for="location" class="form-label">Restaurant Location / City:</label>
                        <input name="listing[location]" value="<%= listing.location || '' %>" type="text" class="form-control" placeholder="e.g. Kalyani, West Bengal" required/>
                        <div class="invalid-feedback">Please enter location</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label><br>
                    <textarea name="listing[description]" class="form-control" rows="3" required><%= listing.description %></textarea>
                    <div class="invalid-feedback">Please enter a description</div>
                </div>

                <div class="mb-3">
                    Original food image <br>
                    <img src="<%= originalImageUrl %>" alt="food image" style="width: 250px; height: 180px; object-fit: cover; border-radius: 8px;" />
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Upload new food Image (Optional)</label>
                    <input name="listing[image]" type="file" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="price" class="form-label">Price (₹):</label><br>
                    <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control" required/>
                    <div class="invalid-feedback">Please enter a price</div>
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Category:</label><br>
                    <select name="listing[category]" class="form-select" required>
                        <option value="Starters" <%= listing.category === 'Starters' ? 'selected' : '' %>>Starters</option>
                        <option value="Main Course" <%= listing.category === 'Main Course' ? 'selected' : '' %>>Main Course</option>
                        <option value="Dessert" <%= listing.category === 'Dessert' ? 'selected' : '' %>>Dessert</option>
                        <option value="Beverages" <%= listing.category === 'Beverages' ? 'selected' : '' %>>Beverages</option>
                        <option value="Breakfast / Snacks" <%= listing.category === 'Breakfast / Snacks' ? 'selected' : '' %>>Breakfast / Snacks</option>
                        <option value="Italian / Fast Food" <%= listing.category === 'Italian / Fast Food' ? 'selected' : '' %>>Italian / Fast Food</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="food-type" class="form-label">Food Type:</label><br>
                    <select name="listing[isVeg]" class="form-select" required>
                        <option value="true" <%= listing.isVeg ? 'selected' : '' %>>🟢 Veg</option>
                        <option value="false" <%= !listing.isVeg ? 'selected' : '' %>>🔴 Non-veg</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="preparationTime" class="form-label">Preparation Time (mins):</label><br>
                    <input name="listing[preparationTime]" value="<%= listing.preparationTime %>" type="number" class="form-control" required/>
                    <div class="invalid-feedback">Please enter preparation time</div>
                </div>

                <div class="mb-3">
                    <label for="spiciness" class="form-label">Spiciness Level:</label><br>
                    <select name="listing[spiciness]" class="form-select" required>
                        <option value="Mild" <%= listing.spiciness === 'Mild' ? 'selected' : '' %>>Mild</option>
                        <option value="Medium" <%= listing.spiciness === 'Medium' ? 'selected' : '' %>>Medium</option>
                        <option value="Spicy" <%= listing.spiciness === 'Spicy' ? 'selected' : '' %>>Spicy</option>
                        <option value="Sweet" <%= listing.spiciness === 'Sweet' ? 'selected' : '' %>>Sweet</option>
                        <option value="None" <%= listing.spiciness === 'None' ? 'selected' : '' %>>None</option>
                    </select>
                </div>

                <br>
                <button class="btn btn-dark edit-btn">Update Listing</button>
                <br><br>
            </form>
        </div>
    </div>
</body>