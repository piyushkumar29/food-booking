<% layout("/layouts/boilerplate") %>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
    .track-card-box {
        background: #ffffff;
        border-radius: 20px;
        padding: 1.25rem;
        border: 1.5px solid #e2e8f0;
        box-shadow: 0 10px 30px rgba(15,23,42,0.06);
        max-width: 950px;
        width: 100%;
        margin: 1rem auto 3rem auto;
        box-sizing: border-box !important;
    }
    .delivery-partner-badge {
        background: #f8fafc;
        border: 1.5px solid #cbd5e1;
        border-radius: 14px;
        padding: 0.85rem 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }
    .curved-track-container {
        position: relative;
        width: 100%;
        height: 180px;
        margin: 1rem 0;
        overflow: hidden;
    }
    #deliveryBikeElement {
        position: absolute;
        font-size: 2rem;
        color: #f59e0b;
        filter: drop-shadow(0 3px 8px rgba(0,0,0,0.3));
        transform: translate(-50%, -50%);
        transition: transform 0.05s linear;
        z-index: 10;
    }
    body.dark-mode .track-card-box {
        background: #111827 !important;
        border-color: #1f2937 !important;
        color: #f8fafc !important;
    }
    body.dark-mode .delivery-partner-badge {
        background: #1e293b !important;
        border-color: #334155 !important;
        color: #f8fafc !important;
    }

    #deliveryCompletedBanner {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
        border-radius: 16px;
        padding: 1.25rem;
        text-align: center;
        margin-bottom: 1.5rem;
    }
</style>

<!-- Point 5: Check if User is Logged In -->
<% if(!currUser) { %>
    <div class="row justify-content-center my-5">
        <div class="col-12 col-md-8 col-lg-6 text-center">
            <div class="card p-5 border-0 rounded-4 shadow-sm bg-white">
                <i class="fa-solid fa-lock fs-1 text-danger mb-3"></i>
                <h4 class="fw-bold mb-2">Login Required to View Orders</h4>
                <p class="text-muted small mb-4">Please log in to your Hungrymate account to view your live tracking timeline, past order history, and cashmemo receipts.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="/login" class="btn btn-danger rounded-pill px-4 fw-bold">Log in</a>
                    <a href="/signup" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">Sign up</a>
                </div>
            </div>
        </div>
    </div>
<% } else { %>

<div class="track-card-box">
    
    <!-- Multi-Order Active Tabs Strip -->
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
        <span class="small fw-bold text-muted"><i class="fa-solid fa-list-check me-1"></i> ACTIVE ORDERS:</span>
        <div id="multiOrdersTabStrip" class="d-flex gap-2 flex-wrap"></div>
    </div>

    <!-- Refund Notification Banner (When Cancelled) -->
    <div id="refundNoticeBanner" class="alert alert-danger d-none rounded-3 py-2 px-3 small mb-3">
        <i class="fa-solid fa-circle-exclamation me-1"></i> <strong>Order Cancelled:</strong> <span id="refundMessageText">Your order has been cancelled.</span>
    </div>

    <!-- Delivered Banner with Real PDF Receipt Download -->
    <div id="deliveryCompletedBanner" class="d-none shadow-sm">
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-circle-check me-1"></i>Hurray! Food Delivered Successfully</h4>
        <p class="small mb-2">Your meal was handed over hot & fresh. Enjoy your food!</p>
        <button class="btn btn-light rounded-pill px-3 py-1 fw-bold text-success shadow-sm btn-sm" onclick="downloadCurrentReceiptPdf()">
            <i class="fa-solid fa-file-invoice-dollar me-1"></i>Download Cash Memo Receipt (Excel Format PDF)
        </button>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-3 gap-2">
        <div>
            <h5 class="fw-bold mb-0 text-danger"><i class="fa-solid fa-motorcycle me-1"></i>Live Order Delivery Tracking</h5>
            <span class="small text-muted">Order ID: <strong id="trackOrderId" class="text-warning">HM-NONE</strong></span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button id="cancelOrderBtn" class="btn btn-sm btn-outline-danger rounded-pill fw-bold" onclick="openCancelReasonModal()">
                <i class="fa-solid fa-ban me-1"></i> Cancel Order
            </button>
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                ETA: <strong id="etaCounter">-- mins</strong>
            </span>
        </div>
    </div>

    <!-- Delivery Hero Partner Details -->
    <div class="delivery-partner-badge">
        <div class="d-flex align-items-center gap-2">
            <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 44px; height: 44px;">
                <i class="fa-solid fa-helmet-safety"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0" id="heroNameText" style="font-size: 0.95rem;">Rahul Verma <span class="badge bg-secondary ms-1" id="heroIdBadge" style="font-size: 0.65rem;">ID: HM-DEL-984</span></h6>
                <small class="text-muted" style="font-size: 0.75rem;"><i class="fa-solid fa-star text-warning"></i> 4.9 &bull; Vaccinated Delivery Partner</small>
            </div>
        </div>
        <div>
            <a id="heroCallLink" href="tel:+919876543210" class="btn btn-outline-success rounded-pill px-3 py-1 fw-bold btn-sm">
                <i class="fa-solid fa-phone me-1"></i> Call <span id="heroPhoneText">+91 98765 43210</span>
            </a>
        </div>
    </div>

    <!-- Responsive Curve SVG Route -->
    <div class="curved-track-container">
        <svg viewBox="0 0 940 240" preserveAspectRatio="none" width="100%" height="100%">
            <path id="routeCurve" d="M 40,190 C 130,40 210,240 310,80 C 420,240 500,30 620,180 C 730,240 820,30 900,120" fill="none" stroke="#cbd5e1" stroke-width="12" stroke-linecap="round" stroke-dasharray="10,8" />
            <circle cx="40" cy="190" r="9" fill="#fe424d" />
            <circle cx="310" cy="80" r="9" fill="#f59e0b" />
            <circle cx="620" cy="180" r="9" fill="#3b82f6" />
            <circle cx="900" cy="120" r="9" fill="#10b981" />
        </svg>
        <i class="fa-solid fa-motorcycle" id="deliveryBikeElement"></i>
    </div>

    <!-- Stations Strip -->
    <div class="row text-center fw-bold g-2 mb-3" style="font-size: 0.75rem;">
        <div class="col-6 col-sm-3 text-danger text-truncate" id="stnKitchen"><i class="fa-solid fa-kitchen-set me-1"></i> 1. Kitchen</div>
        <div class="col-6 col-sm-3 text-warning text-truncate" id="stnTransit1"><i class="fa-solid fa-road me-1"></i> 2. Expressway</div>
        <div class="col-6 col-sm-3 text-primary text-truncate" id="stnTransit2"><i class="fa-solid fa-map-pin me-1"></i> 3. Local Sector</div>
        <div class="col-6 col-sm-3 text-success text-truncate" id="stnDoorstep"><i class="fa-solid fa-house-chimney me-1"></i> 4. Doorstep</div>
    </div>

    <div class="row mt-3 pt-3 border-top g-2">
        <div class="col-12 col-md-6">
            <h6 class="fw-bold mb-1 text-primary small"><i class="fa-solid fa-location-arrow me-1"></i> Delivering To:</h6>
            <p id="trackDestAddress" class="small mb-0 text-muted">No active delivery in progress.</p>
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <h6 class="fw-bold mb-1 text-success small"><i class="fa-solid fa-clock me-1"></i> Order Placed Time:</h6>
            <p id="trackOrderTime" class="small mb-0 text-muted">--:--:--</p>
        </div>
    </div>

    <!-- Past Order Receipts Table -->
    <div class="mt-4 pt-3 border-top">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left text-danger me-1"></i>Past Order Receipts & History</h6>
            <small class="text-muted" style="font-size: 0.72rem;">Click Order # for Details & Review</small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Location</th>
                        <th>Delivery Hero</th>
                        <th>Duration</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="pastOrdersTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Cancel Order Reason Modal -->
<div class="modal fade" id="cancelReasonModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 p-3 shadow-lg">
      <div class="modal-header border-bottom pb-2">
        <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> Cancel Order</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-2">Please select a valid reason for cancelling this order:</p>
        <div class="mb-3">
          <select id="cancellationReasonSelect" class="form-select rounded-pill">
            <option value="Ordered by mistake">I ordered by mistake</option>
            <option value="Delivery time is too long">Delivery time is too long</option>
            <option value="Change in address">I need to change my delivery address</option>
            <option value="Found a better price or dish elsewhere">Found a better offer or dish elsewhere</option>
            <option value="Other">Other reason</option>
          </select>
        </div>
        <div class="small text-muted mb-2">
          <i class="fa-solid fa-shield-halved text-success me-1"></i> Payments made via UPI or Debit/Credit Card will be refunded automatically to your source account within 1-2 business days.
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Keep Order</button>
        <button type="button" class="btn btn-danger rounded-pill px-3 fw-bold" onclick="confirmCancelWithReason()">Confirm Cancellation</button>
      </div>
    </div>
  </div>
</div>

<script>
    let currentAnimInterval = null;
    let selectedOrderIndex = 0;
    const currentUserId = "<%= currUser._id %>";
    const USER_HISTORY_KEY = "hungrymate_order_history_" + currentUserId;

    document.addEventListener("DOMContentLoaded", () => {
        syncAllOrdersLifecycle();
        setupActiveOrderTabs();
        renderHistoryTable();
    });

    function syncAllOrdersLifecycle() {
        let history = JSON.parse(localStorage.getItem(USER_HISTORY_KEY) || "[]");
        let updated = false;

        history.forEach(ord => {
            if (!ord.isDelivered && !ord.isCancelled) {
                const totalMs = (ord.totalDurationMins || 25) * 60 * 1000;
                const elapsed = Date.now() - (ord.timestampStart || Date.now());
                if (elapsed >= totalMs) {
                    ord.isDelivered = true;
                    updated = true;
                }
            }
        });

        if (updated) {
            localStorage.setItem(USER_HISTORY_KEY, JSON.stringify(history));
        }
    }

    function setupActiveOrderTabs() {
        let history = JSON.parse(localStorage.getItem(USER_HISTORY_KEY) || "[]");
        const tabStrip = document.getElementById("multiOrdersTabStrip");
        tabStrip.innerHTML = "";

        if (history.length === 0) {
            loadOrderToTrack(null);
            return;
        }

        history.forEach((ord, idx) => {
            const btn = document.createElement("button");
            const isDeliv = ord.isDelivered;
            const isCanc = ord.isCancelled;

            let badgeClass = "btn-outline-secondary";
            if (idx === selectedOrderIndex) badgeClass = "btn-danger";
            else if (isDeliv) badgeClass = "btn-outline-success";

            btn.className = `btn btn-sm rounded-pill fw-bold ${badgeClass}`;
            btn.style.fontSize = "0.75rem";
            btn.innerHTML = `<i class="fa-solid fa-motorcycle me-1"></i> #${ord.orderId} ${isDeliv ? '(Delivered)' : (isCanc ? '(Cancelled)' : '')}`;
            btn.onclick = () => {
                selectedOrderIndex = idx;
                setupActiveOrderTabs();
            };
            tabStrip.appendChild(btn);
        });

        loadOrderToTrack(history[selectedOrderIndex] || history[0]);
    }

    function loadOrderToTrack(order) {
        if (currentAnimInterval) clearInterval(currentAnimInterval);

        const bike = document.getElementById("deliveryBikeElement");
        const path = document.getElementById("routeCurve");
        const etaText = document.getElementById("etaCounter");
        const cancelBtn = document.getElementById("cancelOrderBtn");
        const compBanner = document.getElementById("deliveryCompletedBanner");
        const refundBanner = document.getElementById("refundNoticeBanner");

        if (order) {
            document.getElementById("trackOrderId").innerText = order.orderId;
            document.getElementById("trackDestAddress").innerText = order.address;
            document.getElementById("trackOrderTime").innerText = order.placedAt;

            const hero = order.deliveryHeroData || { name: "Rahul Verma", id: "HM-DEL-984", phone: "+91 98765 43210" };
            document.getElementById("heroNameText").innerText = hero.name + ` (${hero.id})`;
            document.getElementById("heroPhoneText").innerText = hero.phone;
            document.getElementById("heroCallLink").href = `tel:${hero.phone.replace(/\s+/g, '')}`;

            const city = (order.address || "").split(',')[0] || "Destination";
            const rest = order.restaurantName || "Kitchen";
            document.getElementById("stnKitchen").innerHTML = `<i class="fa-solid fa-kitchen-set me-1"></i> 1. ${rest}`;
            document.getElementById("stnTransit1").innerHTML = `<i class="fa-solid fa-road me-1"></i> 2. ${city} Exp`;
            document.getElementById("stnTransit2").innerHTML = `<i class="fa-solid fa-map-pin me-1"></i> 3. ${city} Sec`;
            document.getElementById("stnDoorstep").innerHTML = `<i class="fa-solid fa-house-chimney me-1"></i> 4. Doorstep`;

            const durationTotalMs = (order.totalDurationMins || 25) * 60 * 1000;
            const startTime = order.timestampStart || Date.now();
            const elapsed = Date.now() - startTime;
            const pathLength = path.getTotalLength();

            if (order.isCancelled) {
                etaText.innerText = "Cancelled";
                cancelBtn.classList.add("d-none");
                bike.style.display = "none";
                compBanner.classList.add("d-none");
                refundBanner.classList.remove("d-none");
                const isOnlinePay = (order.paymentMode || "").includes("UPI") || (order.paymentMode || "").includes("Card");
                document.getElementById("refundMessageText").innerText = isOnlinePay 
                    ? `Reason: ${order.cancelReason || 'Cancelled by user'}. A refund of ₹${order.totalPaid} has been initiated back to your ${order.paymentMode}.`
                    : `Reason: ${order.cancelReason || 'Cancelled by user'}. (Cash on Delivery - No charge deducted).`;
                return;
            } else {
                refundBanner.classList.add("d-none");
            }

            if (order.isDelivered || elapsed >= durationTotalMs) {
                const point = path.getPointAtLength(pathLength);
                bike.style.left = ((point.x / 940) * 100) + "%";
                bike.style.top = ((point.y / 240) * 100) + "%";
                bike.style.display = "block";
                etaText.innerText = "Delivered!";
                cancelBtn.classList.add("d-none");
                compBanner.classList.remove("d-none");
            } else {
                bike.style.display = "block";
                compBanner.classList.add("d-none");

                currentAnimInterval = setInterval(() => {
                    const currentElapsed = Date.now() - startTime;
                    const progress = Math.min(currentElapsed / durationTotalMs, 1);
                    
                    const point = path.getPointAtLength(progress * pathLength);
                    bike.style.left = ((point.x / 940) * 100) + "%";
                    bike.style.top = ((point.y / 240) * 100) + "%";

                    if (progress >= 0.80) {
                        cancelBtn.classList.add("d-none");
                    } else {
                        cancelBtn.classList.remove("d-none");
                    }

                    const remainingSecs = Math.max(Math.floor((durationTotalMs - currentElapsed) / 1000), 0);
                    const m = Math.floor(remainingSecs / 60);
                    const s = remainingSecs % 60;
                    etaText.innerText = `${m}:${s < 10 ? '0' : ''}${s} mins`;

                    if (progress >= 1) {
                        etaText.innerText = "Delivered!";
                        clearInterval(currentAnimInterval);

                        order.isDelivered = true;
                        updateLocalOrderRecord(order);

                        compBanner.classList.remove("d-none");
                        cancelBtn.classList.add("d-none");
                        setupActiveOrderTabs();
                        renderHistoryTable();
                        confetti({ particleCount: 160, spread: 85, origin: { y: 0.5 } });
                    }
                }, 500);
            }
        } else {
            document.getElementById("trackDestAddress").innerText = "No active orders found!";
            etaText.innerText = "Idle";
            bike.style.display = "none";
            cancelBtn.classList.add("d-none");
            compBanner.classList.add("d-none");
            refundBanner.classList.add("d-none");
        }
    }

    function openCancelReasonModal() {
        const modal = new bootstrap.Modal(document.getElementById('cancelReasonModal'));
        modal.show();
    }

    function confirmCancelWithReason() {
        let history = JSON.parse(localStorage.getItem(USER_HISTORY_KEY) || "[]");
        let currentOrder = history[selectedOrderIndex];
        if (!currentOrder) return;

        const reason = document.getElementById("cancellationReasonSelect").value;
        currentOrder.isCancelled = true;
        currentOrder.cancelReason = reason;

        updateLocalOrderRecord(currentOrder);

        const modalEl = document.getElementById('cancelReasonModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();

        const isOnlinePay = (currentOrder.paymentMode || "").includes("UPI") || (currentOrder.paymentMode || "").includes("Card");
        if (isOnlinePay) {
            alert(`Order #${currentOrder.orderId} cancelled.\nReason: ${reason}\n\nRefund of ₹${currentOrder.totalPaid} has been credited to your source account!`);
        } else {
            alert(`Order #${currentOrder.orderId} cancelled.\nReason: ${reason}`);
        }

        setupActiveOrderTabs();
        renderHistoryTable();
    }

    function updateLocalOrderRecord(updatedOrder) {
        let history = JSON.parse(localStorage.getItem(USER_HISTORY_KEY) || "[]");
        const idx = history.findIndex(o => o.orderId === updatedOrder.orderId);
        if (idx !== -1) {
            history[idx] = updatedOrder;
            localStorage.setItem(USER_HISTORY_KEY, JSON.stringify(history));
        }
    }

    function renderHistoryTable() {
        const history = JSON.parse(localStorage.getItem(USER_HISTORY_KEY) || "[]");
        const tbody = document.getElementById("pastOrdersTableBody");
        if (!tbody) return;
        tbody.innerHTML = "";

        if (history.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">No orders found in your account history!</td></tr>';
        } else {
            history.forEach((h, idx) => {
                const hero = h.deliveryHeroData || { name: "Rahul Verma", phone: "+91 98765 43210" };
                let statusBadge = '<span class="badge bg-warning text-dark">In-Transit</span>';
                if (h.isCancelled) statusBadge = '<span class="badge bg-danger">Cancelled</span>';
                else if (h.isDelivered) statusBadge = '<span class="badge bg-success">Delivered</span>';

                tbody.innerHTML += `
                    <tr>
                        <td>
                            <a href="/orders/${h.orderId}/detail" class="fw-bold text-danger text-decoration-none">
                                #${h.orderId} <i class="fa-solid fa-arrow-up-right-from-square small ms-1"></i>
                            </a>
                        </td>
                        <td class="text-truncate" style="max-width: 130px;">${h.address}</td>
                        <td>${hero.name} <br><small class="text-muted">${hero.phone}</small></td>
                        <td>${h.totalDurationMins || 25}m</td>
                        <td><strong class="text-danger">&#8377;${h.totalPaid}</strong></td>
                        <td>${statusBadge}</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2" title="Download Excel Format PDF" onclick="downloadSpecificOrderReceipt(${idx})">
                                    <i class="fa-solid fa-file-pdf"></i>
                                </button>
                                <a href="/orders/${h.orderId}/detail" class="btn btn-sm btn-outline-warning rounded-pill py-0 px-2 text-dark" title="Review & Feedback">
                                    <i class="fa-solid fa-star"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                `;
            });
        }
    }

    function downloadSpecificOrderReceipt(index) {
        const history = JSON.parse(localStorage.getItem(USER_HISTORY_KEY) || "[]");
        const targetOrder = history[index];
        if(!targetOrder) return;

        if(!targetOrder.isDelivered && !targetOrder.isCancelled) {
            alert(`Order #${targetOrder.orderId} is currently under transit! Full tax invoice receipt unlocks after delivery or cancellation.`);
            return;
        }

        generateExcelPdf(targetOrder);
    }

    function downloadCurrentReceiptPdf() {
        let history = JSON.parse(localStorage.getItem(USER_HISTORY_KEY) || "[]");
        let target = history[selectedOrderIndex] || history[0];
        if (!target) return alert("No order record found!");
        generateExcelPdf(target);
    }

    function generateExcelPdf(order) {
        const hero = order.deliveryHeroData || { name: "Rahul Verma", id: "HM-DEL-984", phone: "+91 98765 43210" };
        const container = document.createElement("div");
        container.style.width = "720px";
        container.style.padding = "20px";
        container.style.background = "#ffffff";
        container.style.color = "#000000";
        container.style.fontFamily = "'Plus Jakarta Sans', Arial, sans-serif";
        container.style.boxSizing = "border-box";

        let itemsHtml = "";
        (order.items || []).forEach((it, i) => {
            itemsHtml += `
                <tr>
                    <td style="border: 1px solid #000; padding: 6px; text-align: center;">${i + 1}</td>
                    <td style="border: 1px solid #000; padding: 6px;"><strong>${it.title}</strong> (${it.restaurant || 'Kitchen'})</td>
                    <td style="border: 1px solid #000; padding: 6px; text-align: center;">${it.quantity}</td>
                    <td style="border: 1px solid #000; padding: 6px; text-align: right;">₹${it.price.toFixed(2)}</td>
                    <td style="border: 1px solid #000; padding: 6px; text-align: right;">₹${(it.price * it.quantity).toFixed(2)}</td>
                </tr>
            `;
        });

        const isCancelled = order.isCancelled === true;
        const statusBanner = isCancelled 
            ? `<div style="background-color: #fee2e2; border: 2px dashed #dc2626; color: #dc2626; padding: 8px; text-align: center; font-weight: 900; margin-bottom: 12px; font-size: 1rem;">
                ⚠️ ORDER STATUS: CANCELLED (VOID INVOICE - REASON: ${order.cancelReason || 'Cancelled'})
               </div>`
            : `<div style="background-color: #dcfce7; border: 1.5px solid #16a34a; color: #16a34a; padding: 6px; text-align: center; font-weight: 800; margin-bottom: 12px; font-size: 0.9rem;">
                ✓ ORDER STATUS: COMPLETED & DELIVERED
               </div>`;

        container.innerHTML = `
            <div style="text-align: center; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 10px;">
                <h2 style="font-weight: 900; margin: 0; font-size: 1.4rem;">HUNGRYMATE FOOD LOGISTICS PVT LTD</h2>
                <small style="font-size: 0.8rem; color: #475569;">Official Tax Invoice & Cash Memo Receipt</small>
            </div>

            ${statusBanner}

            <table style="width: 100%; border-collapse: collapse; border: 2px solid #000; margin-bottom: 12px; font-size: 0.82rem;">
                <tr>
                    <td style="border: 1px solid #000; padding: 6px; font-weight: 800; background-color: #f1f5f9; width: 22%;">ORDER ID:</td>
                    <td style="border: 1px solid #000; padding: 6px; width: 28%;">#${order.orderId}</td>
                    <td style="border: 1px solid #000; padding: 6px; font-weight: 800; background-color: #f1f5f9; width: 22%;">ORDER DATE:</td>
                    <td style="border: 1px solid #000; padding: 6px; width: 28%;">${order.placedAt}</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #000; padding: 6px; font-weight: 800; background-color: #f1f5f9;">CUSTOMER:</td>
                    <td style="border: 1px solid #000; padding: 6px;">${order.customerName || 'Customer'} (${order.customerPhone || 'N/A'})</td>
                    <td style="border: 1px solid #000; padding: 6px; font-weight: 800; background-color: #f1f5f9;">DELIVERY HERO:</td>
                    <td style="border: 1px solid #000; padding: 6px;">${hero.name} (${hero.id}) - ${hero.phone}</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #000; padding: 6px; font-weight: 800; background-color: #f1f5f9;">ADDRESS:</td>
                    <td colspan="3" style="border: 1px solid #000; padding: 6px;">${order.address}</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #000; padding: 6px; font-weight: 800; background-color: #f1f5f9;">PAYMENT METHOD:</td>
                    <td style="border: 1px solid #000; padding: 6px;">${order.paymentMode || 'Cash on Delivery'}</td>
                    <td style="border: 1px solid #000; padding: 6px; font-weight: 800; background-color: #f1f5f9;">COUPON APPLIED:</td>
                    <td style="border: 1px solid #000; padding: 6px; color: #16a34a; font-weight: 700;">${order.couponApplied || 'NONE'}</td>
                </tr>
            </table>

            <table style="width: 100%; border-collapse: collapse; border: 2px solid #000; margin-bottom: 12px; font-size: 0.82rem;">
                <thead>
                    <tr style="background-color: #e2e8f0;">
                        <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 8%;">SL</th>
                        <th style="border: 1px solid #000; padding: 6px; width: 50%;">ITEM DESCRIPTION</th>
                        <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 12%;">QTY</th>
                        <th style="border: 1px solid #000; padding: 6px; text-align: right; width: 15%;">RATE (INR)</th>
                        <th style="border: 1px solid #000; padding: 6px; text-align: right; width: 15%;">AMOUNT (INR)</th>
                    </tr>
                </thead>
                <tbody>${itemsHtml}</tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" style="border: 1px solid #000; padding: 6px; text-align: right; font-weight: 800;">SUBTOTAL:</td>
                        <td style="border: 1px solid #000; padding: 6px; text-align: right; font-weight: 800;">₹${order.subtotal || order.totalPaid}</td>
                    </tr>
                    <tr>
                        <td colspan="4" style="border: 1px solid #000; padding: 6px; text-align: right; font-weight: 800;">DISCOUNT:</td>
                        <td style="border: 1px solid #000; padding: 6px; text-align: right; font-weight: 800; color: #16a34a;">-₹${order.discount || 0}</td>
                    </tr>
                    <tr>
                        <td colspan="4" style="border: 1px solid #000; padding: 6px; text-align: right; font-weight: 800;">PLATFORM FEE:</td>
                        <td style="border: 1px solid #000; padding: 6px; text-align: right; font-weight: 800;">₹9.00</td>
                    </tr>
                    <tr style="background-color: #f8fafc;">
                        <td colspan="4" style="border: 1px solid #000; padding: 6px; text-align: right; font-weight: 900; font-size: 1rem;">TOTAL PAID:</td>
                        <td style="border: 1px solid #000; padding: 6px; text-align: right; font-weight: 900; font-size: 1rem; color: ${isCancelled ? '#64748b; text-decoration: line-through;' : '#fe424d;'}">₹${order.totalPaid}</td>
                    </tr>
                </tfoot>
            </table>
        `;

        document.body.appendChild(container);

        const opt = {
            margin: [10, 10, 10, 10],
            filename: `Hungrymate_Invoice_${order.orderId}${isCancelled ? '_CANCELLED' : ''}.pdf`,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, scrollX: 0, scrollY: 0 },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        html2pdf().set(opt).from(container).save().then(() => {
            document.body.removeChild(container);
        });
    }
</script>
<% } %>