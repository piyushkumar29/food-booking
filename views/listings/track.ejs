<% layout("/layouts/boilerplate") %>

<!-- Confetti & HTML2PDF CDN -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
    .track-card-box {
        background: #ffffff; border-radius: 24px; padding: 2.2rem;
        border: 1.5px solid #e2e8f0; box-shadow: 0 16px 36px rgba(15,23,42,0.08);
        max-width: 920px; margin: 2rem auto 4rem auto;
    }
    .delivery-partner-badge {
        background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 16px;
        padding: 1rem 1.4rem; display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;
    }
    .curved-track-container {
        position: relative; width: 100%; height: 200px; margin: 2rem 0;
    }
    #deliveryBikeElement {
        position: absolute; font-size: 2.4rem; color: #f59e0b;
        filter: drop-shadow(0 4px 12px rgba(0,0,0,0.35));
        transform: translate(-50%, -50%); transition: transform 0.05s linear;
    }
    body.dark-mode .track-card-box {
        background: #0f172a !important; border-color: #1e293b !important; color: #f8fafc !important;
    }
    body.dark-mode .delivery-partner-badge {
        background: #1e293b !important; border-color: #334155 !important; color: #ffffff !important;
    }

    /* Celebration Completed Banner */
    #deliveryCompletedBanner {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff; border-radius: 18px; padding: 1.5rem; text-align: center; margin-bottom: 2rem;
    }

    /* Hidden Printable Invoice Template */
    #invoicePrintSection {
        background: #ffffff; color: #000000; padding: 2.5rem; border-radius: 12px; font-family: 'Plus Jakarta Sans', sans-serif;
    }
</style>

<div class="track-card-box">
    
    <!-- Congratulations Celebration Notification -->
    <div id="deliveryCompletedBanner" class="d-none shadow-lg">
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-circle-check me-2"></i>Hurray! Food Delivered Successfully</h3>
        <p class="mb-2">Your delicious order was handed over at your doorstep on time. Enjoy your hot meal!</p>
        <button class="btn btn-light rounded-pill px-4 fw-bold text-success shadow-sm" onclick="downloadOrderInvoice()">
            <i class="fa-solid fa-file-invoice-dollar me-2"></i>Download Official Bill Invoice (PDF)
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <h4 class="fw-bold mb-0" style="color: #fe424d;"><i class="fa-solid fa-motorcycle me-2"></i>Live Order Delivery Tracking</h4>
            <span class="small text-muted">Order ID: <strong id="trackOrderId">HM-LOADING</strong></span>
        </div>
        <div class="text-end">
            <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill">
                Remaining Time: <strong id="etaCounter">2:00 mins</strong>
            </span>
        </div>
    </div>

    <!-- Delivery Hero Details -->
    <div class="delivery-partner-badge">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-helmet-safety"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0">Rahul Verma</h6>
                <small class="text-muted"><i class="fa-solid fa-star text-warning"></i> 4.9 Rating &bull; Vaccinated Delivery Partner</small>
            </div>
        </div>
        <div>
            <a href="tel:+919876543210" class="btn btn-outline-success rounded-pill px-3 fw-bold btn-sm">
                <i class="fa-solid fa-phone me-1"></i> Call +91 98765 43210
            </a>
        </div>
    </div>

    <!-- Realistic Ultra-Curved Map Route Track -->
    <div class="curved-track-container">
        <svg viewBox="0 0 900 180" width="100%" height="100%">
            <!-- Double S-Curved Realistic Route Road -->
            <path id="routeCurve" d="M 30,140 C 200,20 280,170 450,40 C 620,160 740,20 870,110" fill="none" stroke="#cbd5e1" stroke-width="9" stroke-linecap="round" stroke-dasharray="10,8" />
        </svg>
        <i class="fa-solid fa-motorcycle" id="deliveryBikeElement"></i>
    </div>

    <div class="d-flex justify-content-between px-3 text-muted fw-bold small">
        <span class="text-danger"><i class="fa-solid fa-utensils me-1"></i> Haji Biryani Kitchen</span>
        <span class="text-warning"><i class="fa-solid fa-road me-1"></i> Kalyani S-Road Expressway</span>
        <span class="text-success"><i class="fa-solid fa-house-chimney me-1"></i> Customer Doorstep</span>
    </div>

    <div class="row mt-4 pt-3 border-top g-3">
        <div class="col-md-6">
            <h6 class="fw-bold mb-1 text-primary"><i class="fa-solid fa-location-arrow me-1"></i> Delivering To:</h6>
            <p id="trackDestAddress" class="small text-muted mb-0">Opposite JIS College, Kalyani</p>
        </div>
        <div class="col-md-6 text-md-end">
            <h6 class="fw-bold mb-1 text-success"><i class="fa-solid fa-clock me-1"></i> Order Placed Time:</h6>
            <p id="trackOrderTime" class="small text-muted mb-0">--:--:--</p>
        </div>
    </div>

    <!-- User Account Order History -->
    <div class="mt-5 pt-4 border-top">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left text-danger me-2"></i>Your Past Delivery History</h5>
            <button class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold" onclick="downloadOrderInvoice()">
                <i class="fa-solid fa-receipt me-1"></i> Download Latest Bill
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Delivered Location</th>
                        <th>Items Count</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="pastOrdersTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Hidden PDF Invoice Layout -->
<div id="invoiceContainer" style="display: none;">
    <div id="invoicePrintSection">
        <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
            <div>
                <h2 style="color: #fe424d; font-weight: 800; margin: 0;">HUNGRYMATE</h2>
                <small>Official Food Delivery Tax Invoice</small>
            </div>
            <div class="text-end">
                <h5 id="invOrderId" class="fw-bold mb-0">HM-998877</h5>
                <small id="invOrderDate">Date: 2026</small>
            </div>
        </div>
        <div class="row my-3">
            <div class="col-6">
                <strong>Delivered To:</strong>
                <p id="invCustomerInfo" class="small text-muted mb-0"></p>
                <p id="invCustomerAddress" class="small text-muted mb-0"></p>
            </div>
            <div class="col-6 text-end">
                <strong>Delivery Partner:</strong>
                <p class="small text-muted mb-0">Rahul Verma (+91 98765 43210)</p>
                <p class="small text-muted mb-0">Kalyani Hub West Bengal</p>
            </div>
        </div>
        <table class="table table-bordered my-3">
            <thead>
                <tr class="table-light"><th>Item Description</th><th>Qty</th><th class="text-end">Price</th></tr>
            </thead>
            <tbody id="invItemsBody"></tbody>
        </table>
        <div class="text-end">
            <p class="mb-1">Platform Fee: &#8377;9</p>
            <p class="mb-1 text-success">Delivery & Handling: FREE (&#8377;0)</p>
            <h4 class="fw-bold mt-2">Total Paid: &#8377;<span id="invTotalPaid">0</span></h4>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const order = JSON.parse(localStorage.getItem("hungrymate_active_order") || "null");
        const bike = document.getElementById("deliveryBikeElement");
        const path = document.getElementById("routeCurve");
        const etaText = document.getElementById("etaCounter");

        if (order) {
            document.getElementById("trackOrderId").innerText = order.orderId;
            document.getElementById("trackDestAddress").innerText = order.address;
            document.getElementById("trackOrderTime").innerText = order.placedAt;

            // 2 Minutes (120 Seconds) Real Duration Animation
            const TOTAL_DURATION_MS = 120 * 1000;
            const startTime = Date.now();
            const pathLength = path.getTotalLength();

            const animInterval = setInterval(() => {
                const elapsed = Date.now() - startTime;
                const progress = Math.min(elapsed / TOTAL_DURATION_MS, 1);
                
                const point = path.getPointAtLength(progress * pathLength);
                
                const xPercent = (point.x / 900) * 100;
                const yPercent = (point.y / 180) * 100;
                
                bike.style.left = xPercent + "%";
                bike.style.top = yPercent + "%";

                const remainingSecs = Math.max(120 - Math.floor(elapsed / 1000), 0);
                const m = Math.floor(remainingSecs / 60);
                const s = remainingSecs % 60;
                etaText.innerText = `${m}:${s < 10 ? '0' : ''}${s} mins`;

                if (progress >= 1) {
                    etaText.innerText = "Order Delivered!";
                    clearInterval(animInterval);

                    // Trigger Hurray Celebration Banner & Confetti
                    document.getElementById("deliveryCompletedBanner").classList.remove("d-none");
                    confetti({ particleCount: 150, spread: 80, origin: { y: 0.5 } });
                }
            }, 50);
        } else {
            document.getElementById("trackDestAddress").innerText = "No active order placed yet!";
        }

        // Render Past History
        const history = JSON.parse(localStorage.getItem("hungrymate_order_history") || "[]");
        const tbody = document.getElementById("pastOrdersTableBody");
        tbody.innerHTML = "";

        if (history.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No completed orders found in this account!</td></tr>';
        } else {
            history.forEach(h => {
                tbody.innerHTML += `
                    <tr>
                        <td><strong>${h.orderId}</strong></td>
                        <td class="text-truncate" style="max-width: 200px;">${h.address}</td>
                        <td>${h.items ? h.items.length : 1} dishes</td>
                        <td><strong class="text-danger">&#8377;${h.totalPaid}</strong></td>
                        <td><span class="badge bg-success">Delivered in ${h.deliveredInMinutes || 2}m</span></td>
                    </tr>
                `;
            });
        }
    });

    function downloadOrderInvoice() {
        const order = JSON.parse(localStorage.getItem("hungrymate_active_order") || "null");
        if (!order) return alert("No order found to generate invoice!");

        document.getElementById("invOrderId").innerText = order.orderId;
        document.getElementById("invOrderDate").innerText = "Placed: " + order.placedAt;
        document.getElementById("invCustomerInfo").innerText = `${order.customerName || 'Customer'} (${order.customerPhone || ''})`;
        document.getElementById("invCustomerAddress").innerText = order.address;
        document.getElementById("invTotalPaid").innerText = order.totalPaid;

        const tbody = document.getElementById("invItemsBody");
        tbody.innerHTML = "";
        order.items.forEach(it => {
            tbody.innerHTML += `
                <tr>
                    <td>${it.title}</td>
                    <td>${it.quantity}</td>
                    <td class="text-end">&#8377;${it.price * it.quantity}</td>
                </tr>
            `;
        });

        const element = document.getElementById("invoicePrintSection");
        document.getElementById("invoiceContainer").style.display = "block";

        const opt = {
            margin: 0.5,
            filename: `${order.orderId}_Hungrymate_Invoice.pdf`,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2 },
            jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
        };

        html2pdf().set(opt).from(element).save().then(() => {
            document.getElementById("invoiceContainer").style.display = "none";
        });
    }
</script>