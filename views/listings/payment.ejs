<% layout("/layouts/boilerplate") %>

<style>
    .payment-main-card {
        background: #111827 !important;
        border: 1.5px solid #1f2937 !important;
        border-radius: 24px !important;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.45) !important;
    }

    .customer-info-strip {
        background: #1e293b !important;
        border: 1px solid #334155 !important;
        border-radius: 16px !important;
        padding: 1rem 1.25rem !important;
    }

    .payment-acc-item {
        background: #1e293b !important;
        border: 1.5px solid #334155 !important;
        border-radius: 16px !important;
        overflow: hidden !important;
        margin-bottom: 0.9rem !important;
    }

    .payment-acc-btn {
        background-color: #1e293b !important;
        color: #f8fafc !important;
        font-weight: 700 !important;
        padding: 1.1rem 1.25rem !important;
        border: none !important;
        font-size: 0.95rem !important;
        display: flex !important;
        align-items: center !important;
        width: 100% !important;
    }

    .payment-acc-btn:not(.collapsed) {
        background-color: #24334d !important;
        color: #facc15 !important;
        box-shadow: none !important;
    }

    .payment-acc-btn::after {
        filter: invert(1) brightness(1.8) !important;
        margin-left: auto !important;
        transition: transform 0.25s ease !important;
    }

    .payment-acc-btn:not(.collapsed)::after {
        filter: invert(75%) sepia(85%) saturate(800%) hue-rotate(5deg) !important;
    }

    .payment-acc-body {
        background-color: #111827 !important;
        color: #f8fafc !important;
        border-top: 1px solid #334155 !important;
        padding: 1.25rem !important;
    }

    .qr-box-wrap {
        background: #ffffff;
        padding: 14px;
        display: inline-block;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.35);
        border: 3px solid #facc15;
    }

    .btn-cod-yellow {
        background-color: #facc15 !important;
        border-color: #facc15 !important;
        color: #000000 !important;
        font-weight: 800 !important;
        font-size: 0.95rem !important;
        letter-spacing: 0.3px !important;
        transition: all 0.2s ease !important;
    }
    .btn-cod-yellow:hover {
        background-color: #eab308 !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(250, 204, 21, 0.35) !important;
    }
</style>

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card payment-main-card p-3 p-md-4 text-white">
            
            <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-3 mb-3">
                <div>
                    <span class="badge bg-danger rounded-pill px-3 py-1 mb-1">Step 2 of 2: Payment</span>
                    <h4 class="fw-bold mb-0 text-white"><i class="fa-solid fa-credit-card me-2 text-warning"></i>Choose Payment Method</h4>
                </div>
                <div class="text-end">
                    <small class="text-white-50 d-block fw-semibold">Amount to Pay</small>
                    <span class="fs-4 fw-bold text-warning" id="payAmountDisplay">&#8377;--</span>
                </div>
            </div>

            <!-- Customer Details Banner -->
            <div class="customer-info-strip mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-user text-warning fs-5"></i>
                        <strong id="summaryCustomerName" class="text-white fs-6">Customer</strong>
                    </div>
                    <span id="summaryCustomerPhone" class="small fw-bold text-warning">--</span>
                </div>
                <small id="summaryCustomerAddress" class="text-white-50 d-block mt-1">--</small>
            </div>

            <!-- Payment Options Accordion -->
            <div class="accordion" id="paymentOptionsAccordion">
                
                <!-- 1. DYNAMIC QR CODE -->
                <div class="accordion-item payment-acc-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button payment-acc-btn shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseQR">
                            <i class="fa-solid fa-qrcode fs-5 text-warning me-2"></i> Instant UPI QR Code (Scan with Any UPI App)
                        </button>
                    </h2>
                    <div id="collapseQR" class="accordion-collapse collapse show" data-bs-parent="#paymentOptionsAccordion">
                        <div class="accordion-body payment-acc-body text-center">
                            <p class="small text-white-50 mb-2">Scan & pay using PhonePe, Google Pay, Paytm, or BHIM</p>
                            
                            <!-- Pure High-Res Responsive QR Container -->
                            <div class="qr-box-wrap mb-2">
                                <img id="dynamicQrImage" src="" alt="Live Payment QR Code" style="width: 200px; height: 200px; display: block; margin: 0 auto; object-fit: contain;">
                            </div>
                            
                            <div class="small fw-semibold text-white mt-1">
                                Merchant UPI ID: <code class="text-warning fw-bold">hungrymate.pay@upi</code>
                            </div>
                            
                            <button class="btn btn-warning rounded-pill px-4 mt-3 fw-bold text-dark shadow" onclick="finalizePayment('UPI QR Code')">
                                <i class="fa-solid fa-check me-1"></i> I Have Completed QR Payment
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. ENTER UPI ID -->
                <div class="accordion-item payment-acc-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed payment-acc-btn shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUPI">
                            <i class="fa-brands fa-google-pay fs-5 text-warning me-2"></i> Enter UPI ID / VPA
                        </button>
                    </h2>
                    <div id="collapseUPI" class="accordion-collapse collapse" data-bs-parent="#paymentOptionsAccordion">
                        <div class="accordion-body payment-acc-body">
                            <label class="form-label small fw-semibold text-white">Virtual Payment Address (VPA)</label>
                            <div class="input-group mb-2">
                                <input type="text" id="upiIdInput" class="form-control rounded-start-pill px-3 shadow-none bg-dark text-white border-secondary" placeholder="e.g. mobile@okhdfcbank or user@paytm">
                                <button class="btn btn-outline-warning rounded-end-pill px-3 fw-bold" type="button" onclick="verifyUpiId()">Verify ID</button>
                            </div>
                            <div id="upiVerifiedBadge" class="small text-success fw-bold d-none mb-3">
                                <i class="fa-solid fa-circle-check me-1"></i> Verified User: <span id="upiHolderName" class="text-white">--</span>
                            </div>
                            <button class="btn btn-warning text-dark rounded-pill px-4 fw-bold shadow-sm" onclick="finalizePayment('UPI App (Verified)')">
                                Confirm & Pay via UPI
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 3. CREDIT & DEBIT CARD -->
                <div class="accordion-item payment-acc-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed payment-acc-btn shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCard">
                            <i class="fa-regular fa-credit-card fs-5 text-warning me-2"></i> Credit / Debit Card
                        </button>
                    </h2>
                    <div id="collapseCard" class="accordion-collapse collapse" data-bs-parent="#paymentOptionsAccordion">
                        <div class="accordion-body payment-acc-body">
                            <div class="row g-2 mb-2">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold text-white">Card Number</label>
                                    <input type="text" id="cardNumberInput" class="form-control rounded-pill px-3 bg-dark text-white border-secondary" placeholder="XXXX XXXX XXXX XXXX" maxlength="19" oninput="detectCardBrand(this.value)">
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold text-white">Cardholder Name</label>
                                    <input type="text" id="cardHolderInput" class="form-control rounded-pill px-3 bg-dark text-white border-secondary" placeholder="Name printed on card" oninput="reflectCardName(this.value)">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold text-white">Expiry Date</label>
                                    <input type="text" class="form-control rounded-pill px-3 bg-dark text-white border-secondary" placeholder="MM/YY" maxlength="5">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold text-white">CVV</label>
                                    <input type="password" class="form-control rounded-pill px-3 bg-dark text-white border-secondary" placeholder="3 digits" maxlength="4">
                                </div>
                            </div>
                            <div id="cardVerifiedBadge" class="small text-success fw-bold d-none mb-3">
                                <i class="fa-solid fa-circle-check me-1"></i> Cardholder Verified: <span id="verifiedCardHolder">--</span>
                            </div>
                            <button class="btn btn-warning text-dark rounded-pill px-4 fw-bold shadow-sm" onclick="finalizePayment('Credit/Debit Card')">
                                Confirm & Pay with Card
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 4. CASH ON DELIVERY (COD) -->
                <div class="accordion-item payment-acc-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed payment-acc-btn shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCOD">
                            <i class="fa-solid fa-money-bill-wave fs-5 text-warning me-2"></i> Cash on Delivery (COD)
                        </button>
                    </h2>
                    <div id="collapseCOD" class="accordion-collapse collapse" data-bs-parent="#paymentOptionsAccordion">
                        <div class="accordion-body payment-acc-body">
                            <p class="small text-white-50 mb-3">Pay cash or scan QR using UPI directly to delivery partner at your doorstep.</p>
                            <button class="btn btn-cod-yellow rounded-pill px-4 py-2 shadow" onclick="finalizePayment('Cash on Delivery')">
                                <i class="fa-solid fa-check me-1"></i> <span id="codButtonLabel">Pay Amount (&#8377;--)</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<script>
    (function() {
        const currentSessionUserId = "<%= currUser ? currUser._id : 'guest' %>";
        const defaultLoggedInUserName = "<%= currUser ? currUser.username : '' %>";
        let checkoutData = null;
        let finalPayAmount = 0;

        const heroPool = [
            { name: "Rahul Verma", id: "HM-DEL-984", phone: "+91 98765 43210" },
            { name: "Amitabh Sen", id: "HM-DEL-412", phone: "+91 98301 22415" },
            { name: "Subhash Mondal", id: "HM-DEL-773", phone: "+91 89104 55621" },
            { name: "Rohan Mukherjee", id: "HM-DEL-291", phone: "+91 94331 88902" },
            { name: "Vikram Das", id: "HM-DEL-658", phone: "+91 97482 11340" }
        ];

        function initPaymentView() {
            // Step 1: Read URL Search Parameters (Highest Reliability)
            const urlParams = new URLSearchParams(window.location.search);
            const paramAmount = urlParams.get("amount");
            const paramName = urlParams.get("name");
            const paramPhone = urlParams.get("phone");
            const paramAddress = urlParams.get("address");

            // Step 2: Read Draft from Storage
            const rawDraft = localStorage.getItem("hungrymate_checkout_draft") ||
                             localStorage.getItem("hungrymate_checkout_draft_" + currentSessionUserId);

            if (rawDraft) {
                try { checkoutData = JSON.parse(rawDraft); } catch(e) { checkoutData = null; }
            }

            // Calculate Exact Final Amount
            if (paramAmount && !isNaN(parseFloat(paramAmount))) {
                finalPayAmount = parseFloat(paramAmount);
            } else if (checkoutData && typeof checkoutData.finalTotal === "number" && !isNaN(checkoutData.finalTotal)) {
                finalPayAmount = checkoutData.finalTotal;
            } else if (checkoutData && checkoutData.subtotal) {
                finalPayAmount = checkoutData.subtotal;
            } else {
                finalPayAmount = 139;
            }

            // Customer Info Binding
            const custName = paramName || (checkoutData && checkoutData.name) || defaultLoggedInUserName || "Customer";
            const custPhone = paramPhone || (checkoutData && checkoutData.phone) || "+91 Contact Verified";
            const custAddress = paramAddress || (checkoutData && checkoutData.address) || "Delivery Address Set";

            // Render on DOM
            document.getElementById("payAmountDisplay").innerHTML = "&#8377;" + finalPayAmount;
            document.getElementById("summaryCustomerName").innerText = custName;
            document.getElementById("summaryCustomerPhone").innerText = custPhone;
            document.getElementById("summaryCustomerAddress").innerText = custAddress;

            const codBtnLabel = document.getElementById("codButtonLabel");
            if (codBtnLabel) {
                codBtnLabel.innerText = "Pay Amount (₹" + finalPayAmount + ")";
            }

            // Generate Instant Dynamic QR Image (Zero External JS Library Error)
            const randomTxnSuffix = Date.now().toString().slice(-6) + Math.floor(100 + Math.random() * 900);
            const upiUri = `upi://pay?pa=hungrymate.pay@upi&pn=HungrymateFood&am=${finalPayAmount}&tr=HM${randomTxnSuffix}&tn=Order_${randomTxnSuffix}&cu=INR`;
            
            const qrImageEl = document.getElementById("dynamicQrImage");
            if (qrImageEl) {
                const encodedUri = encodeURIComponent(upiUri);
                // Guaranteed instant dynamic SVG QR code
                qrImageEl.src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&margin=4&data=${encodedUri}&t=${Date.now()}`;
                qrImageEl.onerror = function() {
                    this.onerror = null;
                    this.src = `https://quickchart.io/qr?text=${encodedUri}&size=200`;
                };
            }
        }

        // Initialize immediately to prevent any empty flash
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPaymentView);
        } else {
            initPaymentView();
        }

        window.verifyUpiId = function() {
            const val = document.getElementById("upiIdInput").value.trim();
            if (!val || !val.includes("@")) {
                return alert("Please enter a valid UPI address (e.g. mobile@upi)!");
            }
            const namePart = val.split("@")[0].replace(/[^a-zA-Z]/g, " ").trim();
            const holderName = namePart ? namePart.toUpperCase() : "VERIFIED USER";

            document.getElementById("upiHolderName").innerText = holderName;
            document.getElementById("upiVerifiedBadge").classList.remove("d-none");
        };

        window.reflectCardName = function(val) {
            if (val.trim().length > 2) {
                document.getElementById("verifiedCardHolder").innerText = val.trim().toUpperCase();
                document.getElementById("cardVerifiedBadge").classList.remove("d-none");
            }
        };

        window.detectCardBrand = function(val) {
            const formatted = val.replace(/\D/g, "").replace(/(.{4})/g, "$1 ").trim();
            document.getElementById("cardNumberInput").value = formatted;
        };

        window.finalizePayment = function(paymentMode) {
            const currentCart = (checkoutData && checkoutData.cart && checkoutData.cart.length > 0)
                ? checkoutData.cart
                : JSON.parse(localStorage.getItem("hungrymate_cart_" + currentSessionUserId) || localStorage.getItem("hungrymate_cart") || "[]");

            const randomDurationMins = Math.floor(Math.random() * (30 - 15 + 1)) + 15;
            const orderId = "HM-" + Math.floor(10000 + Math.random() * 90000);
            const randomHero = heroPool[Math.floor(Math.random() * heroPool.length)];

            const now = new Date();
            const placedAtStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ", " + now.toLocaleDateString("en-IN", { day: 'numeric', month: 'short' });

            const custName = document.getElementById("summaryCustomerName").innerText || "Customer";
            const custPhone = document.getElementById("summaryCustomerPhone").innerText || "+91 98765 43210";
            const custAddress = document.getElementById("summaryCustomerAddress").innerText || "Kolkata, West Bengal";

            const finalizedOrder = {
                orderId: orderId,
                userId: currentSessionUserId,
                customerName: custName,
                customerPhone: custPhone,
                address: custAddress,
                items: currentCart,
                subtotal: (checkoutData && checkoutData.subtotal) ? checkoutData.subtotal : finalPayAmount,
                discount: (checkoutData && checkoutData.discount) ? checkoutData.discount : 0,
                couponApplied: (checkoutData && checkoutData.couponApplied) ? checkoutData.couponApplied : "NONE",
                totalPaid: finalPayAmount,
                paymentMode: paymentMode,
                totalDurationMins: randomDurationMins,
                timestampStart: Date.now(),
                placedAt: placedAtStr,
                deliveryHeroData: randomHero,
                restaurantName: (currentCart.length > 0 && currentCart[0].restaurant) ? currentCart[0].restaurant : "Hungrymate Kitchen",
                firstFoodItemId: (currentCart.length > 0 && currentCart[0].id) ? currentCart[0].id : "",
                isDelivered: false,
                isCancelled: false
            };

            const USER_HISTORY_KEY = "hungrymate_order_history_" + currentSessionUserId;
            let history = JSON.parse(localStorage.getItem(USER_HISTORY_KEY) || "[]");
            history.unshift(finalizedOrder);
            localStorage.setItem(USER_HISTORY_KEY, JSON.stringify(history));

            // Clear temporary cart & drafts
            localStorage.removeItem("hungrymate_cart_" + currentSessionUserId);
            localStorage.removeItem("hungrymate_cart");
            localStorage.removeItem("hungrymate_checkout_draft");
            localStorage.removeItem("hungrymate_checkout_draft_" + currentSessionUserId);
            if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();

            alert(`Order #${orderId} Placed Successfully via ${paymentMode}!`);
            window.location.href = "/orders/track";
        };
    })();
</script>