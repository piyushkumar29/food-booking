<% layout("/layouts/boilerplate") %>

<% 
    const OWNER_EMAIL = "piyushkumarg292007@gmail.com";
    const OWNER_USERNAMES = ["piyush", "piyush kumar", "piyushkumar"];
    const isPiyushOwner = currUser && (
        currUser.isOwner === true || 
        (currUser.email && currUser.email.toLowerCase().trim() === OWNER_EMAIL) ||
        (currUser.username && OWNER_USERNAMES.includes(currUser.username.toLowerCase().trim()))
    );

    let avgRating = 4.8;
    if(listing.reviews && listing.reviews.length > 0) {
        let sum = listing.reviews.reduce((acc, r) => acc + r.rating, 0);
        avgRating = (sum / listing.reviews.length).toFixed(1);
    }

    let isVegFood = (listing.isVeg === true || String(listing.isVeg) === 'true');
    let currentPrice = listing.price || 199;
    let originalCutPrice = Math.round(currentPrice * 2.5);
%>

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-10 col-lg-8">
        
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white mb-4">
            
            <!-- Food Image Banner with Badges -->
            <div class="position-relative w-100" style="height: clamp(240px, 35vw, 420px); background: #0f172a;">
                <span class="offer-tag-badge">FLAT 60% OFF</span>
                <span class="rating-top-badge"><i class="fa-solid fa-star me-1"></i><%= avgRating %></span>

                <img src="<%= listing.image.url %>" class="w-100 h-100 object-fit-cover" alt="<%= listing.title %>">
            </div>

            <!-- Content Details -->
            <div class="card-body p-3 p-md-4">
                
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div>
                        <h3 class="fw-bold mb-1 text-dark"><%= listing.title %></h3>
                        <p class="text-danger fw-semibold mb-0" style="font-size: 0.95rem;">
                            <i class="fa-solid fa-store me-1"></i><%= listing.restaurant || 'Hungrymate Kitchen Hub' %>
                        </p>
                        <small class="text-muted"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %></small>
                    </div>

                    <!-- FSSAI Veg / Non-Veg Badge -->
                    <div class="food-diet-symbol <%= isVegFood ? 'veg-badge' : 'nonveg-badge' %> mt-1" title="<%= isVegFood ? 'Pure Vegetarian' : 'Non-Vegetarian' %>">
                        <span class="diet-circle"></span>
                    </div>
                </div>

                <p class="text-secondary mt-2 mb-3" style="font-size: 0.92rem; line-height: 1.5;">
                    <%= listing.description %>
                </p>

                <!-- Preparation & Spiciness Attributes -->
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                        <i class="fa-solid fa-clock text-warning me-1"></i> <%= listing.preparationTime || 20 %> Mins Prep
                    </span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                        <i class="fa-solid fa-pepper-hot text-danger me-1"></i> Spiciness: <%= listing.spicinessLevel || 'Medium' %>
                    </span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                        <i class="fa-solid fa-bowl-food text-primary me-1"></i> Category: <%= listing.category || 'Special' %>
                    </span>
                </div>

                <!-- EXCLUSIVE OWNER CONTROLS: Rendered ONLY for Piyush Kumar -->
                <% if (isPiyushOwner) { %>
                    <div class="alert alert-warning border-0 py-2 px-3 rounded-3 d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <span class="small fw-bold text-dark"><i class="fa-solid fa-crown text-warning me-1"></i> Owner Controls (Piyush Kumar)</span>
                        <div class="d-flex gap-2">
                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning rounded-pill px-3 py-1 fw-bold btn-sm shadow-sm">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
                            </a>
                            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline m-0">
                                <button class="btn btn-outline-danger rounded-pill px-3 py-1 fw-bold btn-sm shadow-sm" onclick="return confirm('Piyush, are you sure you want to permanently delete this food item from Atlas database?');">
                                    <i class="fa-solid fa-trash me-1"></i> Delete Item
                                </button>
                            </form>
                        </div>
                    </div>
                <% } %>

                <!-- Pricing & Add To Cart Button -->
                <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 border-top gap-2">
                    <div class="food-price-wrap">
                        <span class="food-old-price" style="font-size: 1rem;">&#8377;<%= originalCutPrice.toLocaleString("en-IN") %></span>
                        <span class="food-new-price" style="font-size: 1.6rem;">&#8377;<%= currentPrice.toLocaleString("en-IN") %></span>
                    </div>

                    <button class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow" onclick="addToCart('<%= listing._id %>', '<%= listing.title.replace(/'/g, '') %>', <%= listing.price %>, '<%= listing.image.url %>', <%= listing.preparationTime || 20 %>, '<%= (listing.restaurant || '').replace(/'/g, '') %>')">
                        <i class="fa-solid fa-cart-shopping me-1"></i> Add to Cart
                    </button>
                </div>

            </div>
        </div>

        <!-- Reviews Section -->
        <div class="card shadow-sm border-0 rounded-4 bg-white p-3 p-md-4 mb-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-comments text-danger me-2"></i>Customer Reviews & Ratings</h5>

            <% if(currUser) { %>
                <form action="/listings/<%= listing._id %>/reviews" method="POST" class="mb-4">
                    <div class="mb-3">
                        <label for="rating" class="form-label fw-semibold small">Rating</label>
                        <fieldset class="starability-basic">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>

                    <div class="mb-3">
                        <label for="comment" class="form-label fw-semibold small">Your Feedback</label>
                        <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control rounded-3" placeholder="Share your experience about this dish..." required></textarea>
                    </div>

                    <button class="btn btn-dark rounded-pill px-4 btn-sm fw-bold">Submit Review</button>
                </form>
            <% } else { %>
                <div class="alert alert-light border small text-muted mb-3">
                    <a href="/login" class="fw-bold text-danger text-decoration-none">Log in</a> to write a review.
                </div>
            <% } %>

            <% if(listing.reviews && listing.reviews.length > 0) { %>
                <div class="row g-2">
                    <% for(review of listing.reviews) { %>
                        <div class="col-12 col-md-6">
                            <div class="border rounded-3 p-3 bg-light h-100">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="fw-bold mb-0 small"><%= review.author ? review.author.username : 'Hungrymate Customer' %></h6>
                                    <span class="badge bg-warning text-dark py-0" style="font-size: 0.7rem;">★ <%= review.rating %></span>
                                </div>
                                <p class="small text-muted mb-2"><%= review.comment %></p>
                                
                                <% if(currUser && (currUser.isOwner || (review.author && review.author._id.equals(currUser._id)))) { %>
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="m-0">
                                        <button class="btn btn-outline-danger btn-sm py-0 px-2 rounded-pill" style="font-size: 0.7rem;">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <p class="text-muted small mb-0">No reviews yet for this dish. Be the first to try and review!</p>
            <% } %>
        </div>

    </div>
</div>

<script>
function addToCart(id, title, price, image, prepTime, restaurant) {
    let cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
    const existing = cart.find(item => item.id === id);
    if (existing) {
        existing.quantity += 1;
    } else {
        cart.push({ id, title, price, image, prepTime: prepTime || 20, restaurant: restaurant || "Chef Kitchen", quantity: 1 });
    }
    localStorage.setItem("hungrymate_cart", JSON.stringify(cart));
    if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
    alert(`${title} added to your cart!`);
}
</script>