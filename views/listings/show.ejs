<% layout("/layouts/boilerplate") %>

<% 
    const OWNER_EMAIL = "piyushkumarg292007@gmail.com";
    const OWNER_USERNAMES = ["piyush", "piyush kumar", "piyushkumar"];
    const isPiyushOwner = currUser && (
        currUser.isOwner === true || 
        (currUser.email && currUser.email.toLowerCase().trim() === OWNER_EMAIL) ||
        (currUser.username && OWNER_USERNAMES.includes(currUser.username.toLowerCase().trim()))
    );

    let avgRating = 4.8;
    let counts = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
    let totalReviews = listing.reviews ? listing.reviews.length : 0;

    if (totalReviews > 0) {
        let sum = 0;
        listing.reviews.forEach(r => {
            sum += r.rating;
            let starKey = Math.min(Math.max(Math.round(r.rating), 1), 5);
            counts[starKey] = (counts[starKey] || 0) + 1;
        });
        avgRating = (sum / totalReviews).toFixed(1);
    }

    let isVegFood = (listing.isVeg === true || String(listing.isVeg) === 'true');
    let currentPrice = listing.price || 199;
    let originalCutPrice = Math.round(currentPrice * 2.5);
%>

<style>
    /* Clean Distribution Bars (Screenshot 49 look) */
    .rating-summary-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 1.5rem;
        border: 1px solid #f1f5f9;
    }
    .rating-big-number {
        font-size: 3.5rem;
        font-weight: 800;
        line-height: 1;
        color: #0f172a;
    }
    .rating-bar-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
    }
    .rating-progress-track {
        flex: 1;
        height: 7px;
        background: #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
    }
    .rating-progress-fill {
        height: 100%;
        background: #0284c7; /* Vibrant Blue Bar */
        border-radius: 20px;
    }
</style>

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-10 col-lg-8">
        
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white mb-4">
            
            <!-- Food Image Banner -->
            <div class="position-relative w-100" style="height: clamp(240px, 35vw, 420px); background: #0f172a;">
                <span class="offer-tag-badge">FLAT 60% OFF</span>
                <span class="rating-top-badge"><i class="fa-solid fa-star me-1"></i><%= avgRating %></span>
                <img src="<%= listing.image.url %>" class="w-100 h-100 object-fit-cover" alt="<%= listing.title %>">
            </div>

            <!-- Content Details -->
            <div class="card-body p-3 p-md-4">
                
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div>
                        <h3 class="fw-bold mb-1 text-dark"><%= listing.title %></h3>
                        <p class="text-danger fw-semibold mb-0" style="font-size: 0.95rem;">
                            <i class="fa-solid fa-store me-1"></i><%= listing.restaurant || 'Hungrymate Kitchen Hub' %>
                        </p>
                        <small class="text-muted"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %></small>
                    </div>

                    <div class="food-diet-symbol <%= isVegFood ? 'veg-badge' : 'nonveg-badge' %> mt-1" title="<%= isVegFood ? 'Pure Vegetarian' : 'Non-Vegetarian' %>">
                        <span class="diet-circle"></span>
                    </div>
                </div>

                <p class="text-secondary mt-2 mb-3" style="font-size: 0.92rem; line-height: 1.5;">
                    <%= listing.description %>
                </p>

                <!-- Attributes -->
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                        <i class="fa-solid fa-clock text-warning me-1"></i> <%= listing.preparationTime || 20 %> Mins Prep
                    </span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                        <i class="fa-solid fa-pepper-hot text-danger me-1"></i> Spiciness: <%= listing.spicinessLevel || 'Medium' %>
                    </span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                        <i class="fa-solid fa-bowl-food text-primary me-1"></i> Category: <%= listing.category || 'Special' %>
                    </span>
                </div>

                <!-- EXCLUSIVE OWNER CONTROLS -->
                <% if (isPiyushOwner) { %>
                    <div class="alert alert-warning border-0 py-2 px-3 rounded-3 d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <span class="small fw-bold text-dark"><i class="fa-solid fa-crown text-warning me-1"></i> Owner Controls (Piyush Kumar)</span>
                        <div class="d-flex gap-2">
                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning rounded-pill px-3 py-1 fw-bold btn-sm shadow-sm">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
                            </a>
                            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline m-0">
                                <button class="btn btn-outline-danger rounded-pill px-3 py-1 fw-bold btn-sm shadow-sm" onclick="return confirm('Piyush, are you sure you want to permanently delete this food item from Atlas database?');">
                                    <i class="fa-solid fa-trash me-1"></i> Delete Item
                                </button>
                            </form>
                        </div>
                    </div>
                <% } %>

                <!-- Pricing & Add to Cart -->
                <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 border-top gap-2">
                    <div class="food-price-wrap">
                        <span class="food-old-price" style="font-size: 1rem;">&#8377;<%= originalCutPrice.toLocaleString("en-IN") %></span>
                        <span class="food-new-price" style="font-size: 1.6rem;">&#8377;<%= currentPrice.toLocaleString("en-IN") %></span>
                    </div>

                    <button class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow" onclick="addToCart('<%= listing._id %>', '<%= listing.title.replace(/'/g, '') %>', <%= listing.price %>, '<%= listing.image.url %>', <%= listing.preparationTime || 20 %>, '<%= (listing.restaurant || '').replace(/'/g, '') %>')">
                        <i class="fa-solid fa-cart-shopping me-1"></i> Add to Cart
                    </button>
                </div>

            </div>
        </div>

        <!-- RATINGS & FEEDBACK SECTION (MODERN DISTRIBUTION BAR - SCREENSHOT 49 STYLE) -->
        <div class="card shadow-sm border-0 rounded-4 bg-white p-3 p-md-4 mb-4">
            
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-star text-warning me-2"></i>Ratings & Customer Feedback</h5>
                    <small class="text-muted">Real reviews by Hungrymate Foodies</small>
                </div>
                
                <!-- Dedicated Add Feedback Button -->
                <a href="/listings/<%= listing._id %>/reviews/feedback-form" class="btn btn-outline-danger rounded-pill px-3 py-1 fw-bold btn-sm shadow-sm">
                    <i class="fa-solid fa-pen me-1"></i> Give Feedback
                </a>
            </div>

            <!-- Average Rating + Percentage Distribution Grid (Screenshot 49) -->
            <div class="row align-items-center p-3 mb-4 rounded-4 bg-light g-3">
                
                <div class="col-12 col-sm-4 text-center border-sm-end">
                    <div class="rating-big-number"><%= avgRating %></div>
                    <div class="text-warning fs-5 my-1">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <i class="<%= i <= Math.round(avgRating) ? 'fa-solid' : 'fa-regular' %> fa-star"></i>
                        <% } %>
                    </div>
                    <div class="small text-muted fw-semibold">Average Rating (<%= totalReviews %> Reviews)</div>
                </div>

                <div class="col-12 col-sm-8 ps-sm-4">
                    <% [5, 4, 3, 2, 1].forEach(star => { 
                        let pct = totalReviews > 0 ? Math.round((counts[star] / totalReviews) * 100) : 0;
                    %>
                        <div class="rating-bar-row">
                            <span style="width: 25px;"><%= star %>★</span>
                            <div class="rating-progress-track">
                                <div class="rating-progress-fill" style="width: <%= pct %>%;"></div>
                            </div>
                            <span style="width: 38px; text-align: right; color: #64748b;"><%= pct %>%</span>
                        </div>
                    <% }); %>
                </div>

            </div>

            <!-- All Reviews Cards List -->
            <% if(listing.reviews && listing.reviews.length > 0) { %>
                <div class="row g-3">
                    <% for(review of listing.reviews) { %>
                        <div class="col-12">
                            <div class="border rounded-4 p-3 bg-white shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 0.85rem;">
                                            <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'F' %>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark small"><%= review.author ? review.author.username : 'Hungrymate Customer' %></h6>
                                            <small class="text-muted" style="font-size: 0.72rem;"><%= new Date(review.createdAt).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></small>
                                        </div>
                                    </div>

                                    <!-- Golden Stars Badge -->
                                    <span class="badge bg-warning text-dark px-2 py-1 rounded-pill fw-bold" style="font-size: 0.75rem;">
                                        ★ <%= review.rating %>.0
                                    </span>
                                </div>

                                <p class="text-secondary small mb-2" style="line-height: 1.5;"><%= review.comment %></p>

                                <!-- Attached Review Photo if any -->
                                <% if(review.image && review.image.url) { %>
                                    <div class="mb-2">
                                        <img src="<%= review.image.url %>" alt="Food Review Image" class="rounded-3 shadow-sm object-fit-cover" style="height: 100px; width: 140px; cursor: pointer;" onclick="window.open('<%= review.image.url %>', '_blank')">
                                    </div>
                                <% } %>

                                <!-- Only Author / Owner Edit & Delete Buttons -->
                                <% if(currUser && (currUser.isOwner || (review.author && review.author._id.equals(currUser._id)))) { %>
                                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                                        <a href="/listings/<%= listing._id %>/reviews/<%= review._id %>/edit" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.72rem;">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </a>
                                        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="m-0">
                                            <button class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2" style="font-size: 0.72rem;" onclick="return confirm('Delete this feedback permanently?');">
                                                <i class="fa-solid fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="text-center py-4 border rounded-4 bg-light">
                    <i class="fa-regular fa-comment-dots fs-2 text-muted mb-2"></i>
                    <p class="text-muted small mb-0">No reviews yet for this dish. Be the first to try and share your experience!</p>
                </div>
            <% } %>

        </div>

    </div>
</div>

<script>
function addToCart(id, title, price, image, prepTime, restaurant) {
    let cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
    const existing = cart.find(item => item.id === id);
    if (existing) {
        existing.quantity += 1;
    } else {
        cart.push({ id, title, price, image, prepTime: prepTime || 20, restaurant: restaurant || "Chef Kitchen", quantity: 1 });
    }
    localStorage.setItem("hungrymate_cart", JSON.stringify(cart));
    if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
    alert(`${title} added to your cart!`);
}
</script>