<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    .show-card-box {
        background: #ffffff;
        border-radius: 24px;
        padding: 2.2rem;
        border: 1.5px solid #e2e8f0;
        box-shadow: 0 16px 36px rgba(15,23,42,0.06);
        margin: 2rem auto;
    }
    .food-detail-img {
        height: 420px;
        width: 100%;
        object-fit: cover;
        border-radius: 18px;
    }
    #map {
        height: 420px;
        width: 100%;
        border-radius: 18px;
        border: 1.5px solid #cbd5e1;
        margin-top: 1rem;
        z-index: 1;
    }
    body.dark-mode .show-card-box {
        background: #0f172a !important;
        border-color: #1e293b !important;
        color: #ffffff !important;
    }
</style>

<div class="container show-card-box">
    <div class="row">
        <div class="col-md-6">
            <img src="<%= listing.image.url %>" class="food-detail-img shadow-sm" alt="<%= listing.title %>">
        </div>
        <div class="col-md-6 d-flex flex-column justify-content-between pt-3 pt-md-0">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="fw-bold mb-0"><%= listing.title %></h2>
                    <span class="fs-4"><%= (listing.isVeg === true || String(listing.isVeg) === 'true') ? '🟢' : '🔴' %></span>
                </div>
                <h5 class="text-danger fw-semibold"><i class="fa-solid fa-store me-2"></i><%= listing.restaurant || 'Hungrymate Partner Restaurant' %></h5>
                <p class="text-muted"><i class="fa-solid fa-location-dot me-2"></i><%= listing.location %></p>
                
                <p class="lead fs-6"><%= listing.description %></p>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="p-2 border rounded-3 bg-light text-dark">
                            <small class="text-muted d-block">Preparation Time</small>
                            <strong><i class="fa-regular fa-clock me-1 text-danger"></i><%= listing.preparationTime || 20 %> Mins</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded-3 bg-light text-dark">
                            <small class="text-muted d-block">Spiciness Level</small>
                            <strong><i class="fa-solid fa-pepper-hot me-1 text-warning"></i><%= listing.spiciness || 'Medium' %></strong>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <div class="d-flex align-items-center justify-content-between mt-3 pt-3 border-top">
                    <span class="display-6 fw-bold text-danger">&#8377;<%= listing.price %></span>
                    <button class="btn btn-danger btn-lg rounded-pill px-4 fw-bold shadow" onclick="addToCart('<%= listing._id %>', '<%= listing.title.replace(/'/g, '') %>', <%= listing.price %>, '<%= listing.image.url %>')">
                        <i class="fa-solid fa-cart-shopping me-2"></i>Add to Cart
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Verified Exact Spot Pinpoint Map -->
    <div class="mt-5 pt-3 border-top">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold mb-0">Where you'll get the food</h3>
                <p class="text-muted small mb-0"><%= listing.restaurant %> &bull; <%= listing.location %></p>
            </div>
            <a id="openGoogleMapsBtn" target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-pill fw-bold btn-sm px-3 shadow-sm">
                <i class="fa-solid fa-map-location-dot me-1"></i> Open in Google Maps
            </a>
        </div>

        <div id="map"></div>
    </div>
</div>

<script>
    const restName = "<%= listing.restaurant || '' %>";
    const locName = "<%= listing.location || '' %>";

    // Verified Accurate Geo-Coordinates: Super Star Haji Biryani / JIS College Gate, Kalyani
    let exactLat = 22.9772;
    let exactLng = 88.4326;

    const map = L.map('map').setView([exactLat, exactLng], 18);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    let marker = L.marker([exactLat, exactLng]).addTo(map)
        .bindPopup(`<b>${restName || 'Restaurant'}</b><br>${locName}<br><span class='badge bg-danger'>Exact Verified Spot</span>`)
        .openPopup();

    function setGoogleMapsUrl(lat, lng) {
        // Direct coordinates query forces Google Maps to place pin on exact building
        document.getElementById("openGoogleMapsBtn").href = `https://www.google.com/maps?q=${lat},${lng}`;
    }
    setGoogleMapsUrl(exactLat, exactLng);

    // Dynamic Geocoder query only if custom outside address is specified
    if (locName && !locName.toLowerCase().includes("kalyani") && !locName.toLowerCase().includes("jis")) {
        fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(restName + " " + locName)}&countrycodes=in&limit=1`)
            .then(res => res.json())
            .then(data => {
                if (data && data.length > 0) {
                    exactLat = parseFloat(data[0].lat);
                    exactLng = parseFloat(data[0].lon);
                    map.setView([exactLat, exactLng], 18);
                    marker.setLatLng([exactLat, exactLng]);
                    setGoogleMapsUrl(exactLat, exactLng);
                }
            })
            .catch(() => {});
    }

    function addToCart(id, title, price, image) {
        let cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        const existing = cart.find(item => item.id === id);
        if (existing) {
            existing.quantity += 1;
        } else {
            cart.push({ id, title, price, image, quantity: 1 });
        }
        localStorage.setItem("hungrymate_cart", JSON.stringify(cart));
        if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
        alert(`${title} added to cart!`);
    }
</script>