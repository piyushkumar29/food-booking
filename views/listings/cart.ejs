<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 p-3 p-md-4 bg-white mb-4">
            
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                <h4 class="fw-bold mb-0 text-danger"><i class="fa-solid fa-cart-shopping me-2"></i>Your Delicious Cart</h4>
                <button class="btn btn-outline-danger btn-sm rounded-pill fw-bold" onclick="clearCart()">
                    <i class="fa-solid fa-trash me-1"></i> Clear Cart
                </button>
            </div>

            <!-- Cart Items Listing -->
            <div id="cartItemsContainer" class="mb-4"></div>

            <!-- Delivery Details & Live Location Integration (Point 4) -->
            <div class="border rounded-4 p-3 mb-4 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-location-dot text-danger me-1"></i>Delivery Details</h6>
                    
                    <!-- Live GPS Auto-Detect Button -->
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-bold d-flex align-items-center gap-1 shadow-sm" id="detectLocationBtn" onclick="fetchLiveUserLocation()">
                        <i class="fa-solid fa-crosshairs text-danger"></i>
                        <span id="locationBtnText">Use My Live Location</span>
                    </button>
                </div>

                <div class="row g-2">
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Customer Name <span class="text-danger">*</span></label>
                        <input type="text" id="custName" class="form-control rounded-pill px-3" value="<%= currUser ? currUser.username : '' %>" placeholder="Enter Full Name" required>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                        <input type="tel" id="custPhone" class="form-control rounded-pill px-3" placeholder="e.g. 9876543210" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Delivery Address <span class="text-danger">*</span></label>
                        <textarea id="custAddress" class="form-control rounded-4 p-3" rows="2" placeholder="House/Flat No, Landmark, Area, City & Pincode..." required></textarea>
                        <small id="locationStatusHint" class="text-muted d-block mt-1" style="font-size: 0.75rem;">Click 'Use My Live Location' to fill your address automatically.</small>
                    </div>
                </div>
            </div>

            <!-- Coupon Code Section -->
            <div class="border rounded-4 p-3 mb-4 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-bold small text-dark mb-0"><i class="fa-solid fa-tag text-warning me-1"></i>Apply Promo / Coupon Code</label>
                    <a href="/offers" class="small text-danger fw-bold text-decoration-none">Explore Coupon Codes &rarr;</a>
                </div>
                <small class="text-muted d-block mb-2">Available: <strong>1STUSERFREE</strong> (100% Off), <strong>FLAT60%</strong> (60% Off), <strong>HUNGRY20</strong> (20% Off)</small>
                
                <div class="input-group">
                    <input type="text" id="couponInput" class="form-control rounded-start-pill px-3 shadow-none" placeholder="Enter coupon code here..." style="text-transform: uppercase;">
                    <button class="btn btn-danger rounded-end-pill px-4 fw-bold" type="button" onclick="applyOffersCoupon()">Apply</button>
                </div>
                <div id="couponStatusMessage" class="small mt-1"></div>
            </div>

            <!-- Bill Breakdown Summary -->
            <div class="border rounded-4 p-3 mb-4">
                <h6 class="fw-bold mb-3">Order Cost Summary</h6>
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Items Subtotal:</span>
                    <strong id="subtotalText">&#8377;0</strong>
                </div>
                <div class="d-flex justify-content-between small text-success mb-1">
                    <span>Discount Applied:</span>
                    <strong id="discountText">-&#8377;0</strong>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Platform Fee:</span>
                    <strong>&#8377;9</strong>
                </div>
                <div class="d-flex justify-content-between small text-success mb-2">
                    <span>Delivery Charges:</span>
                    <strong class="text-success">FREE</strong>
                </div>
                <div class="d-flex justify-content-between fs-5 fw-bold text-danger border-top pt-2">
                    <span>Final Amount:</span>
                    <span id="grandTotalText">&#8377;0</span>
                </div>
            </div>

            <!-- Proceed to Payment Button -->
            <button class="btn btn-danger w-100 rounded-pill py-3 fw-bold fs-6 shadow" onclick="proceedToPaymentPage()">
                <i class="fa-solid fa-shield-halved me-1"></i> Proceed to Payment &rarr;
            </button>

        </div>
    </div>
</div>

<script>
    let appliedCoupon = null;
    let discountAmount = 0;

    document.addEventListener("DOMContentLoaded", () => {
        renderCart();
        const savedCheckout = JSON.parse(localStorage.getItem("hungrymate_checkout_draft") || "{}");
        if (savedCheckout.name) document.getElementById("custName").value = savedCheckout.name;
        if (savedCheckout.phone) document.getElementById("custPhone").value = savedCheckout.phone;
        if (savedCheckout.address) document.getElementById("custAddress").value = savedCheckout.address;
    });

    // Real Live Location Extraction Function (Point 4)
    function fetchLiveUserLocation() {
        const btn = document.getElementById("detectLocationBtn");
        const btnText = document.getElementById("locationBtnText");
        const statusHint = document.getElementById("locationStatusHint");
        const addressBox = document.getElementById("custAddress");

        if (!navigator.geolocation) {
            alert("Geolocation is not supported by your browser!");
            return;
        }

        btnText.innerText = "Detecting GPS...";
        btn.disabled = true;
        statusHint.innerText = "Connecting to device GPS satellites...";

        navigator.geolocation.getCurrentPosition(
            async (position) => {
                const lat = position.coords.latitude;
                const lon = position.coords.longitude;
                statusHint.innerText = `GPS coordinates acquired (${lat.toFixed(3)}, ${lon.toFixed(3)}). Fetching street address...`;

                try {
                    // OpenStreetMap Nominatim Reverse Geocoding API
                    const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lon}`);
                    const data = await response.json();

                    if (data && data.display_name) {
                        addressBox.value = data.display_name;
                        statusHint.innerHTML = `<span class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i>Live location fetched successfully!</span>`;
                    } else {
                        addressBox.value = `Latitude: ${lat}, Longitude: ${lon} (Nearby Sector)`;
                        statusHint.innerText = "Approximate coordinates filled. You may refine your flat or house number.";
                    }
                } catch (error) {
                    addressBox.value = `Location: Lat ${lat.toFixed(4)}, Lon ${lon.toFixed(4)}`;
                    statusHint.innerText = "GPS coordinates added. Please enter your complete street name.";
                } finally {
                    btnText.innerText = "Live Location Detected";
                    btn.disabled = false;
                }
            },
            (error) => {
                btnText.innerText = "Use My Live Location";
                btn.disabled = false;
                switch (error.code) {
                    case error.PERMISSION_DENIED:
                        alert("Location permission denied! Please allow location access in your browser settings.");
                        statusHint.innerText = "Permission denied. Please type your address manually.";
                        break;
                    case error.POSITION_UNAVAILABLE:
                        alert("Location information is currently unavailable.");
                        break;
                    case error.TIMEOUT:
                        alert("The request to get user location timed out.");
                        break;
                    default:
                        alert("An unknown error occurred while fetching location.");
                }
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
    }

    function renderCart() {
        const cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        const container = document.getElementById("cartItemsContainer");
        container.innerHTML = "";

        if (cart.length === 0) {
            container.innerHTML = `
                <div class="text-center py-5">
                    <i class="fa-solid fa-bowl-food fs-1 text-muted mb-2"></i>
                    <h5 class="text-muted">Your cart is empty!</h5>
                    <a href="/listings" class="btn btn-danger rounded-pill px-4 mt-2">Explore Menu</a>
                </div>
            `;
            updateBillSummary(0);
            return;
        }

        let subtotal = 0;
        cart.forEach((item, index) => {
            const itemTotal = (item.price || 0) * (item.quantity || 1);
            subtotal += itemTotal;

            container.innerHTML += `
                <div class="d-flex align-items-center justify-content-between p-2 mb-2 border rounded-3 bg-light">
                    <div class="d-flex align-items-center gap-3">
                        <img src="${item.image}" alt="${item.title}" class="rounded-3 object-fit-cover" style="width: 55px; height: 55px;">
                        <div>
                            <h6 class="fw-bold mb-0 text-dark small">${item.title}</h6>
                            <small class="text-danger fw-semibold">&#8377;${item.price} each</small>
                            <small class="text-muted d-block" style="font-size: 0.7rem;">${item.restaurant || 'Kitchen'}</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center border rounded-pill bg-white px-2 py-0">
                            <button class="btn btn-sm p-0 text-danger fw-bold" onclick="updateQty(${index}, -1)">-</button>
                            <span class="mx-2 small fw-bold">${item.quantity}</span>
                            <button class="btn btn-sm p-0 text-success fw-bold" onclick="updateQty(${index}, 1)">+</button>
                        </div>
                        <span class="fw-bold text-dark small" style="min-width: 60px; text-align: right;">&#8377;${itemTotal}</span>
                        <button class="btn btn-sm text-secondary p-0 ms-1" onclick="removeItem(${index})"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
            `;
        });

        updateBillSummary(subtotal);
    }

    function updateQty(index, delta) {
        let cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        if (!cart[index]) return;
        cart[index].quantity += delta;
        if (cart[index].quantity <= 0) cart.splice(index, 1);
        localStorage.setItem("hungrymate_cart", JSON.stringify(cart));
        renderCart();
        if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
    }

    function removeItem(index) {
        let cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        cart.splice(index, 1);
        localStorage.setItem("hungrymate_cart", JSON.stringify(cart));
        renderCart();
        if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
    }

    function clearCart() {
        if (!confirm("Are you sure you want to empty your cart?")) return;
        localStorage.removeItem("hungrymate_cart");
        renderCart();
        if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
    }

    function applyOffersCoupon() {
        const input = document.getElementById("couponInput").value.trim().toUpperCase();
        const status = document.getElementById("couponStatusMessage");
        const cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        if (cart.length === 0) return alert("Add food items to your cart first!");

        const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);

        if (input === "1STUSERFREE") {
            discountAmount = subtotal;
            appliedCoupon = "1STUSERFREE";
            status.innerHTML = `<span class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i>1STUSERFREE applied! Items are 100% Free (-₹${discountAmount})</span>`;
        } else if (input === "FLAT60%" || input === "FLAT60") {
            discountAmount = Math.round(subtotal * 0.6);
            appliedCoupon = "FLAT60%";
            status.innerHTML = `<span class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i>FLAT60% coupon applied (-₹${discountAmount})</span>`;
        } else if (input === "HUNGRY20") {
            discountAmount = Math.round(subtotal * 0.2);
            appliedCoupon = "HUNGRY20";
            status.innerHTML = `<span class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i>HUNGRY20 coupon applied (-₹${discountAmount})</span>`;
        } else {
            discountAmount = 0;
            appliedCoupon = null;
            status.innerHTML = `<span class="text-danger fw-bold"><i class="fa-solid fa-xmark me-1"></i>Invalid coupon! Check the Offers page for valid codes.</span>`;
        }
        updateBillSummary(subtotal);
    }

    function updateBillSummary(subtotal) {
        document.getElementById("subtotalText").innerHTML = `&#8377;${subtotal}`;
        document.getElementById("discountText").innerHTML = `-&#8377;${discountAmount}`;
        const finalTotal = Math.max(subtotal - discountAmount + (subtotal > 0 ? 9 : 0), 0);
        document.getElementById("grandTotalText").innerHTML = `&#8377;${finalTotal}`;
    }

    function proceedToPaymentPage() {
        const cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        if (cart.length === 0) return alert("Your cart is empty! Add items from menu first.");

        const name = document.getElementById("custName").value.trim();
        const phone = document.getElementById("custPhone").value.trim();
        const address = document.getElementById("custAddress").value.trim();

        if (!name || !phone || !address) {
            return alert("Please fill Customer Name, Mobile Number, and Delivery Address before proceeding!");
        }

        const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
        const finalTotal = Math.max(subtotal - discountAmount + 9, 0);

        const checkoutDraft = {
            name: name,
            phone: phone,
            address: address,
            cart: cart,
            subtotal: subtotal,
            discount: discountAmount,
            couponApplied: appliedCoupon || "NONE",
            finalTotal: finalTotal
        };

        localStorage.setItem("hungrymate_checkout_draft", JSON.stringify(checkoutDraft));
        window.location.href = "/checkout/payment";
    }
</script>