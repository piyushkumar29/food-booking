<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 p-3 p-md-4 bg-white mb-4">
            
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                <h4 class="fw-bold mb-0 text-danger"><i class="fa-solid fa-cart-shopping me-2"></i>Your Delicious Cart</h4>
                <button class="btn btn-outline-danger btn-sm rounded-pill fw-bold" onclick="clearCart()">
                    <i class="fa-solid fa-trash me-1"></i> Clear Cart
                </button>
            </div>

            <div id="cartItemsContainer" class="mb-4">
                <!-- Dynamically Populated by Cart Items -->
            </div>

            <!-- Coupon Code Section -->
            <div class="border rounded-4 p-3 mb-4 bg-light">
                <label class="form-label fw-bold small text-dark mb-1"><i class="fa-solid fa-tag text-warning me-1"></i>Apply Promo / Coupon Code</label>
                <div class="input-group">
                    <input type="text" id="couponInput" class="form-control rounded-pill-start shadow-none" placeholder="Try HUNGRY60, WELCOME, or PIYUSH" style="text-transform: uppercase;">
                    <button class="btn btn-danger rounded-pill-end px-4 fw-bold" type="button" onclick="applyCoupon()">Apply</button>
                </div>
                <div id="couponStatusMessage" class="small mt-1"></div>
            </div>

            <!-- Delivery Address & Contact Form -->
            <div class="border rounded-4 p-3 mb-4 bg-light">
                <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-location-dot text-danger me-1"></i>Delivery Details</h6>
                <div class="row g-2">
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Customer Name</label>
                        <input type="text" id="custName" class="form-control rounded-pill" value="<%= currUser ? currUser.username : '' %>" placeholder="Your Full Name" required>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Mobile Number</label>
                        <input type="tel" id="custPhone" class="form-control rounded-pill" placeholder="e.g. 9876543210" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Delivery Address</label>
                        <textarea id="custAddress" class="form-control rounded-3" rows="2" placeholder="Street, Flat No, Landmark, City Area..." required></textarea>
                    </div>
                </div>
            </div>

            <!-- Bill Breakdown Summary -->
            <div class="border rounded-4 p-3 mb-4">
                <h6 class="fw-bold mb-3">Order Cost Summary</h6>
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Items Subtotal:</span>
                    <strong id="subtotalText">&#8377;0</strong>
                </div>
                <div class="d-flex justify-content-between small text-success mb-1">
                    <span>Discount Applied:</span>
                    <strong id="discountText">-&#8377;0</strong>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Platform Fee:</span>
                    <strong>&#8377;9</strong>
                </div>
                <div class="d-flex justify-content-between small text-success mb-2">
                    <span>Delivery Charges:</span>
                    <strong class="text-success">FREE</strong>
                </div>
                <div class="d-flex justify-content-between fs-5 fw-bold text-danger border-top pt-2">
                    <span>To Pay:</span>
                    <span id="grandTotalText">&#8377;0</span>
                </div>
            </div>

            <button class="btn btn-danger w-100 rounded-pill py-3 fw-bold fs-6 shadow" onclick="placeFinalFoodOrder()">
                <i class="fa-solid fa-bolt me-1"></i> Place Order Now (Cash on Delivery / UPI)
            </button>

        </div>
    </div>
</div>

<script>
    let appliedCoupon = null;
    let discountAmount = 0;

    // Delivery Heroes Pool (Randomized per new order)
    const heroPool = [
        { name: "Rahul Verma", id: "HM-DEL-984", phone: "+91 98765 43210" },
        { name: "Amitabh Sen", id: "HM-DEL-412", phone: "+91 98301 22415" },
        { name: "Subhash Mondal", id: "HM-DEL-773", phone: "+91 89104 55621" },
        { name: "Rohan Mukherjee", id: "HM-DEL-291", phone: "+91 94331 88902" },
        { name: "Vikram Das", id: "HM-DEL-658", phone: "+91 97482 11340" },
        { name: "Santosh Yadav", id: "HM-DEL-319", phone: "+91 91234 77881" },
        { name: "Ankit Sharma", id: "HM-DEL-552", phone: "+91 98322 41098" }
    ];

    document.addEventListener("DOMContentLoaded", renderCart);

    function renderCart() {
        const cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        const container = document.getElementById("cartItemsContainer");
        container.innerHTML = "";

        if (cart.length === 0) {
            container.innerHTML = `
                <div class="text-center py-5">
                    <i class="fa-solid fa-bowl-food fs-1 text-muted mb-2"></i>
                    <h5 class="text-muted">Your cart is empty!</h5>
                    <a href="/listings" class="btn btn-danger rounded-pill px-4 mt-2">Explore Menu</a>
                </div>
            `;
            updateBillSummary(0);
            return;
        }

        let subtotal = 0;

        cart.forEach((item, index) => {
            const itemTotal = (item.price || 0) * (item.quantity || 1);
            subtotal += itemTotal;

            container.innerHTML += `
                <div class="d-flex align-items-center justify-content-between p-2 mb-2 border rounded-3 bg-light">
                    <div class="d-flex align-items-center gap-3">
                        <img src="${item.image}" alt="${item.title}" class="rounded-3 object-fit-cover" style="width: 55px; height: 55px;">
                        <div>
                            <h6 class="fw-bold mb-0 text-dark small">${item.title}</h6>
                            <small class="text-danger fw-semibold">&#8377;${item.price} each</small>
                            <small class="text-muted d-block" style="font-size: 0.7rem;">${item.restaurant || 'Kitchen'}</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center border rounded-pill bg-white px-2 py-0">
                            <button class="btn btn-sm p-0 text-danger fw-bold" onclick="updateQty(${index}, -1)">-</button>
                            <span class="mx-2 small fw-bold">${item.quantity}</span>
                            <button class="btn btn-sm p-0 text-success fw-bold" onclick="updateQty(${index}, 1)">+</button>
                        </div>
                        <span class="fw-bold text-dark small" style="min-width: 60px; text-align: right;">&#8377;${itemTotal}</span>
                        <button class="btn btn-sm text-secondary p-0 ms-1" onclick="removeItem(${index})"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
            `;
        });

        updateBillSummary(subtotal);
    }

    function updateQty(index, delta) {
        let cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        if (!cart[index]) return;
        cart[index].quantity += delta;
        if (cart[index].quantity <= 0) cart.splice(index, 1);
        localStorage.setItem("hungrymate_cart", JSON.stringify(cart));
        renderCart();
        if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
    }

    function removeItem(index) {
        let cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        cart.splice(index, 1);
        localStorage.setItem("hungrymate_cart", JSON.stringify(cart));
        renderCart();
        if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
    }

    function clearCart() {
        if (!confirm("Are you sure you want to empty your cart?")) return;
        localStorage.removeItem("hungrymate_cart");
        renderCart();
        if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();
    }

    function applyCoupon() {
        const input = document.getElementById("couponInput").value.trim().toUpperCase();
        const status = document.getElementById("couponStatusMessage");
        const cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        if (cart.length === 0) return alert("Add items to your cart first!");

        const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);

        if (input === "HUNGRY60" || input === "PIYUSH") {
            discountAmount = Math.round(subtotal * 0.6);
            appliedCoupon = input;
            status.innerHTML = `<span class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i>Hurray! 60% flat coupon applied (-₹${discountAmount})</span>`;
        } else if (input === "WELCOME") {
            discountAmount = Math.min(100, Math.round(subtotal * 0.3));
            appliedCoupon = input;
            status.innerHTML = `<span class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i>Welcome discount applied (-₹${discountAmount})</span>`;
        } else {
            discountAmount = 0;
            appliedCoupon = null;
            status.innerHTML = `<span class="text-danger fw-bold"><i class="fa-solid fa-xmark me-1"></i>Invalid coupon code! Try HUNGRY60 or PIYUSH</span>`;
        }
        updateBillSummary(subtotal);
    }

    function updateBillSummary(subtotal) {
        document.getElementById("subtotalText").innerHTML = `&#8377;${subtotal}`;
        document.getElementById("discountText").innerHTML = `-&#8377;${discountAmount}`;
        const finalTotal = Math.max(subtotal - discountAmount + (subtotal > 0 ? 9 : 0), 0);
        document.getElementById("grandTotalText").innerHTML = `&#8377;${finalTotal}`;
    }

    // Place Order: Assigns unique random 15-30 min duration & random delivery hero
    function placeFinalFoodOrder() {
        const cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
        if (cart.length === 0) return alert("Your cart is empty! Add food items first.");

        const name = document.getElementById("custName").value.trim();
        const phone = document.getElementById("custPhone").value.trim();
        const address = document.getElementById("custAddress").value.trim();

        if (!name || !phone || !address) {
            return alert("Please enter Customer Name, Mobile Number and Delivery Address!");
        }

        const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
        const grandTotal = Math.max(subtotal - discountAmount + 9, 0);

        // Generate Random Duration between 15 and 30 Minutes
        const randomDurationMins = Math.floor(Math.random() * (30 - 15 + 1)) + 15;

        // Generate Unique Order ID (e.g. HM-78214)
        const orderId = "HM-" + Math.floor(10000 + Math.random() * 90000);

        // Pick Random Delivery Partner
        const randomHero = heroPool[Math.floor(Math.random() * heroPool.length)];

        const now = new Date();
        const placedAtStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ", " + now.toLocaleDateString("en-IN", { day: 'numeric', month: 'short' });

        const newOrder = {
            orderId: orderId,
            customerName: name,
            customerPhone: phone,
            address: address,
            items: cart,
            subtotal: subtotal,
            discount: discountAmount,
            couponApplied: appliedCoupon || "NONE",
            totalPaid: grandTotal,
            totalDurationMins: randomDurationMins, // Fixed random 15-30 min timer
            timestampStart: Date.now(), // Real time anchor (prevents reset on page reload)
            placedAt: placedAtStr,
            deliveryHeroData: randomHero, // Random delivery partner & phone
            restaurantName: cart[0].restaurant || "Chef Kitchen",
            firstFoodItemId: cart[0].id || "", // For review feedback reference
            isDelivered: false,
            isCancelled: false
        };

        let history = JSON.parse(localStorage.getItem("hungrymate_order_history") || "[]");
        history.unshift(newOrder); // New order on top
        localStorage.setItem("hungrymate_order_history", JSON.stringify(history));

        // Clear active cart
        localStorage.removeItem("hungrymate_cart");
        if (typeof refreshNavCartBadge === "function") refreshNavCartBadge();

        alert(`Order #${orderId} placed successfully! Delivery ETA: ${randomDurationMins} Mins.`);
        window.location.href = "/orders/track";
    }
</script>