<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <br>
            <h3>Create a new food list</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                
                <div class="mb-3">
                    <label for="title" class="form-label">Food Title</label>
                    <input name="listing[title]" placeholder="Enter food name (e.g. Chicken Biryani)" type="text" class="form-control" required/>
                    <div class="valid-feedback">Looks good!</div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="restaurant" class="form-label">Restaurant Name</label>
                        <input name="listing[restaurant]" placeholder="e.g. Behrouz Biryani, Haldiram" type="text" class="form-control" required/>
                        <div class="invalid-feedback">Please enter restaurant name</div>
                    </div>
                    <div class="mb-3 col-md-6">
                        <label for="location" class="form-label">Restaurant Location / City</label>
                        <input name="listing[location]" placeholder="e.g. Connaught Place, New Delhi" type="text" class="form-control" required/>
                        <div class="invalid-feedback">Please enter location</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" placeholder="Write about the food description" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please enter a description</div>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Upload food image</label>
                    <input name="listing[image]" type="file" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" placeholder="Enter price" type="number" class="form-control" required/>
                    <div class="invalid-feedback">Please enter a valid Price</div>
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <select name="listing[category]" class="form-select" required>
                        <option value="Starters">Starters</option>
                        <option value="Main Course">Main Course</option>
                        <option value="Dessert">Dessert</option>
                        <option value="Beverages">Beverages</option>
                        <option value="Breakfast / Snacks">Breakfast / Snacks</option>
                        <option value="Italian / Fast Food">Italian / Fast Food</option>
                    </select>
                </div>

                <div class="mt-3">
                    <label for="food-type" class="form-label">Food type</label>
                    <select name="listing[isVeg]" class="form-select" required>
                        <option value="true">🟢 Veg</option>
                        <option value="false">🔴 Non-Veg</option>
                    </select>
                </div>

                <div class="mt-3">
                    <label for="preparationTime" class="form-label">Preparation time (mins)</label>
                    <input name="listing[preparationTime]" placeholder="e.g. 20" class="form-control" required/>
                </div>

                <div class="mt-3">
                    <label for="spiciness" class="form-label">Spiciness</label>
                    <select name="listing[spiciness]" class="form-select" required>
                        <option value="Mild">Mild</option>
                        <option value="Medium">Medium</option>
                        <option value="Spicy">Spicy</option>
                        <option value="Sweet">Sweet</option>
                        <option value="None">None</option>
                    </select>
                </div>
                <br><br>

                <button class="btn btn-dark">Add Listing</button>
                <br><br>
            </form>
        </div>
    </div>
</body>