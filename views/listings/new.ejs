<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 p-3 p-md-4 mb-4">
            <div class="text-center mb-3">
                <h3 class="fw-bold text-danger mb-1"><i class="fa-solid fa-utensils me-2"></i>Add New Food Dish</h3>
                <p class="text-muted small">Post a new delicious item directly to Hungrymate menu</p>
            </div>

            <form method="POST" action="/listings" enctype="multipart/form-data" novalidate class="needs-validation">
                
                <div class="mb-3">
                    <label for="title" class="form-label fw-semibold small">Dish Name</label>
                    <input name="listing[title]" id="title" placeholder="e.g. Special Hyderabadi Biryani" type="text" class="form-control rounded-pill px-3" required />
                    <div class="invalid-feedback">Please enter dish name</div>
                </div>

                <div class="mb-3">
                    <label for="restaurant" class="form-label fw-semibold small">Restaurant Name</label>
                    <input name="listing[restaurant]" id="restaurant" placeholder="e.g. Behrouz Biryani, Aminia" type="text" class="form-control rounded-pill px-3" required />
                    <div class="invalid-feedback">Please enter restaurant name</div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-12 col-sm-6">
                        <label for="location" class="form-label fw-semibold small">Location / City Area</label>
                        <input name="listing[location]" id="location" placeholder="e.g. Sector V, Salt Lake" type="text" class="form-control rounded-pill px-3" required />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label for="country" class="form-label fw-semibold small">Country</label>
                        <input name="listing[country]" id="country" value="India" type="text" class="form-control rounded-pill px-3" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label fw-semibold small">Dish Description</label>
                    <textarea name="listing[description]" id="description" class="form-control rounded-4 p-3" rows="3" placeholder="Describe the ingredients, taste, spices and freshness..." required></textarea>
                </div>

                <!-- DUAL IMAGE UPLOAD SYSTEM: File OR URL Link -->
                <div class="border rounded-4 p-3 mb-3 bg-light">
                    <label class="form-label fw-bold small mb-2 d-flex align-items-center">
                        <i class="fa-solid fa-image text-danger me-2"></i>Food Dish Photo (Choose Any One Option):
                    </label>

                    <div class="mb-2">
                        <label for="imageFile" class="form-label small mb-1">Option A: Choose photo from folder</label>
                        <input name="listing[image]" id="imageFile" type="file" class="form-control rounded-pill" accept="image/*" />
                    </div>

                    <div class="text-center text-muted small fw-bold my-1">--- OR ---</div>

                    <div class="mb-1">
                        <label for="imageUrl" class="form-label small mb-1">Option B: Direct Online Image Link (URL)</label>
                        <input name="imageUrl" id="imageUrl" type="url" placeholder="Paste direct image link e.g. https://images.unsplash.com/..." class="form-control rounded-pill px-3" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label for="price" class="form-label fw-semibold small">Price (₹)</label>
                        <input name="listing[price]" id="price" placeholder="260" type="number" class="form-control rounded-pill px-3" required />
                    </div>
                    <div class="col-6">
                        <label for="prepTime" class="form-label fw-semibold small">Prep Time (Mins)</label>
                        <input name="listing[preparationTime]" id="prepTime" value="20" type="number" class="form-control rounded-pill px-3" />
                    </div>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <label for="category" class="form-label fw-semibold small">Category</label>
                        <select name="listing[category]" id="category" class="form-select rounded-pill px-3">
                            <option value="Biryani / Rice" selected>Biryani / Rice</option>
                            <option value="Fast Food">Fast Food (Pizza/Burger)</option>
                            <option value="Breakfast">Breakfast</option>
                            <option value="Indian Thali">Indian Thali</option>
                            <option value="Street Food">Street Food</option>
                            <option value="Kathi Rolls">Kathi Rolls</option>
                            <option value="Momos">Momos</option>
                            <option value="Chinese / Noodles">Chinese / Noodles</option>
                            <option value="Dessert">Ice-cream / Dessert</option>
                            <option value="Bakery">Cake / Bakery</option>
                            <option value="Beverages">Beverages / Shakes</option>
                        </select>
                    </div>

                    <div class="col-6">
                        <label for="isVeg" class="form-label fw-semibold small">Food Diet</label>
                        <select name="listing[isVeg]" id="isVeg" class="form-select rounded-pill px-3">
                            <option value="true">🟢 Pure Veg</option>
                            <option value="false" selected>🔴 Non-Veg</option>
                        </select>
                    </div>
                </div>

                <button class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow">
                    <i class="fa-solid fa-plus me-1"></i> Add Dish to Menu
                </button>
            </form>
        </div>
    </div>
</div>