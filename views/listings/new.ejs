<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h1>Create a new listings</h1>
    <form method="POST" action="/listings">
        <input name="listing[title]" placeholder="Enter title" type="text" />
        <br> <br>
        <textarea name="listing[description]" placeholder="Enter Description"></textarea>
        <br> <br>
        <input name="listing[image]" placeholder="Enter image URL/Link" type="text" />
        <br> <br>
        <input name="listing[price]" placeholder="Enter price" type="number" />
        <br> <br>
        <label>Category:</label><br>
        <select name="listing[category]">
            <option value="Starters">Starters</option>
            <option value="Main Course">Main Course</option>
            <option value="Dessert">Dessert</option>
            <option value="Beverages">Beverages</option>
            <option value="Breakfast / Snacks">Breakfast / Snacks</option>
            <option value="Italian / Fast Food">Italian / Fast Food</option>
        </select>
        <br><br>
        <label>Food Type:</label><br>
        <select name="listing[isVeg]">
            <option value="true">🟢 Veg</option>
            <option value="false">🔴 Non-Veg</option>
        </select>
        <br><br>
        <label>Preparation Time (mins):</label><br>
        <input name="listing[PreparationTime]" placeholder="e.g. 20" />
        <br><br>
        <label>Spiciness Level:</label><br>
        <select name="listing[Spiciness]">
            <option value="Mild">🌶️ Mild</option>
            <option value="Medium">🌶️🌶️ Medium</option>
            <option value="Spicy">🌶️🌶️🌶️ Spicy</option>
        </select>
        <br><br>
        <button>Add</button>

    </form>
</body>
</html>