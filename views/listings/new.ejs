<% layout("/layouts/boilerplate") %>

<style>
    .new-listing-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 2.2rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        border: 1.5px solid #e2e8f0;
        margin-top: 1.5rem;
        margin-bottom: 3rem;
    }
    .form-control-custom, .form-select-custom {
        background-color: #f8fafc !important;
        border: 1.5px solid #cbd5e1 !important;
        color: #0f172a !important;
        border-radius: 12px;
        padding: 0.68rem 1rem;
        font-size: 0.94rem;
        transition: all 0.2s ease;
    }
    .form-control-custom:focus, .form-select-custom:focus {
        background-color: #ffffff !important;
        border-color: #fe424d !important;
        box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.15) !important;
    }
    body.dark-mode .new-listing-card {
        background: #0f172a !important;
        border-color: #1e293b !important;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5) !important;
    }
    body.dark-mode .form-control-custom, body.dark-mode .form-select-custom {
        background-color: #1e293b !important;
        border-color: #334155 !important;
        color: #f8fafc !important;
    }
    body.dark-mode .form-control-custom:focus {
        background-color: #243048 !important;
        border-color: #f59e0b !important;
    }
</style>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-7">
        <div class="new-listing-card">
            <h3 class="fw-bold mb-1 text-center" style="color: #fe424d;"><i class="fa-solid fa-utensils me-2"></i>Add New Food Dish</h3>
            <p class="text-muted small text-center mb-4">Post a new delicious item directly to Hungrymate menu</p>

            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label fw-semibold small">Dish Name</label>
                    <input name="listing[title]" id="title" placeholder="e.g. Special Hyderabadi Biryani" type="text" class="form-control form-control-custom" required />
                    <div class="invalid-feedback">Dish title is required.</div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="restaurant" class="form-label fw-semibold small">Restaurant Name</label>
                        <input name="listing[restaurant]" id="restaurant" placeholder="e.g. Behrouz Biryani" type="text" class="form-control form-control-custom" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="location" class="form-label fw-semibold small">Exact Location (City / Area)</label>
                        <input name="listing[location]" id="location" placeholder="e.g. Sector V, Salt Lake, Kolkata" type="text" class="form-control form-control-custom" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label fw-semibold small">Dish Description</label>
                    <textarea name="listing[description]" id="description" rows="3" placeholder="Describe the ingredients, spice, and freshness..." class="form-control form-control-custom" required></textarea>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label fw-semibold small">Food Image</label>
                    <input name="listing[image]" id="image" type="file" class="form-control form-control-custom" required />
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="price" class="form-label fw-semibold small">Price (&#8377;)</label>
                        <input name="listing[price]" id="price" type="number" placeholder="299" class="form-control form-control-custom" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="category" class="form-label fw-semibold small">Category</label>
                        <select name="listing[category]" id="category" class="form-select form-select-custom" required>
                            <option value="Biryani / Rice">Biryani / Rice</option>
                            <option value="Pizza / Fast Food">Pizza / Fast Food</option>
                            <option value="Burger">Burger</option>
                            <option value="Starters">Starters</option>
                            <option value="Indian Thali">Indian Thali</option>
                            <option value="Dessert">Dessert</option>
                            <option value="Beverages">Beverages</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="isVeg" class="form-label fw-semibold small">Food Diet</label>
                        <select name="listing[isVeg]" id="isVeg" class="form-select form-select-custom" required>
                            <option value="true">&#x1F7E2; Pure Veg</option>
                            <option value="false">&#x1F534; Non-Veg</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="prepTime" class="form-label fw-semibold small">Preparation Time (Mins)</label>
                        <input name="listing[preparationTime]" id="prepTime" placeholder="25" type="number" class="form-control form-control-custom" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="spiciness" class="form-label fw-semibold small">Spiciness Level</label>
                        <select name="listing[spiciness]" id="spiciness" class="form-select form-select-custom" required>
                            <option value="Mild">Mild</option>
                            <option value="Medium" selected>Medium</option>
                            <option value="Spicy">Spicy</option>
                        </select>
                    </div>
                </div>

                <button class="btn btn-dark w-100 py-2 fw-bold rounded-3 mt-2 shadow" style="background: linear-gradient(135deg, #fe424d 0%, #ec4899 100%); border: none;">Publish Food Listing</button>
            </form>
        </div>
    </div>
</div>