<!-- Floating Chat Pop-up Box -->
<div class="ai-chat-window" id="aiChatWindow">
  <!-- Header -->
  <div class="ai-chat-header">
    <div class="d-flex align-items-center gap-2">
      <div class="ai-bot-avatar">
        <i class="fa-solid fa-robot"></i>
      </div>
      <div>
        <h6 class="mb-0 fw-bold" style="font-size: 0.92rem;">Hungrymate AI Support</h6>
        <small class="text-white-50" style="font-size: 0.7rem;"><i class="fa-solid fa-circle text-success" style="font-size: 0.5rem;"></i> Online &bull; Instant Assistance</small>
      </div>
    </div>
    <button type="button" class="btn text-white p-0 border-0 fs-5" onclick="toggleHungrymateAiChat()">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <!-- Messages Container -->
  <div class="ai-chat-messages" id="aiChatMessages">
    <div class="ai-msg bot">
      Hello! 👋 Welcome to <strong>Hungrymate Customer Care</strong>. I am your 24/7 AI Order Support. How can I assist you with your orders, refunds, or delivery today?
    </div>
  </div>

  <!-- Quick Action Chips -->
  <div class="ai-chips-wrapper">
    <button class="ai-chip-btn" onclick="sendAiQuickMessage('Track my latest order')">📍 Track Order</button>
    <button class="ai-chip-btn" onclick="sendAiQuickMessage('Refund & Cancellation Policy')">💸 Refund Status</button>
    <button class="ai-chip-btn" onclick="sendAiQuickMessage('Contact Delivery Partner')">🛵 Delivery Hero</button>
    <button class="ai-chip-btn" onclick="sendAiQuickMessage('How to apply coupons?')">🏷️ Coupons</button>
  </div>

  <!-- Input Field Bar -->
  <form class="ai-chat-input-bar" onsubmit="event.preventDefault(); submitAiChatInput();">
    <input type="text" id="aiChatTextInput" class="ai-chat-input shadow-none" placeholder="Type your order query here..." autocomplete="off" />
    <button type="submit" class="ai-chat-send-btn shadow-sm">
      <i class="fa-solid fa-paper-plane" style="font-size: 0.85rem;"></i>
    </button>
  </form>
</div>

<script>
  let isAiChatOpen = false;

  function toggleHungrymateAiChat() {
    const chatWin = document.getElementById("aiChatWindow");
    if (!chatWin) return;
    isAiChatOpen = !isAiChatOpen;
    chatWin.style.display = isAiChatOpen ? "flex" : "none";
    if (isAiChatOpen) {
      setTimeout(() => {
        const inp = document.getElementById("aiChatTextInput");
        if (inp) inp.focus();
        scrollAiMessagesToBottom();
      }, 100);
    }
  }

  function scrollAiMessagesToBottom() {
    const container = document.getElementById("aiChatMessages");
    if (container) container.scrollTop = container.scrollHeight;
  }

  function submitAiChatInput() {
    const inputEl = document.getElementById("aiChatTextInput");
    if (!inputEl) return;
    const msg = inputEl.value.trim();
    if (!msg) return;
    inputEl.value = "";
    processAiMessage(msg);
  }

  function sendAiQuickMessage(text) {
    processAiMessage(text);
  }

  function processAiMessage(userText) {
    const container = document.getElementById("aiChatMessages");
    if (!container) return;

    // Append User Message
    const userDiv = document.createElement("div");
    userDiv.className = "ai-msg user";
    userDiv.innerText = userText;
    container.appendChild(userDiv);
    scrollAiMessagesToBottom();

    // Fetch User's Latest Order from LocalStorage
    let latestOrder = null;
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.includes("hungrymate_order_history")) {
        try {
          const parsed = JSON.parse(localStorage.getItem(k));
          if (Array.isArray(parsed) && parsed.length > 0) {
            latestOrder = parsed[0];
            break;
          }
        } catch(e) {}
      }
    }

    // Typing delay simulator
    setTimeout(() => {
      const botDiv = document.createElement("div");
      botDiv.className = "ai-msg bot";

      const query = userText.toLowerCase();

      if (query.includes("track") || query.includes("where") || query.includes("status")) {
        if (latestOrder) {
          const hero = latestOrder.deliveryHeroData || { name: "Rahul Verma", phone: "+91 98765 43210" };
          const status = latestOrder.isCancelled ? "Cancelled ❌" : (latestOrder.isDelivered ? "Delivered 🎉" : "In-Transit 🛵");
          botDiv.innerHTML = `Your latest Order <strong>#${latestOrder.orderId}</strong> is currently <strong>${status}</strong>.<br><br>Delivery Hero: <strong>${hero.name}</strong> (${hero.phone}).<br>Delivering to: <em>${latestOrder.address || 'Address registered'}</em>.<br><br>You can watch the live route on our <a href="/orders/track" class="text-danger fw-bold">Tracking Page</a>!`;
        } else {
          botDiv.innerHTML = `You don't have any active orders right now! Browse our delicious menu and add items to your cart to place an order.`;
        }
      } else if (query.includes("refund") || query.includes("cancel")) {
        botDiv.innerHTML = `<strong>Hungrymate Cancellation & Refund Policy:</strong><br>• For online orders (UPI/Card), refunds are credited back to your original source account within 1–2 business days.<br>• For Cash on Delivery (COD) orders with prepaid platform fees, you can provide your UPI ID in the cancellation window for direct payout.<br>• You can cancel your order directly from the <a href="/orders/track" class="text-danger fw-bold">Live Tracking Page</a> anytime before final dispatch.`;
      } else if (query.includes("hero") || query.includes("partner") || query.includes("delivery boy") || query.includes("contact")) {
        if (latestOrder && latestOrder.deliveryHeroData) {
          const hero = latestOrder.deliveryHeroData;
          botDiv.innerHTML = `Your assigned delivery hero is <strong>${hero.name}</strong> (ID: ${hero.id}). You can reach them directly at <a href="tel:${hero.phone.replace(/\s+/g,'')}" class="text-success fw-bold">${hero.phone}</a>.`;
        } else {
          botDiv.innerHTML = `Our delivery heroes are 100% vaccinated and trained for hygiene. Once you place an order, you will receive their real-time name, contact number, and live motorcycle animation.`;
        }
      } else if (query.includes("coupon") || query.includes("offer") || query.includes("discount")) {
        botDiv.innerHTML = `You can use promo code <strong>1STUSERFREE</strong> for 100% discount on your first order! Or try <strong>FLAT60%</strong> and <strong>HUNGRY20</strong> on our <a href="/offers" class="text-danger fw-bold">Offers Page</a>.`;
      } else {
        botDiv.innerHTML = `Thank you for contacting Hungrymate! For inquiries regarding active food deliveries, please visit our <a href="/orders/track" class="text-danger fw-bold">Track Page</a>, or call our 24/7 support desk at <strong>1800-HUNGRY-MATE</strong>.`;
      }

      container.appendChild(botDiv);
      scrollAiMessagesToBottom();
    }, 450);
  }
</script>