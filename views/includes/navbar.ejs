<script>
function promptEditName(currentName) {
    const updated = prompt("Enter your new profile name:", currentName);
    if (updated !== null && updated.trim() !== "" && updated.trim() !== currentName) {
        document.getElementById("newNameInput").value = updated.trim();
        document.getElementById("editNameForm").submit();
    }
}

function uploadPermanentAvatar(event) {
    const file = event.target.files[0];
    if (file) {
        if (file.size > 5 * 1024 * 1024) return alert("Image must be under 5MB!");
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById("avatarDataInput").value = e.target.result;
            document.getElementById("editAvatarForm").submit();
        };
        reader.readAsDataURL(file);
    }
}

function refreshNavCartBadge() {
    const cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
    const totalCount = cart.reduce((acc, item) => acc + (item.quantity || 1), 0);
    const badge = document.getElementById("navCartCountBadge");
    const mobileBadge = document.getElementById("mobileCartBadge");
    if (badge) badge.innerText = totalCount;
    if (mobileBadge) mobileBadge.innerText = totalCount;
}
document.addEventListener("DOMContentLoaded", refreshNavCartBadge);
window.addEventListener("storage", refreshNavCartBadge);

function populateRestaurantModal() {
    const container = document.getElementById("restaurantChipsContainer");
    if (!container) return;

    let rests = new Set();
    const cards = document.querySelectorAll(".food-card-box");
    cards.forEach(c => {
        const r = c.getAttribute("data-restaurant");
        if (r && r.trim() !== "") rests.add(r.trim());
    });

    if (rests.size === 0) {
        ["super star haji briyani", "Aminia Restaurant", "Oudh 1590", "Domino's Pizza", "Pizza Hut", "Haldiram's", "Wow! Momo", "Flurys Kolkata", "Burger King", "Cafe Coffee Day"].forEach(r => rests.add(r));
    }

    container.innerHTML = "";
    Array.from(rests).sort().forEach(r => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "btn btn-sm btn-outline-secondary rounded-pill rest-chip-btn";
        btn.innerHTML = `<i class="fa-solid fa-store me-1 text-danger"></i> ${r}`;
        btn.onclick = () => selectRestaurantFilter(r);
        container.appendChild(btn);
    });
}

function filterRestListInModal() {
    const q = (document.getElementById("manualRestSearchInput").value || "").toLowerCase().trim();
    const btns = document.querySelectorAll(".rest-chip-btn");
    btns.forEach(b => {
        if (b.innerText.toLowerCase().includes(q)) {
            b.style.display = "inline-block";
        } else {
            b.style.display = "none";
        }
    });
}

function selectRestaurantFilter(restName) {
    const modalEl = document.getElementById('sameRestaurantModal');
    const modal = bootstrap.Modal.getInstance(modalEl);
    if (modal) modal.hide();

    if (!window.location.pathname.includes("/listings") || window.location.pathname.length > 10) {
        window.location.href = `/listings?restaurant=${encodeURIComponent(restName)}`;
        return;
    }

    if (typeof filterSpecificRestaurant === "function") {
        filterSpecificRestaurant(restName);
    }
}

document.addEventListener("DOMContentLoaded", populateRestaurantModal);

const dInput = document.getElementById("foodSearchInput");
const mInput = document.getElementById("mobileFoodSearchInput");

function syncSearch(val) {
    if (dInput && dInput.value !== val) dInput.value = val;
    if (mInput && mInput.value !== val) mInput.value = val;
    if (typeof applyAllFilters === "function") applyAllFilters();
}

if (dInput) dInput.addEventListener("input", (e) => syncSearch(e.target.value));
if (mInput) mInput.addEventListener("input", (e) => syncSearch(e.target.value));
</script>