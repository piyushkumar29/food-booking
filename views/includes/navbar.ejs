              </button>
            </li>
            <li>
              <label for="avatarFileInput" class="dropdown-item py-2 rounded-2 d-flex align-items-center gap-2 mb-0" style="cursor: pointer;">
                <i class="fa-solid fa-camera text-danger"></i>
                <span>Change Photo</span>
