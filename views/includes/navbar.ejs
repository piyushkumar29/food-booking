            autocomplete="off"
            style="border: 1.5px solid #cbd5e1; font-size: 0.9rem;"
          />
          <button class="btn position-absolute end-0 top-50 translate-middle-y me-2 border-0 bg-transparent text-secondary p-0" type="submit" id="searchSubmitBtn">
            <i class="fa-solid fa-magnifying-glass fs-6"></i>
          </button>
        </div>
      </form>

      <!-- History Dropdown -->
      <div id="searchHistoryBox" class="position-absolute border rounded-3 shadow-lg w-100 mt-1 d-none" style="z-index: 1060; max-height: 220px; overflow-y: auto; left: 0;">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom" style="font-size: 0.78rem; opacity: 0.85;">
          <span class="fw-bold"><i class="fa-solid fa-clock-rotate-left me-1"></i> RECENT SEARCHES</span>
          <span role="button" id="clearHistoryBtn" class="text-danger fw-semibold" style="cursor: pointer;">Clear</span>
        </div>
        <ul id="historyList" class="list-unstyled m-0 p-0"></ul>
      </div>
    </div>

    <!-- Right: Cart Icon & Auth / Profile Details -->
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
      
      <!-- Cart Box Trigger -->
      <a href="/cart" class="btn btn-light border position-relative rounded-pill px-3 py-1 d-flex align-items-center gap-2 text-decoration-none" title="View Cart">
        <i class="fa-solid fa-cart-shopping text-danger fs-5"></i>
        <span class="d-none d-sm-inline fw-semibold" style="font-size: 0.88rem;">Cart</span>
        <span id="navCartCountBadge" class="badge rounded-pill bg-danger" style="font-size: 0.72rem;">0</span>
      </a>

      <% if(!currUser) { %>
        <a class="btn nav-auth-signup-btn rounded-pill px-3 py-1 fw-semibold btn-sm" href="/signup">Sign up</a>
        <a class="btn btn-dark rounded-pill px-3 py-1 fw-semibold btn-sm" href="/login">Log in</a>
      <% } %>

      <% if(currUser) { %>
        <!-- Interactive Profile Dropdown -->
        <div class="dropdown text-center">
          <div role="button" class="d-flex flex-column align-items-center dropdown-toggle user-avatar-wrap" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
            <div id="navAvatarBox" class="profile-avatar-circle shadow-sm">
              <% if(currUser.avatar && currUser.avatar.trim() !== '') { %>
