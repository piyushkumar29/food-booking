      <a href="/cart" class="btn btn-light border position-relative rounded-pill px-3 py-1 d-flex align-items-center gap-2 text-decoration-none" title="View Cart">
        <i class="fa-solid fa-cart-shopping text-danger fs-5"></i>
        <span class="d-none d-sm-inline fw-semibold" style="font-size: 0.88rem;">Cart</span>
        <span id="navCartCountBadge" class="badge rounded-pill bg-danger" style="font-size: 0.72rem;">0</span>
