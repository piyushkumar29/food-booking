<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top py-2 px-3">
  <div class="container-fluid d-flex align-items-center justify-content-between p-0">
    
    <!-- Left: Brand Logo & Navigation Links -->
    <div class="d-flex align-items-center flex-shrink-0">
      <a class="navbar-brand me-3 p-0 d-flex align-items-center" href="/listings">
        <img src="/mypic.png" alt="logo" style="height: 38px;" />
      </a>

      <div class="d-none d-lg-flex align-items-center gap-2">
        <a class="nav-pill-btn" href="/listings">
          <i class="fa-solid fa-utensils icon-item icon-red"></i> All food items
        </a>

        <% if (currUser && currUser.isOwner) { %>
          <a class="nav-pill-btn owner-highlight-btn" href="/listings/new">
            <i class="fa-solid fa-plus icon-item icon-red"></i> Add new items
          </a>
        <% } else { %>
          <a class="nav-pill-btn" href="/orders/track">
            <i class="fa-solid fa-motorcycle icon-item icon-green"></i> Track Order
          </a>
          <a class="nav-pill-btn" href="/offers">
            <i class="fa-solid fa-tags icon-item icon-gold"></i> Offers & Discounts
          </a>
        <% } %>
      </div>
    </div>

    <!-- Center: Search Bar with History Dropdown -->
    <div class="position-relative mx-auto" style="width: 100%; max-width: 440px;">
      <form class="d-flex align-items-center m-0" id="foodSearchForm" onsubmit="return false;">
        <div class="input-group w-100 position-relative">
          <input 
            class="form-control rounded-pill pe-5 py-2 shadow-none" 
            type="search" 
            id="foodSearchInput" 
            placeholder="Search delicious food..." 
            autocomplete="off"
            style="border: 1.5px solid #ddd; font-size: 0.9rem;"
          />
          <button class="btn position-absolute end-0 top-50 translate-middle-y me-2 border-0 bg-transparent text-secondary p-0" type="submit" id="searchSubmitBtn">
            <i class="fa-solid fa-magnifying-glass fs-6"></i>
          </button>
        </div>
      </form>

      <!-- History Dropdown Box -->
      <div id="searchHistoryBox" class="position-absolute bg-white border rounded-3 shadow-lg w-100 mt-1 d-none" style="z-index: 1060; max-height: 220px; overflow-y: auto; left: 0;">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom text-muted" style="font-size: 0.78rem; background-color: #f8f9fa;">
          <span class="fw-bold"><i class="fa-solid fa-clock-rotate-left me-1"></i> RECENT SEARCHES</span>
          <span role="button" id="clearHistoryBtn" class="text-danger fw-semibold" style="cursor: pointer;">Clear</span>
        </div>
        <ul id="historyList" class="list-unstyled m-0 p-0"></ul>
      </div>
    </div>

    <!-- Right: Auth Controls / Interactive Profile Avatar -->
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
      <% if(!currUser) { %>
        <a class="btn nav-auth-signup-btn rounded-pill px-3 py-1 fw-semibold btn-sm" href="/signup">Sign up</a>
        <a class="btn btn-dark rounded-pill px-3 py-1 fw-semibold btn-sm" href="/login">Log in</a>
      <% } %>

      <% if(currUser) { %>
        <!-- Interactive Profile Trigger -->
        <div class="dropdown text-center">
          <div role="button" class="d-flex flex-column align-items-center dropdown-toggle user-avatar-wrap" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
            
            <div id="navAvatarBox" class="profile-avatar-circle shadow-sm" data-userid="<%= currUser._id %>" data-hasavatar="<%= (currUser.avatar && currUser.avatar.trim() !== '') ? 'true' : 'false' %>">
              <% if(currUser.avatar && currUser.avatar.trim() !== '') { %>
                <img src="<%= currUser.avatar %>" alt="avatar" class="w-100 h-100 rounded-circle object-fit-cover" />
              <% } else { %>
                <span class="avatar-letter"><%= currUser.username.charAt(0).toUpperCase() %></span>
              <% } %>
            </div>

            <span class="profile-username-label mt-1">
              <%= currUser.username %>
              <% if(currUser.isOwner) { %>
                <i class="fa-solid fa-crown text-warning small ms-1" title="Owner"></i>
              <% } %>
            </span>
          </div>

          <!-- Profile Options Dropdown -->
          <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-3 rounded-4" style="min-width: 240px;">
            <li class="text-center pb-2 border-bottom mb-2">
              <div class="fw-bold text-dark user-card-name"><%= currUser.username %></div>
              <div class="text-muted small text-truncate"><%= currUser.email %></div>
            </li>

            <li>
              <label for="avatarFileInput" class="dropdown-item py-2 rounded-2 d-flex align-items-center gap-2" style="cursor: pointer;">
                <i class="fa-solid fa-camera text-danger"></i>
                <span>Change Photo</span>
              </label>
              <input type="file" id="avatarFileInput" accept="image/*" class="d-none" onchange="previewAndSaveAvatar(event)" />
            </li>

            <li><hr class="dropdown-divider"></li>
            
            <li>
              <a class="dropdown-item text-danger py-2 rounded-2 d-flex align-items-center gap-2" href="/logout">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>Log out</span>
              </a>
            </li>
          </ul>
        </div>
      <% } %>
    </div>

  </div>
</nav>

<style>
    /* Navigation Pills */
    .nav-pill-btn {
        display: inline-flex !important;
        align-items: center !important;
        padding: 0.45rem 1rem !important;
        border-radius: 50px !important;
        font-weight: 600 !important;
        font-size: 0.91rem !important;
        color: #2c2c2c !important;
        text-decoration: none !important;
        background-color: transparent !important;
        border: 1.5px solid transparent !important;
        transition: all 0.25s ease !important;
    }
    .icon-item {
        margin-right: 0.45rem;
        font-size: 1rem;
        transition: transform 0.25s ease;
    }
    .icon-red { color: #fe424d; }
    .icon-green { color: #198754; }
    .icon-gold { color: #ff9800; }

    /* Light Mode Pill Hover */
    .nav-pill-btn:hover {
        background-color: #ffffff !important;
        border-color: #ffdada !important;
        color: #fe424d !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(254, 66, 77, 0.18) !important;
    }
    .nav-pill-btn:hover .icon-item {
        transform: scale(1.22);
    }

    /* Owner Highlight */
    .owner-highlight-btn:hover {
        background-color: #fff4f4 !important;
        border-color: #fe424d !important;
    }

    /* Signup Button: Crisp Visible in Light & Dark Mode */
    .nav-auth-signup-btn {
        background-color: transparent !important;
        border: 1.5px solid #212529 !important;
        color: #212529 !important;
        transition: all 0.2s ease !important;
    }
    .nav-auth-signup-btn:hover {
        background-color: #212529 !important;
        color: #ffffff !important;
    }

    /* Profile Avatar Circle */
    .profile-avatar-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fe424d 0%, #ff7854 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1rem;
        border: 2px solid #ffffff;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .profile-avatar-circle:hover {
        transform: scale(1.08);
        box-shadow: 0 4px 12px rgba(254, 66, 77, 0.35);
    }
    .profile-username-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #2c2c2c;
        max-width: 85px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1;
    }

    /* ========================================================
       DARK MODE FIXES: HOVER EFFECTS & VISIBILITY
       ======================================================== */
    body.dark-mode nav, 
    body.dark-mode .navbar {
        background-color: #161618 !important;
        border-color: #26262a !important;
    }
    body.dark-mode .navbar-brand { color: #ffffff !important; }

    /* Dark Mode Links */
    body.dark-mode .nav-pill-btn {
        color: #e4e4e7 !important;
    }
    /* Fixed Dark Mode Hover: No white blinding wash */
    body.dark-mode .nav-pill-btn:hover {
        background-color: #232328 !important;
        border-color: #3f3f46 !important;
        color: #fe424d !important;
        box-shadow: 0 5px 16px rgba(254, 66, 77, 0.22) !important;
    }

    /* Fixed Dark Mode Signup Button (Crisp White Border & Text) */
    body.dark-mode .nav-auth-signup-btn {
        border-color: #ffffff !important;
        color: #ffffff !important;
    }
    body.dark-mode .nav-auth-signup-btn:hover {
        background-color: #ffffff !important;
