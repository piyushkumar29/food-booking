        class="form-control rounded-pill pe-5 py-2 shadow-none" 
        type="search" 
        id="mobileFoodSearchInput" 
        placeholder="Search food, dishes or restaurants..." 
        autocomplete="off"
        style="border: 1.5px solid #cbd5e1; font-size: 0.85rem;"
      />
      <button class="btn position-absolute end-0 top-50 translate-middle-y me-2 border-0 bg-transparent text-secondary p-0" type="button" onclick="if(typeof executeSearchNow === 'function') executeSearchNow();">
        <i class="fa-solid fa-magnifying-glass fs-6"></i>
      </button>
    </div>
  </div>
</nav>

