<!-- Modal: Same Restaurant Search & Quick Picker -->
<div class="modal fade" id="sameRestaurantModal" tabindex="-1" aria-labelledby="sameRestaurantModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-bottom pb-2">
        <div>
          <h5 class="modal-title fw-bold" id="sameRestaurantModalLabel"><i class="fa-solid fa-store text-danger me-2"></i>Filter by Restaurant</h5>
          <p class="text-muted small mb-0">Search or pick any restaurant to see all dishes from it</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="input-group mb-3">
          <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
          <input type="text" id="manualRestSearchInput" class="form-control border-start-0 shadow-none" placeholder="Type restaurant name e.g. Domino's, Aminia..." oninput="filterRestListInModal()">
        </div>

        <h6 class="small fw-bold text-muted mb-2">ALL RESTAURANTS IN DATABASE:</h6>
        <div id="restaurantChipsContainer" class="d-flex flex-wrap gap-2"></div>
      </div>
    </div>
  </div>
</div>

<form id="editNameForm" action="/user/update-name" method="POST" class="d-none">
  <input type="hidden" name="newName" id="newNameInput" />
</form>
<form id="editAvatarForm" action="/user/update-avatar" method="POST" class="d-none">
  <input type="hidden" name="avatarData" id="avatarDataInput" />
</form>

<script>
function promptEditName(currentName) {
    const updated = prompt("Enter your new profile name:", currentName);
    if (updated !== null && updated.trim() !== "" && updated.trim() !== currentName) {
        document.getElementById("newNameInput").value = updated.trim();
        document.getElementById("editNameForm").submit();
    }
}

function uploadPermanentAvatar(event) {
    const file = event.target.files[0];
    if (file) {
        if (file.size > 5 * 1024 * 1024) return alert("Image must be under 5MB!");
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById("avatarDataInput").value = e.target.result;
            document.getElementById("editAvatarForm").submit();
        };
        reader.readAsDataURL(file);
    }
}

function refreshNavCartBadge() {
    const cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
    const totalCount = cart.reduce((acc, item) => acc + (item.quantity || 1), 0);
    const badge = document.getElementById("navCartCountBadge");
    const mobileBadge = document.getElementById("mobileCartBadge");
    if (badge) badge.innerText = totalCount;
    if (mobileBadge) mobileBadge.innerText = totalCount;
}
document.addEventListener("DOMContentLoaded", refreshNavCartBadge);
window.addEventListener("storage", refreshNavCartBadge);

function filterRestListInModal() {
    const q = (document.getElementById("manualRestSearchInput").value || "").toLowerCase().trim();
    const btns = document.querySelectorAll(".rest-chip-btn");
    btns.forEach(b => {
        if (b.innerText.toLowerCase().includes(q)) {
            b.style.display = "inline-block";
        } else {
            b.style.display = "none";
        }
    });
}

function selectRestaurantFilter(restName) {
    const modalEl = document.getElementById('sameRestaurantModal');
    const modal = bootstrap.Modal.getInstance(modalEl);
    if (modal) modal.hide();

    if (!window.location.pathname.includes("/listings") || window.location.pathname.length > 10) {
        window.location.href = `/listings?restaurant=${encodeURIComponent(restName)}`;
        return;
    }

    if (typeof filterSpecificRestaurant === "function") {
        filterSpecificRestaurant(restName);
    }
}

document.addEventListener("click", (e) => {
    const sBox = document.getElementById("searchHistoryBox");
    const sInput = document.getElementById("foodSearchInput");
    if (sBox && !sBox.contains(e.target) && e.target !== sInput) {
        sBox.classList.add("d-none");
    }
});
</script>