    }
    body.dark-mode .dropdown-item:hover {
        background-color: #2a2a30 !important;
    }
</style>

<script>
function previewAndSaveAvatar(event) {
    const file = event.target.files[0];
    const avatarBox = document.getElementById("navAvatarBox");
    if (file && avatarBox) {
        const userId = avatarBox.getAttribute("data-userid") || "";
        const reader = new FileReader();
        reader.onload = function(e) {
            avatarBox.innerHTML = '<img src="' + e.target.result + '" alt="avatar" class="w-100 h-100 rounded-circle object-fit-cover" />';
            if (userId) {
                localStorage.setItem("user_avatar_" + userId, e.target.result);
            }
        };
        reader.readAsDataURL(file);
    }
}

document.addEventListener("DOMContentLoaded", function() {
    const avatarBox = document.getElementById("navAvatarBox");
    if (avatarBox) {
        const userId = avatarBox.getAttribute("data-userid") || "";
        const hasAvatar = avatarBox.getAttribute("data-hasavatar") === "true";
        if (userId && !hasAvatar) {
            const savedPhoto = localStorage.getItem("user_avatar_" + userId);
            if (savedPhoto) {
                avatarBox.innerHTML = '<img src="' + savedPhoto + '" alt="avatar" class="w-100 h-100 rounded-circle object-fit-cover" />';
            }
        }
    }
});
</script>