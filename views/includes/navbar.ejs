    <!-- Right Actions -->
    <div class="d-flex align-items-center gap-3 flex-shrink-0">
      
      <a href="/cart" class="btn btn-light border position-relative rounded-pill px-3 py-1 d-flex align-items-center gap-2 text-decoration-none" title="View Cart">
        <i class="fa-solid fa-cart-shopping text-danger fs-5"></i>
        <span class="d-none d-sm-inline fw-semibold" style="font-size: 0.88rem;">Cart</span>
        <span id="navCartCountBadge" class="badge rounded-pill bg-danger" style="font-size: 0.72rem;">0</span>
      </a>

      <% if(!currUser) { %>
        <a class="btn nav-auth-signup-btn rounded-pill px-3 py-1 fw-bold btn-sm" href="/signup">Sign up</a>
        <a class="btn btn-dark rounded-pill px-3 py-1 fw-bold btn-sm" href="/login">Log in</a>
      <% } %>

      <% if(currUser) { %>
        <div class="dropdown text-center">
          <div role="button" class="d-flex flex-column align-items-center dropdown-toggle user-avatar-wrap" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
            <div id="navAvatarBox" class="profile-avatar-circle shadow-sm">
