</nav>

<!-- Hidden Form for Name Update -->
<form id="editNameForm" action="/user/update-name" method="POST" class="d-none">
  <input type="hidden" name="newName" id="newNameInput" />
</form>

<!-- Hidden Form for Avatar Update -->
<form id="editAvatarForm" action="/user/update-avatar" method="POST" class="d-none">
  <input type="hidden" name="avatarData" id="avatarDataInput" />
</form>

<style>
    .nav-pill-btn {
        display: inline-flex !important;
        align-items: center !important;
        padding: 0.45rem 1rem !important;
        border-radius: 50px !important;
        font-weight: 600 !important;
        font-size: 0.91rem !important;
        color: #1e293b !important;
        text-decoration: none !important;
        background-color: transparent !important;
        border: 1.5px solid transparent !important;
        transition: all 0.25s ease !important;
    }
    .nav-pill-btn:hover {
        background-color: #ffffff !important;
        border-color: #fecdd3 !important;
        color: #fe424d !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(254, 66, 77, 0.15) !important;
    }
    .profile-avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fe424d 0%, #ec4899 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.05rem;
        border: 2px solid #ffffff;
        overflow: hidden;
    }
    .profile-username-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #1e293b;
        max-width: 85px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1;
    }
    body.dark-mode .nav-pill-btn { color: #f1f5f9 !important; }
    body.dark-mode .nav-pill-btn:hover {
        background-color: #1e293b !important;
        border-color: #334155 !important;
        color: #f59e0b !important;
    }
    body.dark-mode .profile-username-label { color: #f8fafc !important; }
    body.dark-mode .dropdown-menu { background-color: #0f172a !important; border: 1px solid #334155 !important; }
    body.dark-mode .user-card-name { color: #ffffff !important; }
    body.dark-mode .dropdown-item { color: #e2e8f0 !important; }
    body.dark-mode .dropdown-item:hover { background-color: #1e293b !important; }
</style>

<script>
function promptEditName(currentName) {
    const updated = prompt("Enter your new profile name:", currentName);
    if (updated !== null && updated.trim() !== "" && updated.trim() !== currentName) {
        document.getElementById("newNameInput").value = updated.trim();
        document.getElementById("editNameForm").submit();
    }
}

function uploadPermanentAvatar(event) {
    const file = event.target.files[0];
    if (file) {
        if (file.size > 5 * 1024 * 1024) {
            alert("Image must be smaller than 5MB!");
            return;
        }
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById("avatarDataInput").value = e.target.result;
            document.getElementById("editAvatarForm").submit();
        };
        reader.readAsDataURL(file);
    }
}

// Live Cart Count Updater
function refreshNavCartBadge() {
    const cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
    const totalCount = cart.reduce((acc, item) => acc + (item.quantity || 1), 0);
    const badge = document.getElementById("navCartCountBadge");
    if (badge) badge.innerText = totalCount;
}
document.addEventListener("DOMContentLoaded", refreshNavCartBadge);
window.addEventListener("storage", refreshNavCartBadge);
</script>