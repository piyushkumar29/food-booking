<script>
function promptEditName(currentName) {
    const updated = prompt("Enter your new profile name:", currentName);
    if (updated !== null && updated.trim() !== "" && updated.trim() !== currentName) {
        document.getElementById("newNameInput").value = updated.trim();
        document.getElementById("editNameForm").submit();
    }
}

function uploadPermanentAvatar(event) {
    const file = event.target.files[0];
    if (file) {
        if (file.size > 5 * 1024 * 1024) return alert("Image must be under 5MB!");
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById("avatarDataInput").value = e.target.result;
            document.getElementById("editAvatarForm").submit();
        };
        reader.readAsDataURL(file);
    }
}

function refreshNavCartBadge() {
    const cart = JSON.parse(localStorage.getItem("hungrymate_cart") || "[]");
    const totalCount = cart.reduce((acc, item) => acc + (item.quantity || 1), 0);
    const badge = document.getElementById("navCartCountBadge");
    if (badge) badge.innerText = totalCount;
}
document.addEventListener("DOMContentLoaded", refreshNavCartBadge);
window.addEventListener("storage", refreshNavCartBadge);

// Smart Food Names Autocomplete (Food Dishes Only)
const popularFoodItems = [
    "Chicken Biryani", "Mutton Dum Biryani", "Paneer Tikka Biryani", "Overloaded Farmhouse Pizza", 
    "Peri Peri Chicken Pizza", "Cheese Garlic Bread", "Crispy Veg Maharaja Burger", "BBQ Chicken Burger", 
    "Kolkata Chicken Roll", "Paneer Kathi Roll", "Steamed Chicken Momos", "Fried Veg Momos", 
    "Peri Peri French Fries", "Paneer Butter Masala", "Dal Makhani", "Kadhai Paneer", "Butter Garlic Naan", 
    "Butter Chicken", "Mutton Kosha", "Tandoori Chicken", "Chicken Tikka Kebab", "Maharaja Non-Veg Thali", 
    "Pure Veg Deluxe Thali", "Crispy Masala Dosa", "Hot Gulab Jamun", "Belgian Chocolate Sundae", 
    "Dutch Truffle Cake", "Red Velvet Pastry", "Belgian Chocolate Shake", "Cold Coffee"
];

const sInput = document.getElementById("foodSearchInput");
const sBox = document.getElementById("searchHistoryBox");
const sList = document.getElementById("historyList");
const sHeader = document.getElementById("searchDropdownHeader");
const sClear = document.getElementById("clearHistoryBtn");

function renderSearchDropdown(items, isHint) {
    sList.innerHTML = "";
    if (items.length === 0) {
        sBox.classList.add("d-none");
        return;
    }
    sBox.classList.remove("d-none");
    sHeader.innerHTML = isHint ? '<i class="fa-solid fa-utensils text-danger me-1"></i> FOOD DISHES' : '<i class="fa-solid fa-clock-rotate-left me-1"></i> RECENT SEARCHES';
    sClear.style.display = isHint ? "none" : "inline";

    items.forEach(txt => {
        const li = document.createElement("li");
        li.innerHTML = `<span><i class="fa-solid ${isHint ? 'fa-bowl-food text-warning' : 'fa-clock text-muted'} me-2"></i>${txt}</span>`;
        li.onclick = () => {
            sInput.value = txt;
            sBox.classList.add("d-none");
            saveSearchHistory(txt);
            if (typeof applyAllFilters === "function") applyAllFilters();
        };
        sList.appendChild(li);
    });
}

function saveSearchHistory(term) {
    if (!term) return;
    let hist = JSON.parse(localStorage.getItem("hungrymate_search_hist") || "[]");
    hist = hist.filter(h => h.toLowerCase() !== term.toLowerCase());
    hist.unshift(term);
    if (hist.length > 5) hist.pop();
    localStorage.setItem("hungrymate_search_hist", JSON.stringify(hist));
}

if (sInput) {
    sInput.addEventListener("focus", () => {
        if (!sInput.value.trim()) {
            const hist = JSON.parse(localStorage.getItem("hungrymate_search_hist") || "[]");
            renderSearchDropdown(hist, false);
        }
    });

    sInput.addEventListener("input", () => {
        const q = sInput.value.trim().toLowerCase();
        if (!q) {
            const hist = JSON.parse(localStorage.getItem("hungrymate_search_hist") || "[]");
            renderSearchDropdown(hist, false);
        } else {
            const matches = popularFoodItems.filter(item => item.toLowerCase().includes(q));
            renderSearchDropdown(matches, true);
        }
    });
}

if (sClear) {
    sClear.addEventListener("click", () => {
        localStorage.removeItem("hungrymate_search_hist");
        sBox.classList.add("d-none");
    });
}

document.addEventListener("click", (e) => {
    if (!sBox.contains(e.target) && e.target !== sInput) {
        sBox.classList.add("d-none");
    }
});
</script>